{
  "name": "openwebui",
  "access": [
    {
      "id": "web",
      "service": "app",
      "port": 8080,
      "public": true,
      "rootUrl": [
        "WEBUI_URL"
      ],
      "endpoints": [
        {
          "roles": [
            "web"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "trademark": "Open WebUI",
  "release": true,
  "upstream": {
    "image": "ghcr.io/open-webui/open-webui",
    "releases": "https://github.com/open-webui/open-webui/releases",
    "docs": [
      "https://docs.openwebui.com/",
      "https://docs.openwebui.com/getting-started/quick-start/",
      "https://docs.openwebui.com/reference/env-configuration/"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "0.11",
        "main"
      ]
    }
  ],
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "10"
  },
  "database": [
    {
      "id": "chroma",
      "providers": [
        {
          "type": "internal",
          "service": "chroma",
          "driver": "chroma"
        }
      ],
      "users": []
    }
  ]
}
