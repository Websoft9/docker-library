{
  "name": "codeserver",
  "access": [
    {
      "id": "web",
      "service": "code-server",
      "port": 8443,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "web"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "trademark": "CodeServer",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/linuxserver/code-server"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "4.141.0",
        "latest"
      ]
    }
  ],
  "credentials": {
    "password": {
      "source": "container-env",
      "name": "W9_POWER_PASSWORD"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "2"
  }
}
