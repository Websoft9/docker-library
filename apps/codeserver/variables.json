{
  "name": "codeserver",
  "trademark": "CodeServer",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/linuxserver/code-server"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "4.106.3",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8443,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "2"
  }
}
