W9_VERSION='4.141.0'
W9_DIST='community'
W9_REPO=linuxserver/code-server
W9_POWER_PASSWORD='8bgj9nf7!fQDkGiL'

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####
W9_ID='codeserver'
W9_HTTP_PORT=8443
W9_HTTP_PORT_SET='9001'
W9_URL='appname.example.com'
W9_NETWORK=websoft9
#### --------------------------------------------------------------------------------------- ####

# ============================================================
# CodeServer image environment variables
# Docs: https://docs.linuxserver.io/images/docker-code-server/
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
PUID=1000
PGID=1000
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
TZ=Europe/London
PASSWORD=${W9_POWER_PASSWORD}
HASHED_PASSWORD=
SUDO_PASSWORD=${W9_POWER_PASSWORD}
SUDO_PASSWORD_HASH=

# Not used by default; enable only when needed:
# 此代理是全局域名，用于将codeserver上的多个应用自动提供子域名访问
# PROXY_DOMAIN=${W9_URL}
DEFAULT_WORKSPACE=/config/workspace
