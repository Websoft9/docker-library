{
  "name": "milvus",
  "trademark": "Milvus",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/milvusdb/milvus",
    "releases": "https://github.com/milvus-io/milvus/releases",
    "compose": {
      "compose": "https://raw.githubusercontent.com/milvus-io/milvus/v3.0.3/deployments/docker/standalone/docker-compose.yml"
    },
    "docs": [
      "https://milvus.io/docs/install_standalone-docker-compose.md",
      "https://milvus.io/docs/milvus-webui.md"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "v3.0.3",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 9091,
      "path": "/webui"
    }
  },
  "requirements": {
    "cpu": "8",
    "memory": "32",
    "disk": "4"
  }
}
