{
  "name": "pocketbase",
  "access": [
    {
      "id": "admin",
      "service": "pocketbase",
      "port": 8090,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "admin"
          ],
          "scheme": "http",
          "path": "/_/"
        },
        {
          "roles": [
            "api"
          ],
          "scheme": "http",
          "path": "/api/"
        }
      ]
    }
  ],
  "trademark": "PocketBase",
  "release": true,
  "upstream": {
    "image": "https://github.com/pocketbase/pocketbase/releases",
    "releases": "https://github.com/pocketbase/pocketbase/releases",
    "docs": [
      "https://pocketbase.io/docs/",
      "https://github.com/pocketbase/pocketbase",
      "https://github.com/pocketbase/pocketbase/blob/master/CHANGELOG.md"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "v0.40.5",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "1"
  },
  "credentials": {
    "username": {
      "source": "inline",
      "value": "admin@example.com"
    },
    "password": {
      "source": "container-env",
      "name": "W9_LOGIN_PASSWORD",
      "format": "text"
    }
  },
  "env": {
    "first_startup_only": [
      "W9_LOGIN_USER",
      "W9_LOGIN_PASSWORD"
    ]
  },
  "help": {
    "init": "The first startup creates the configured superuser inside the empty `pb_data` directory. PocketBase is pre-1.0, so upgrades may require manual migration review.",
    "login": "Sign in with that superuser account."
  }
}