{
  "name": "pocketbase",
  "trademark": "PocketBase",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/spectado/pocketbase"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "v0.29.1",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8090,
      "path": "/"
    },
    "admin": {
      "port": 8090,
      "path": "/_/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "1"
  },
  "credentials": {
    "username": {
      "source": "inline",
      "value": "admin@example.com"
    },
    "password": {
      "source": "container-env",
      "name": "W9_LOGIN_PASSWORD",
      "format": "text"
    }
  }
}
