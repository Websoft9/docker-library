{
  "name": "pocketbase",
  "trademark": "PocketBase",
  "release": true,
  "upstream": {
    "image": "https://github.com/pocketbase/pocketbase/releases",
    "releases": "https://github.com/pocketbase/pocketbase/releases",
    "docs": [
      "https://pocketbase.io/docs/",
      "https://github.com/pocketbase/pocketbase",
      "https://github.com/pocketbase/pocketbase/blob/master/CHANGELOG.md"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "v0.40.5",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8090,
      "path": "/"
    },
    "admin": {
      "port": 8090,
      "path": "/_/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "1"
  },
  "credentials": {
    "username": {
      "source": "inline",
      "value": "admin@example.com"
    },
    "password": {
      "source": "container-env",
      "name": "W9_LOGIN_PASSWORD",
      "format": "text"
    }
  },
  "env": {
    "first_startup_only": [
      "W9_LOGIN_USER",
      "W9_LOGIN_PASSWORD"
    ]
  },
  "help": {
    "login": "PocketBase is pre-1.0 and may require manual migration review on upgrades. The first startup creates the configured superuser inside the empty pb_data directory."
  }
}
