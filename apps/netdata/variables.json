{
  "name": "netdata",
  "trademark": "Netdata",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "v2.8",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 19999,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "1"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/netdata/netdata"
  }
}
