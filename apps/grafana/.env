# latest is not stable, sometime is 9.x,sometime is 8.x
W9_REPO=grafana/grafana
W9_DIST='community'
W9_VERSION='13.2'
W9_POWER_PASSWORD='5PidNEsE5!D314t0'

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####
W9_ID='grafana'
W9_HTTP_PORT_SET='9001'
W9_HTTP_PORT=3000
W9_LOGIN_USER=admin
W9_LOGIN_PASSWORD=${W9_POWER_PASSWORD}
W9_URL='appname.example.com'
W9_NETWORK=websoft9
#### --------------------------------------------------------------------------------------- ####

# ============================================================
# Grafana image environment variables
# Docs: https://grafana.com/docs/grafana/latest/setup-grafana/configure-grafana/#variable-expansion
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:

# You can use any environment from grafana.ini. format: GF_<SectionName>_<KeyName>
# Grafana 13.x deprecated GF_INSTALL_PLUGINS (silently ignored unless GF_INSTALL_PLUGINS_FORCE=true).
# Use GF_PLUGINS_PREINSTALL instead. Grafana 13 refuses Angular plugins, so keep only supported plugins.
GF_PLUGINS_PREINSTALL=grafana-clock-panel
GF_LOG_MODE=console file
GF_SECURITY_ADMIN_USER=${W9_LOGIN_USER}
GF_SECURITY_ADMIN_PASSWORD=${W9_POWER_PASSWORD}

# for html display at Text Panel
GF_PANELS_DISABLE_SANITIZE_HTML=true

# Not used by default; enable only when needed:
# GF_DATABASE_URL=
# GF_SERVER_ROOT_URL=
