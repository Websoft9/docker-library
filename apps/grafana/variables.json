{
  "name": "grafana",
  "access": [
    {
      "id": "web",
      "service": "grafana",
      "port": 3000,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "dashboard"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "trademark": "Grafana",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/grafana/grafana"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "13.3",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "2"
  }
}
