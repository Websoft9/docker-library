{
  "name": "grafana",
  "trademark": "Grafana",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/grafana/grafana"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "12.1.1",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 3000,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "2"
  }
}
