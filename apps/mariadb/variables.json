{
  "name": "mariadb",
  "access": [
    {
      "id": "db",
      "service": "mariadb",
      "port": 3306,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "db"
          ],
          "scheme": "mysql"
        }
      ]
    }
  ],
  "trademark": "MariaDB",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "12.3",
        "11.4",
        "11.8",
        "10.11",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "8"
  },
  "upstream": {
    "image": "https://hub.docker.com/_/mariadb"
  }
}
