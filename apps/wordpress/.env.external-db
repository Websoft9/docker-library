# version tags refer to: https://hub.docker.com/_/wordpress
W9_REPO=wordpress
W9_DIST='community'
W9_VERSION='6.9'
# Environments for user settings when creating an application
W9_HTTP_PORT_SET='9001'
W9_DB_HOST_SET=
W9_DB_PORT_SET=3306
W9_DB_NAME_SET=
W9_DB_USER_SET=
W9_DB_PASSWORD_SET=

#### -- Do not edit below when recreating an existing application -- ####
W9_ID='wordpress'
W9_HTTP_PORT=80

# WordPress writes W9_URL to its database.
# Leave empty to manage it through WordPress or the wp_options table.
W9_URL=''
W9_URL_REPLACE=true
W9_ADMIN_PATH="/wp-admin"

W9_DATABASE_MODE=external
W9_DB_EXPOSE="mysql"
W9_NETWORK=websoft9
#### -------------------------------------------------------------------- ####

# Non-empty value enables WP_DEBUG in wp-config.php.
# WORDPRESS_DEBUG=1
WORDPRESS_CONFIG_EXTRA=" define('WP_ALLOW_MULTISITE', true ); \n"

# User-provided credentials for an existing database.
WORDPRESS_DB_HOST=$W9_DB_HOST_SET:$W9_DB_PORT_SET
WORDPRESS_DB_NAME=$W9_DB_NAME_SET
WORDPRESS_DB_USER=$W9_DB_USER_SET
WORDPRESS_DB_PASSWORD=$W9_DB_PASSWORD_SET

WORDPRESS_ROOT_URL="http://$W9_URL"

# Below are wp-cli environments.
WP_CLI_ALLOW_ROOT=1
PAGER=more