W9_REPO=budibase/apps
W9_DIST=community
W9_VERSION=latest
W9_POWER_PASSWORD=8d2sBiOLPhXuHef!

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=budibase
W9_HTTP_PORT=10000
W9_HTTP_PORT_SET=9009
W9_DB_VERSION=16
W9_DB_EXPOSE=postgresql
W9_URL=budibase.example.com
W9_NETWORK=websoft9

#### --------------------------------------------------------------------------------------- ####

# Use the main port in the builder for your self hosting URL, e.g. localhost:10000
MAIN_PORT=${W9_HTTP_PORT_SET}

# ============================================================
# Budibase image environment variables
# Docs: https://docs.budibase.com/docs/docker-compose
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:

# This section contains all secrets pertaining to the system
# These should be updated
API_ENCRYPTION_KEY=${W9_POWER_PASSWORD}6UF6GPsa3iu2tbP
JWT_SECRET=${W9_POWER_PASSWORD}6UF6GPsa3iu2tbP
MINIO_ACCESS_KEY=${W9_POWER_PASSWORD}
MINIO_SECRET_KEY=${W9_POWER_PASSWORD}
COUCH_DB_PASSWORD=${W9_POWER_PASSWORD}
COUCH_DB_USER=${W9_POWER_PASSWORD}
REDIS_PASSWORD=${W9_POWER_PASSWORD}
REDIS_USERNAME=
INTERNAL_API_KEY=${W9_POWER_PASSWORD}
LITELLM_MASTER_KEY=${W9_POWER_PASSWORD}
LITELLM_SALT_KEY=${W9_POWER_PASSWORD}salt
LITELLM_DB_PASSWORD=${W9_POWER_PASSWORD}

# This section contains variables that do not need to be altered under normal circumstances
APP_PORT=4002
WORKER_PORT=4003
MINIO_PORT=9000
COUCH_DB_PORT=5984
REDIS_PORT=6379
LITELLM_PORT=4000
LITELLM_DB_NAME=litellm
LITELLM_DB_USER=llmproxy
BUDIBASE_ENVIRONMENT=PRODUCTION
SQL_MAX_ROWS=
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=512

# An admin user can be automatically created initially if these are set
BB_ADMIN_USER_EMAIL=
BB_ADMIN_USER_PASSWORD=

# A path that is watched for plugin bundles. Any bundles found are imported automatically/
PLUGINS_DIR=
OFFLINE_MODE=

# Not used by default; enable only when needed:
# PASSWORD_REGEX=
# PASSWORD_REGEX_ERROR_MESSAGE=
# ROLLING_LOG_MAX_SIZE=
