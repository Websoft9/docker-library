{
  "name": "budibase",
  "trademark": "Budibase",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "3.13.28",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 10000,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "8",
    "disk": "1"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/budibase/proxy"
  }
}
