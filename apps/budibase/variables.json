{
  "name": "budibase",
  "trademark": "Budibase",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/budibase/apps",
    "releases": "https://github.com/Budibase/budibase/releases",
    "compose": {
      "compose": "https://raw.githubusercontent.com/Budibase/budibase/master/hosting/docker-compose.yaml",
      "env": "https://raw.githubusercontent.com/Budibase/budibase/master/hosting/.env"
    },
    "docs": [
      "https://docs.budibase.com/docs/docker-compose"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 10000,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "8",
    "disk": "1"
  },
  "env": {
    "first_startup_only": [
      "BB_ADMIN_USER_EMAIL",
      "BB_ADMIN_USER_PASSWORD"
    ]
  }
}
