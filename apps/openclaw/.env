W9_REPO=ghcr.io/openclaw/openclaw
W9_DIST=community
W9_VERSION=2026.9.6

# Optional password seed: enable only when the package actually controls a DB or built-in login.
# See docs/w9-env-spec.md for when W9_POWER_PASSWORD is appropriate.
# The Gateway token is wired from W9_LOGIN_PASSWORD and surfaced in the Access tab.
W9_POWER_PASSWORD='1PrMxExC45LsCT'

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=openclaw
W9_HTTP_PORT=18789
W9_HTTP_PORT_SET=9001
W9_BRIDGE_PORT_SET=18790

# Built-in login and URL helpers: keep these in the protected block because the appstore parser
# reads them from the app package metadata surface.
W9_LOGIN_USER=token
W9_LOGIN_PASSWORD=${W9_POWER_PASSWORD}
W9_URL=openclaw.example.com
W9_URL_REPLACE=true

W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# OpenClaw image environment variables
# Docs: https://docs.openclaw.ai/install/docker
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
OPENCLAW_GATEWAY_TOKEN=${W9_LOGIN_PASSWORD}
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=true
# Leave both vars empty for direct IP/LAN access.
# For domain access, set OPENCLAW_PUBLIC_SCHEME and let the package derive
# <scheme>://${W9_URL}, or set OPENCLAW_PUBLIC_ORIGIN to override it exactly.
OPENCLAW_PUBLIC_SCHEME=
OPENCLAW_PUBLIC_ORIGIN=

# Not used by default; enable only when needed:
# OPENCLAW_GATEWAY_PORT=18789
# OPENCLAW_TZ=UTC
# OPENCLAW_SANDBOX=1
# OPENCLAW_SKIP_ONBOARDING=1
# OPENCLAW_DISABLE_BONJOUR=1
