{
  "name": "openclaw",
  "access": [
    {
      "id": "web",
      "service": "openclaw-gateway",
      "port": 18789,
      "public": true,
      "rootUrl": [
        "OPENCLAW_PUBLIC_ORIGIN"
      ],
      "endpoints": [
        {
          "roles": [
            "web",
            "gateway"
          ],
          "scheme": "http",
          "path": "/"
        },
        {
          "roles": [
            "api"
          ],
          "scheme": "ws",
          "path": "/"
        }
      ]
    },
    {
      "id": "bridge",
      "service": "openclaw-gateway",
      "port": 18790,
      "public": true,
      "endpoints": []
    }
  ],
  "trademark": "OpenClaw",
  "release": true,
  "upstream": {
    "image": "ghcr.io/openclaw/openclaw",
    "releases": "https://github.com/openclaw/openclaw/releases",
    "docs": [
      "https://docs.openclaw.ai/install/docker"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "2026.9.6"
      ]
    }
  ],
  "requirements": {
    "cpu": "2",
    "memory": "2",
    "disk": "10"
  },
  "credentials": {},
  "env": {
    "first_startup_only": []
  },
  "help": {
    "db": "No bundled database. The Gateway token is seeded from W9_LOGIN_PASSWORD. The package reads OPENCLAW_PUBLIC_ORIGIN and OPENCLAW_TRUSTED_PROXIES for reverse-proxy access on each recreate."
  }
}
