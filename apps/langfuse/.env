W9_REPO=langfuse/langfuse
W9_DIST=community
W9_VERSION=4.59

W9_POWER_PASSWORD='BNp28GCPsV2NIFcLE5i9'

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=langfuse

W9_HTTP_PORT=3000
W9_HTTP_PORT_SET=9004

W9_DB_EXPOSE=postgresql,clickhouse
W9_DB_VERSION=17

W9_URL=langfuse.example.com
W9_URL_REPLACE=true

W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# Langfuse image environment variables
# Docs: https://langfuse.com/self-hosting/deployment/docker-compose
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
NEXTAUTH_URL=http://${W9_URL}
NEXTAUTH_SECRET=7dba9afc7f6a09f92aab17fe25af391d5bfaa34958a48e14782f6a49271b38d2
SALT=6afa4c6bcad5bc19ab27f8b3235c7d83b7c7fb0e5f1d6ca7
ENCRYPTION_KEY=4afda83af5717c10a89c9fcf4b6d80238d0b21da7421fe4588f9e0e6b976dccb

POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=${W9_POWER_PASSWORD}
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=${W9_POWER_PASSWORD}
CLICKHOUSE_DB=default
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_CLUSTER_ENABLED=false
CLICKHOUSE_CLUSTER_NAME=default

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_AUTH=${W9_POWER_PASSWORD}

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=${W9_POWER_PASSWORD}
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=${W9_POWER_PASSWORD}
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=auto
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=${W9_POWER_PASSWORD}
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/

# Not used by default; enable only when needed:
# TELEMETRY_ENABLED=true
# LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false
# EMAIL_FROM_ADDRESS=
# SMTP_CONNECTION_URL=
# LANGFUSE_S3_BATCH_EXPORT_ENABLED=false
