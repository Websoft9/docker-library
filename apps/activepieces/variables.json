{
  "name": "activepieces",
  "trademark": "Activepieces",
  "release": true,
  "upstream": {
    "image": "ghcr.io/activepieces/activepieces",
    "releases": "https://github.com/activepieces/activepieces",
    "compose": {
      "compose": "https://raw.githubusercontent.com/activepieces/activepieces/main/docker-compose.yml",
      "env": "https://raw.githubusercontent.com/activepieces/activepieces/main/.env.example"
    },
    "docs": [
      "https://github.com/activepieces/activepieces",
      "https://www.activepieces.com/docs/install/options/docker-compose",
      "https://www.activepieces.com/docs/install/reference/breaking-changes"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "0.92.3",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 80,
      "path": "/"
    }
  },
  "database": [
    {
      "id": "rds",
      "providers": [
        {
          "type": "internal",
          "service": "postgres",
          "driver": "postgresql"
        },
        {
          "type": "external",
          "drivers": [
            "postgresql"
          ]
        }
      ],
      "datasource": {
        "AP_POSTGRES_HOST": "${host}",
        "AP_POSTGRES_PORT": "${port}",
        "AP_POSTGRES_DATABASE": "${name}",
        "AP_POSTGRES_USERNAME": "${users[*].user}",
        "AP_POSTGRES_PASSWORD": "${users[*].password}"
      }
    },
    {
      "id": "redis",
      "providers": [
        {
          "type": "internal",
          "service": "redis",
          "driver": "redis"
        }
      ],
      "users": [],
      "datasource": {
        "AP_REDIS_HOST": "${host}",
        "AP_REDIS_PORT": "${port}"
      }
    }
  ],
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "8"
  }
}