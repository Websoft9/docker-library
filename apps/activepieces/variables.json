{
  "name": "activepieces",
  "trademark": "Activepieces",
  "release": true,
  "upstream": {
    "image": "ghcr.io/activepieces/activepieces",
    "releases": "https://github.com/activepieces/activepieces",
    "compose": {
      "compose": "https://raw.githubusercontent.com/activepieces/activepieces/main/docker-compose.yml",
      "env": "https://raw.githubusercontent.com/activepieces/activepieces/main/.env.example"
    },
    "docs": [
      "https://github.com/activepieces/activepieces",
      "https://www.activepieces.com/docs/install/options/docker-compose",
      "https://www.activepieces.com/docs/install/reference/breaking-changes"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "0.88.4-hotfix.1",
        "latest"
      ]
    }
  ],
  "database": {
    "type": "postgresql",
    "supported_modes": [
      "bundled",
      "external"
    ],
    "default_mode": "bundled",
    "bundled": {
      "service": "postgres",
      "internal_host": "$W9_ID-postgresql",
      "database_env": "AP_POSTGRES_DATABASE",
      "username_env": "AP_POSTGRES_USERNAME",
      "password_env": "AP_POSTGRES_PASSWORD"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "8"
  }
}
