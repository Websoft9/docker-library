W9_REPO=elestio/moodle
W9_DIST=community
W9_VERSION=v5.2.2

W9_POWER_PASSWORD='mCjG5CnUKA!GsOXK'

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=moodle
W9_HTTP_PORT=80
W9_HTTP_PORT_SET=9001

W9_DB_EXPOSE=mariadb
W9_DB_VERSION=11.4

W9_LOGIN_USER=admin
W9_LOGIN_PASSWORD=${W9_POWER_PASSWORD}

W9_URL=example.youdomain.com
W9_URL_REPLACE=true

W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# Moodle image environment variables
# Docs: https://hub.docker.com/r/elestio/moodle
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# The elestio image auto-installs Moodle on first start from these vars.
# ============================================================

# Used by docker-compose.yml:
MOODLE_HOST=http://${W9_URL}
MOODLE_SITE_NAME=Moodle Learning Platform
MOODLE_USERNAME=${W9_LOGIN_USER}
MOODLE_PASSWORD=${W9_LOGIN_PASSWORD}
MOODLE_EMAIL=admin@example.com
MOODLE_DATA_DIR=/var/moodledata
MOODLE_DATABASE_TYPE=mariadb
MOODLE_DATABASE_HOST=${W9_ID}-mariadb
MOODLE_DATABASE_PORT_NUMBER=3306
MOODLE_DATABASE_NAME=moodle
MOODLE_DATABASE_USER=moodle
MOODLE_DATABASE_PASSWORD=${W9_POWER_PASSWORD}

MYSQL_ROOT_PASSWORD=${W9_POWER_PASSWORD}
MYSQL_DATABASE=moodle
MYSQL_USER=moodle
MYSQL_PASSWORD=${W9_POWER_PASSWORD}

# PHP overrides. The image writes every "PHP_INI-<name>" variable into
# /usr/local/etc/php/conf.d/20-local.ini. Prefer editing src/php.ini for a
# readable set of values; use these for one-off overrides.
# PHP_INI-memory_limit=1024M
# PHP_INI-max_execution_time=600
# PHP_INI-upload_max_filesize=512M
