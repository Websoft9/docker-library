{
  "name": "moodle",
  "trademark": "Moodle",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/elestio/moodle",
    "releases": "https://github.com/moodle/moodle/releases",
    "docs": [
      "https://docs.moodle.org/en/Installation_quick_guide",
      "https://github.com/moodle/moodle"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "5.3",
        "latest"
      ]
    }
  ],
  "access": {
    "web": {
      "port": 80,
      "path": "/"
    },
    "admin": {
      "port": 80,
      "path": "/admin/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "5"
  },
  "credentials": {},
  "database": [
    {
      "id": "rds",
      "providers": [
        {
          "type": "internal",
          "service": "mariadb",
          "driver": "mariadb"
        },
        {
          "type": "external",
          "drivers": [
            "mariadb"
          ]
        }
      ],
      "name": [
        "${MYSQL_DATABASE}"
      ],
      "users": [
        {
          "user": "root",
          "password": "${MYSQL_ROOT_PASSWORD}",
          "usage": [
            "administration"
          ]
        },
        {
          "user": "${MYSQL_USER}",
          "password": "${MYSQL_PASSWORD}",
          "usage": [
            "application"
          ]
        }
      ],
      "datasource": {
        "MOODLE_DATABASE_HOST": "${host}",
        "MOODLE_DATABASE_PORT_NUMBER": "${port}",
        "MOODLE_DATABASE_NAME": "${name}",
        "MOODLE_DATABASE_USER": "${users[*].user}",
        "MOODLE_DATABASE_PASSWORD": "${users[*].password}"
      }
    }
  ],
  "env": {
    "first_startup_only": [
      "MOODLE_HOST",
      "MOODLE_SITE_NAME",
      "MOODLE_USERNAME",
      "MOODLE_PASSWORD",
      "MOODLE_EMAIL",
      "MOODLE_DATABASE_HOST",
      "MOODLE_DATABASE_NAME",
      "MOODLE_DATABASE_USER",
      "MOODLE_DATABASE_PASSWORD"
    ]
  },
  "help": {
    "db": "Bundled MariaDB stores Moodle data; database settings are used on first install."
  }
}