{
  "name": "supabase",
  "trademark": "Supabase",
  "release": true,
  "upstream": {
    "image": "https://github.com/supabase/supabase/releases/tag/self-hosted/v0.8.1",
    "releases": "https://github.com/supabase/supabase/tags",
    "compose": {
      "compose": "https://raw.githubusercontent.com/supabase/supabase/self-hosted/v0.8.1/docker/docker-compose.yml",
      "env": "https://raw.githubusercontent.com/supabase/supabase/self-hosted/v0.8.1/docker/.env.example"
    },
    "docs": [
      "https://supabase.com/docs/guides/self-hosting/docker",
      "https://github.com/supabase/supabase/blob/master/docker/CHANGELOG.md",
      "https://github.com/supabase/supabase/blob/master/docker/versions.md"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "0.8.1"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8000,
      "path": "/"
    },
    "api": {
      "port": 8000,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "40"
  },
  "database": [
    {
      "id": "postgres",
      "providers": [
        {
          "type": "internal",
          "service": "db",
          "driver": "postgresql"
        }
      ],
      "name": [
        "${POSTGRES_DB}",
        "_supabase"
      ],
      "users": [
        {
          "user": "postgres",
          "password": "${POSTGRES_PASSWORD}",
          "usage": [
            "application",
            "administration"
          ]
        },
        {
          "user": "supabase_admin",
          "password": "${POSTGRES_PASSWORD}",
          "usage": [
            "application"
          ]
        },
        {
          "user": "authenticator",
          "password": "${POSTGRES_PASSWORD}",
          "usage": [
            "application"
          ]
        },
        {
          "user": "pgbouncer",
          "password": "${POSTGRES_PASSWORD}",
          "usage": [
            "application"
          ]
        },
        {
          "user": "supabase_auth_admin",
          "password": "${POSTGRES_PASSWORD}",
          "usage": [
            "application"
          ]
        },
        {
          "user": "supabase_functions_admin",
          "password": "${POSTGRES_PASSWORD}"
        },
        {
          "user": "supabase_storage_admin",
          "password": "${POSTGRES_PASSWORD}",
          "usage": [
            "application"
          ]
        }
      ]
    }
  ],
  "env": {
    "first_startup_only": [
      "POSTGRES_PASSWORD"
    ]
  },
  "help": {
    "db": "This package declares its bundled Supabase Postgres databases and known roles for information only; external databases are not offered. Keep the existing roles, shared password, extensions, and initialization scripts together. Kong, logs/analytics, PgBouncer, and TLS proxy overrides are not enabled in the base package."
  }
}