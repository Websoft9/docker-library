{
  "name": "jfrog",
  "access": [
    {
      "id": "web",
      "service": "jfrog",
      "port": 8082,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "admin"
          ],
          "scheme": "http",
          "path": "/ui/"
        }
      ]
    }
  ],
  "trademark": "JFrog Artifactory",
  "release": true,
  "upstream": {
    "image": "https://releases-docker.jfrog.io/jfrog/artifactory-oss",
    "docs": [
      "https://www.jfrogchina.com/docs/docker-install-artifactory-1",
      "https://github.com/jfrog/artifactory-docker-examples"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "7.161.26"
      ]
    }
  ],
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "20"
  },
  "credentials": {
    "username": {
      "source": "inline",
      "value": "admin"
    },
    "password": {
      "source": "inline",
      "value": "password"
    }
  },
  "env": {
    "first_startup_only": []
  },
  "help": {
    "init": "First login uses the built-in admin / password. JFrog Artifactory forces a new administrator password on first sign-in, after which the initial password no longer works.",
    "login": "Sign in with the built-in admin account, then set a new administrator password when prompted."
  }
}