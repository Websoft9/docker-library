{
  "name": "bunkerweb",
  "trademark": "BunkerWeb",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "1.6.2",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "https",
    "web": {
      "port": 8443,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "10"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/bunkerity/bunkerweb"
  }
}
