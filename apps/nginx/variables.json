{
  "name": "nginx",
  "trademark": "NGINX",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "1.31",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 80,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "1"
  },
  "upstream": {
    "image": "https://hub.docker.com/_/nginx",
    "docs": [
      "https://hub.docker.com/_/nginx",
      "https://github.com/nginx/docker-nginx"
    ]
  }
}
