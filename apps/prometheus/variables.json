{
  "name": "prometheus",
  "access": [
    {
      "id": "web",
      "service": "prometheus",
      "port": 9090,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "dashboard"
          ],
          "scheme": "http",
          "path": "/"
        },
        {
          "roles": [
            "api"
          ],
          "scheme": "http",
          "path": "/api/v1/"
        },
        {
          "roles": [
            "metrics"
          ],
          "scheme": "http",
          "path": "/metrics"
        }
      ]
    }
  ],
  "trademark": "Prometheus",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/prom/prometheus",
    "releases": "https://github.com/prometheus/prometheus/releases",
    "docs": [
      "https://prometheus.io/docs/prometheus/latest/installation/",
      "https://github.com/prometheus/prometheus"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "v3.16.0",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "4"
  },
  "credentials": {},
  "env": {
    "first_startup_only": []
  },
  "help": {}
}
