{
  "name": "prometheus",
  "trademark": "Prometheus",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/prom/prometheus",
    "releases": "https://github.com/prometheus/prometheus/releases",
    "docs": [
      "https://prometheus.io/docs/prometheus/latest/installation/",
      "https://github.com/prometheus/prometheus"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "v3.14.0",
        "latest"
      ]
    }
  ],
  "access": {
    "web": {
      "port": 9090,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "4"
  },
  "credentials": {},
  "env": {
    "first_startup_only": []
  },
  "help": {}
}
