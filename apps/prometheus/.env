W9_REPO=prom/prometheus
W9_DIST=community
W9_VERSION=v3.14.0

# Optional password seed: enable only when the package actually controls a DB or built-in login.
# See docs/w9-env-spec.md for when W9_POWER_PASSWORD is appropriate.
W9_POWER_PASSWORD='VTIx8T9TlXTH!y6M'

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=prometheus
W9_HTTP_PORT=9090
W9_HTTP_PORT_SET=9001

W9_URL=appname.example.com

W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

