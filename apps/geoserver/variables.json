{
  "name": "geoserver",
  "access": [
    {
      "id": "admin",
      "service": "geoserver",
      "port": 8080,
      "public": true,
      "rootUrl": [
        "GEOSERVER_PUBLIC_URL"
      ],
      "endpoints": [
        {
          "roles": [
            "admin"
          ],
          "scheme": "http",
          "path": "/geoserver/web/"
        },
        {
          "roles": [
            "api"
          ],
          "scheme": "http",
          "path": "/geoserver/rest/"
        }
      ]
    }
  ],
  "trademark": "GeoServer",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "3.0.x",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "2"
  },
  "upstream": {
    "image": "https://docker.osgeo.org/geoserver",
    "docs": [
      "https://docs.geoserver.org/latest/en/user/installation/docker.html",
      "https://github.com/geoserver/docker"
    ]
  },
  "credentials": {
    "username": {
      "source": "inline",
      "value": "admin"
    },
    "password": {
      "source": "container-env",
      "name": "W9_LOGIN_PASSWORD"
    }
  },
  "help": {
    "login": "Log in at /geoserver/web with the built-in administrator account shown below. Change the default password from the GeoServer security settings after first login."
  }
}
