W9_REPO=docker.osgeo.org/geoserver
W9_DIST=community
W9_VERSION=3.0.x

# Password seed for the built-in GeoServer administrator account.
W9_POWER_PASSWORD="1PrMxExC45LsCT"

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=geoserver

W9_HTTP_PORT=8080
W9_HTTP_PORT_SET=9001

# Built-in login and URL helpers: keep these in the protected block because the appstore parser
# reads them from the app package metadata surface.
W9_LOGIN_USER=admin
W9_LOGIN_PASSWORD=${W9_POWER_PASSWORD}
W9_ADMIN_PATH="/geoserver/web"
# Use a domain-style placeholder for W9_URL, e.g. appname.example.com or example.youdomain.com.
# Do NOT use internet_ip:${W9_HTTP_PORT_SET}; host substitution is the consumer's concern.
W9_URL=appname.example.com
W9_URL_REPLACE=true

W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# GeoServer image environment variables
# Docs: https://docs.geoserver.org/latest/en/user/installation/docker.html
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
GEOSERVER_ADMIN_USER=${W9_LOGIN_USER}
GEOSERVER_ADMIN_PASSWORD=${W9_LOGIN_PASSWORD}
# Keep the bundled demo data so the web UI and OGC services are usable on first start.
SKIP_DEMO_DATA=false
# Redirect "/" to the GeoServer web interface.
ROOT_WEBAPP_REDIRECT=true
# Public base URL used for generated links when the app sits behind a proxy.
PROXY_BASE_URL=http://${W9_URL}/geoserver
EXTRA_JAVA_OPTS="-Xms512m -Xmx1g"

# Not used by default; enable only when needed:
# INSTALL_EXTENSIONS=true
# STABLE_EXTENSIONS=wps,ysld
# CORS_ENABLED=true
# POSTGRES_JNDI_ENABLED=true
# RUN_UNPRIVILEGED=true
