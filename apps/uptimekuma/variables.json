{
  "name": "uptimekuma",
  "access": [
    {
      "id": "web",
      "service": "uptime-kuma",
      "port": 3001,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "dashboard"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "trademark": "Uptime Kuma",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/louislam/uptime-kuma",
    "releases": "https://github.com/louislam/uptime-kuma/releases",
    "docs": [
      "https://github.com/louislam/uptime-kuma/wiki/Environment-Variables"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "2.5.9",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "1"
  }
}
