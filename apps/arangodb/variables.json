{
  "name": "arangodb",
  "trademark": "ArangoDB",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/_/arangodb",
    "releases": "https://github.com/arangodb/arangodb",
    "docs": [
      "https://docs.arangodb.com/stable/release-notes/",
      "https://hub.docker.com/_/arangodb"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "3.12",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8529,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "1"
  },
  "credentials": {
    "username": {
      "source": "inline",
      "value": "root"
    },
    "password": {
      "source": "container-env",
      "name": "W9_LOGIN_PASSWORD"
    }
  },
  "env": {
    "first_startup_only": [
      "ARANGO_ROOT_PASSWORD"
    ]
  }
}
