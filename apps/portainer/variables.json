{
  "name": "portainer",
  "trademark": "Portainer",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/portainer/portainer-ce"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "2.45.1",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 9000,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "4"
  },
  "credentials": {
    "token": {
      "source": "container-log",
      "match": "regex",
      "pattern": "setup_token=([0-9a-fA-F]+)",
      "group": 1
    }
  },
  "help": {
    "login": "On an uninitialized instance, Portainer prints a one-time setup token to the container log; paste it into the setup screen to create the administrator account."
  }
}
