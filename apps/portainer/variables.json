{
  "name": "portainer",
  "trademark": "Portainer",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/portainer/portainer-ce"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "2.45.1",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 9000,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "4"
  },
  "setup": {
    "steps": [
      {
        "id": "setup-token",
        "text": "View the container logs and copy the one-time setup token printed by Portainer.",
        "action": {
          "type": "show-log",
          "service": "portainer",
          "tail": 50
        }
      },
      {
        "id": "setup-wizard",
        "text": "Open Portainer and paste the setup token to create the first administrator account.",
        "action": {
          "type": "open",
          "access": "web"
        }
      }
    ]
  },
  "help": {
    "login": "After the setup wizard finishes, sign in with the administrator account and password you created there."
  }
}
