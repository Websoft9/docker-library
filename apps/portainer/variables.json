{
  "name": "portainer",
  "trademark": "Portainer",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/portainer/portainer-ce"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "2.45.1",
        "latest"
      ]
    }
  ],
  "access": [
    {
      "id": "web",
      "service": "portainer",
      "port": 9000,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "web"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "4"
  },
  "credentials": {
    "none": true
  },
  "help": {
    "login": "On first startup, check the portainer container logs if a one-time setup token is requested, then open Portainer to create the initial administrator account and sign in."
  }
}
