{
  "name": "portainer",
  "trademark": "Portainer",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/portainer/portainer-ce"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "2.34.0",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 9000,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "4"
  }
}
