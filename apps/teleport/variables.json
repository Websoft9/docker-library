{
  "name": "teleport",
  "access": [
    {
      "id": "web",
      "service": "teleport",
      "port": 3080,
      "public": true,
      "requireDomain": false,
      "host": [
        "TELEPORT_PUBLIC_HOST"
      ],
      "endpoints": [
        {
          "roles": [
            "web"
          ],
          "scheme": "https",
          "path": "/web/"
        }
      ]
    }
  ],
  "trademark": "Teleport",
  "release": true,
  "upstream": {
    "image": "https://gallery.ecr.aws/gravitational/teleport-distroless",
    "releases": "https://github.com/gravitational/teleport",
    "docs": [
      "https://goteleport.com/docs/installation/single-machine/docker/"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "18.10"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "1"
  }
}
