{
  "name": "teleport",
  "trademark": "Teleport",
  "release": true,
  "upstream": {
    "image": "https://gallery.ecr.aws/gravitational/teleport-distroless",
    "releases": "https://github.com/gravitational/teleport/releases",
    "docs": [
      "https://goteleport.com/docs/installation/single-machine/docker/"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "18.10"
      ]
    }
  ],
  "access": {
    "web": {
      "port": 3080,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "1"
  }
}
