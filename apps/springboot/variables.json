{
  "name": "springboot",
  "access": [
    {
      "id": "api",
      "service": "springboot",
      "port": 8080,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "api"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "trademark": "Spring Boot",
  "release": true,
  "upstream": {
    "image": "https://github.com/spring-projects/spring-boot",
    "releases": "https://github.com/spring-projects/spring-boot/releases",
    "docs": [
      "https://docs.spring.io/spring-boot/installing.html",
      "https://hub.docker.com/_/maven"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "4.1.1",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "5"
  },
  "database": [
    {
      "id": "rds",
      "providers": [
        {
          "type": "external",
          "drivers": [
            "postgresql",
            "mysql",
            "mariadb"
          ]
        }
      ],
      "datasource": {
        "DATABASE_URL": "${url}"
      }
    }
  ],
  "credentials": {},
  "env": {
    "first_startup_only": []
  },
  "help": {
    "db": "No database by default. Uncomment DATABASE_URL in .env to connect an external PostgreSQL database."
  }
}
