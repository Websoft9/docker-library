W9_REPO=maven
W9_DIST=community
W9_VERSION=4.1.1

# Optional password seed for the bundled PostgreSQL (used only when the
# postgres profile is enabled below).
W9_POWER_PASSWORD='9NMXTyLNDCuwUd8Y'

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=springboot
W9_HTTP_PORT=8080
W9_HTTP_PORT_SET=9001

W9_DB_EXPOSE=postgresql
W9_DB_VERSION=17

W9_URL=internet_ip:${W9_HTTP_PORT_SET}

W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# Optional bundled PostgreSQL: uncomment the next line to start it and wire the
# app to it. This single switch also enables the Spring "postgres" profile.
# COMPOSE_PROFILES=postgres

# ============================================================
# Spring Boot workspace environment variables
# Docs: https://docs.spring.io/spring-boot/installing.html
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# The container runs the official Maven image and bootstraps a demo
# project into /workspace on first start.
# ============================================================

# Used by docker-compose.yml:
MAVEN_OPTS=-Xmx512m
SPRING_DATASOURCE_URL=jdbc:postgresql://${W9_ID}-postgresql:5432/springboot
SPRING_DATASOURCE_USERNAME=springboot
SPRING_DATASOURCE_PASSWORD=${W9_POWER_PASSWORD}

# Not used by default; enable only when needed:
# SPRING_PROFILES_ACTIVE=default
# SERVER_PORT=8080
# SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
# SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=5000
