W9_REPO=websoft9dev/akeneo
W9_DIST=community
W9_VERSION=v2026.4
W9_POWER_PASSWORD="l3Of!CFkf8r!EhyI"

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=akeneo
W9_HTTP_PORT=80
W9_HTTP_PORT_SET=9001
W9_DB_EXPOSE=mysql
W9_DB_VERSION=8.4
W9_LOGIN_USER=admin
W9_LOGIN_PASSWORD=${W9_POWER_PASSWORD}
W9_URL=akeneo.example.com
W9_URL_REPLACE=true
W9_NETWORK=websoft9
W9_ES_VERSION=8.17.0

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# Akeneo image environment variables
# Docs: https://docs.akeneo.com/master/install_pim/docker/installation_docker.html
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
APP_ENV=prod
APP_DEBUG=0
APP_DEFAULT_LOCALE=en
APP_SECRET=${W9_POWER_PASSWORD}
AKENEO_PIM_URL=http://${W9_URL}
AKENEO_ADMIN_USER=${W9_LOGIN_USER}
AKENEO_ADMIN_PASSWORD=${W9_LOGIN_PASSWORD}
AKENEO_ADMIN_EMAIL=admin@example.com
APP_DATABASE_HOST=${W9_ID}-mysql
APP_DATABASE_PORT=3306
APP_DATABASE_NAME=akeneo_pim
APP_DATABASE_USER=akeneo_pim
APP_DATABASE_PASSWORD=${W9_POWER_PASSWORD}
APP_INDEX_HOSTS=${W9_ID}-elasticsearch:9200
ES_JAVA_OPTS=-Xms1g -Xmx1g

# Not used by default; enable only when needed:
# MAILER_FROM="Akeneo <no-reply@example.com>"
# MAILER_DSN=null://foo:bar@localhost?encryption=tls&auth_mode=login
# PUBSUB_AUTO_SETUP=false
# GOOGLE_CLOUD_PROJECT=emulator-project
# PUBSUB_EMULATOR_HOST=
