{
  "name": "akeneo",
  "trademark": "Akeneo",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/websoft9dev/akeneo",
    "releases": "https://github.com/akeneo/pim-community-dev",
    "compose": {
      "compose": "https://raw.githubusercontent.com/akeneo/pim-community-dev/v2026.4/docker-compose.yml",
      "env": "https://raw.githubusercontent.com/akeneo/pim-community-dev/v2026.4/.env"
    },
    "docs": [
      "https://packagist.org/packages/akeneo/pim-community-standard",
      "https://docs.akeneo.com/master/install_pim/docker/installation_docker.html",
      "https://docs.akeneo.com/master/technical_architecture/technical_information/server_side_setup_for_hosting.html",
      "https://docs.akeneo.com/master/install_pim/manual/scheduled_job.html"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "v2026.4"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 80,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "5"
  },
  "database": [
    {
      "id": "mysql",
      "providers": [
        {
          "type": "internal",
          "service": "mysql",
          "driver": "mysql"
        },
        {
          "type": "external",
          "drivers": [
            "mysql"
          ]
        }
      ],
      "datasource": {
        "APP_DATABASE_HOST": "${host}",
        "APP_DATABASE_PORT": "${port}",
        "APP_DATABASE_NAME": "${name}",
        "APP_DATABASE_USER": "${users[*].user}",
        "APP_DATABASE_PASSWORD": "${users[*].password}"
      }
    },
    {
      "id": "elasticsearch",
      "providers": [
        {
          "type": "internal",
          "service": "elasticsearch",
          "driver": "elasticsearch"
        }
      ],
      "users": []
    }
  ],
  "env": {
    "first_startup_only": [
      "AKENEO_ADMIN_USER",
      "AKENEO_ADMIN_PASSWORD"
    ]
  },
  "help": {
    "db": "Akeneo requires MySQL 8.4 and Elasticsearch 8.17 for this package. This package bundles MySQL 8.4 and Elasticsearch 8.17.0 for a single-node deployment."
  }
}