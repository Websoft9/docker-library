{
  "name": "localai",
  "trademark": "LocalAI",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "v3.9.0",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8080,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "8"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/localai/localai"
  }
}
