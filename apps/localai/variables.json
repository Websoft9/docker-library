{
  "name": "localai",
  "trademark": "LocalAI",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "v4.6.2"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8080,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "8"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/localai/localai",
    "releases": "https://github.com/mudler/LocalAI/releases",
    "docs": [
      "https://localai.io/docs/getting-started/containers/",
      "https://localai.io/docs/getting-started/models/",
      "https://github.com/mudler/LocalAI"
    ]
  },
  "env": {
    "secrets": [
      "LOCALAI_API_KEY"
    ]
  }
}
