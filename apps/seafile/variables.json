{
  "name": "seafile",
  "trademark": "Seafile",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "13.0-latest"
      ]
    }
  ],
  "access": {
    "web": {
      "port": 80,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "2",
    "disk": "4"
  },
  "database": [
    {
      "id": "mariadb",
      "providers": [
        {
          "type": "internal",
          "service": "db",
          "driver": "mariadb"
        },
        {
          "type": "external",
          "drivers": [
            "mariadb",
            "mysql"
          ]
        }
      ],
      "name": [
        "${SEAFILE_MYSQL_DB_CCNET_DB_NAME}",
        "${SEAFILE_MYSQL_DB_SEAFILE_DB_NAME}",
        "${SEAFILE_MYSQL_DB_SEAHUB_DB_NAME}"
      ],
      "users": [
        {
          "user": "root",
          "password": "${INIT_SEAFILE_MYSQL_ROOT_PASSWORD}",
          "usage": [
            "initialization",
            "administration"
          ]
        },
        {
          "user": "${SEAFILE_MYSQL_DB_USER}",
          "password": "${SEAFILE_MYSQL_DB_PASSWORD}",
          "usage": [
            "application"
          ]
        }
      ],
      "datasource": {
        "SEAFILE_MYSQL_DB_HOST": "${host}",
        "SEAFILE_MYSQL_DB_PORT": "${port}",
        "SEAFILE_MYSQL_DB_USER": "${users[*].user}",
        "SEAFILE_MYSQL_DB_PASSWORD": "${users[*].password}"
      }
    },
    {
      "id": "redis",
      "providers": [
        {
          "type": "internal",
          "service": "redis",
          "driver": "redis"
        }
      ],
      "datasource": {
        "REDIS_HOST": "${host}",
        "REDIS_PORT": "${port}",
        "REDIS_PASSWORD": "${users[*].password}"
      }
    }
  ],
  "env": {
    "first_startup_only": [
      "INIT_SEAFILE_MYSQL_ROOT_PASSWORD",
      "INIT_SEAFILE_ADMIN_EMAIL",
      "INIT_SEAFILE_ADMIN_PASSWORD"
    ]
  },
  "help": {
    "db": "Bundled MariaDB and Redis are initialized from the package env on first deployment.",
    "login": "The initial administrator account comes from W9_LOGIN_USER and W9_LOGIN_PASSWORD on first startup; later edits do not backfill existing data.",
    "url": "Set SEAFILE_SERVER_PROTOCOL=https when the app is published behind an HTTPS gateway or domain, and set SEAFILE_EXTERNAL_HOSTPORT to a reachable IP:port when no domain is bound."
  },
  "upstream": {
    "image": "https://hub.docker.com/r/seafileltd/seafile-mc",
    "docs": [
      "https://manual.seafile.com/latest/setup/setup_ce_by_docker/",
      "https://manual.seafile.com/latest/extension/only_office/",
      "https://manual.seafile.com/latest/upgrade/upgrade_notes_for_13.0.x/",
      "https://manual.seafile.com/latest/setup/use_other_reverse_proxy/"
    ]
  }
}