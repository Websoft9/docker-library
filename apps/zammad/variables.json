{
  "name": "zammad",
  "trademark": "Zammad",
  "release": true,
  "upstream": {
    "image": "ghcr.io/zammad/zammad",
    "releases": "https://github.com/zammad/zammad-docker-compose/releases",
    "compose": {
      "compose": "https://github.com/zammad/zammad-docker-compose/blob/v17.2.0/docker-compose.yml",
      "env": "https://github.com/zammad/zammad-docker-compose/blob/v17.2.0/.env.dist"
    },
    "docs": [
      "https://docs.zammad.org/en/latest/install/docker-compose.html",
      "https://docs.zammad.org/en/latest/install/docker-compose/environment.html"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "7.1",
        "latest"
      ]
    }
  ],
  "access": {
    "web": {
      "port": 8080,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "8"
  },
  "database": [
    {
      "id": "postgres",
      "providers": [
        {
          "type": "internal",
          "service": "zammad-postgresql",
          "driver": "postgresql"
        },
        {
          "type": "external",
          "drivers": [
            "postgresql"
          ]
        }
      ],
      "name": [
        "${ZAMMAD_DB}"
      ],
      "users": [
        {
          "user": "${POSTGRES_USER}",
          "password": "${POSTGRES_PASSWORD}",
          "usage": [
            "initialization",
            "administration"
          ]
        },
        {
          "user": "${ZAMMAD_DB_USER}",
          "password": "${ZAMMAD_DB_PASS}",
          "usage": [
            "application"
          ]
        }
      ],
      "datasource": {
        "POSTGRESQL_HOST": "${host}",
        "POSTGRESQL_PORT": "${port}",
        "POSTGRESQL_DB": "${name}",
        "POSTGRESQL_USER": "${users[*].user}",
        "POSTGRESQL_PASS": "${users[*].password}"
      }
    },
    {
      "id": "elasticsearch",
      "providers": [
        {
          "type": "internal",
          "service": "zammad-elasticsearch",
          "driver": "elasticsearch"
        }
      ],
      "users": [],
      "datasource": {
        "ELASTICSEARCH_HOST": "${host}",
        "ELASTICSEARCH_PORT": "${port}"
      }
    },
    {
      "id": "redis",
      "providers": [
        {
          "type": "internal",
          "service": "zammad-redis",
          "driver": "redis"
        }
      ],
      "users": [],
      "datasource": {
        "REDIS_URL": "redis://${host}:${port}"
      }
    }
  ],
  "credentials": {},
  "env": {
    "first_startup_only": [
      "W9_POWER_PASSWORD",
      "W9_RCODE"
    ]
  },
  "help": {
    "db": "Bundled PostgreSQL 17 stores Zammad data; bundled Elasticsearch 9 powers search and reports."
  }
}