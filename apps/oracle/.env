W9_REPO=container-registry.oracle.com/database/express
W9_DIST=community
W9_VERSION=latest

W9_POWER_PASSWORD=X14eTpm7LjDGZT

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=oracle

# Oracle Enterprise Manager (EM) port
W9_HTTPS_PORT=5500
W9_HTTPS_PORT_SET=5500
W9_ADMIN_PATH="/em"

W9_DB_PORT=1521
W9_DB_PORT_SET=1521

W9_LOGIN_USER=sys
W9_LOGIN_PASSWORD=${W9_POWER_PASSWORD}
W9_LOGIN_Oracle_SID=XE
W9_LOGIN_Oracle_PDB=XEPDB1

W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# Oracle Database image environment variables
# Docs: https://container-registry.oracle.com/ords/f?p=113:10::::::
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
ORACLE_CHARACTERSET=AL32UTF8
ORACLE_PWD=${W9_POWER_PASSWORD}

# Not used by default; enable only when needed:
# ORACLE_EDITION=enterprise
# ORACLE_SID=XE
# ORACLE_PDB=XEPDB1
# ORACLE_BASE=/opt/oracle
# ORACLE_HOME=/opt/oracle/product/21c/dbhomeXE
