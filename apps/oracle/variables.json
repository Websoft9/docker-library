{
  "name": "oracle",
  "access": [
    {
      "id": "admin",
      "service": "oracleex",
      "port": 5500,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "admin"
          ],
          "scheme": "https",
          "path": "/em/"
        }
      ]
    },
    {
      "id": "db",
      "service": "oracleex",
      "port": 1521,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "db"
          ],
          "scheme": "oracle"
        }
      ]
    }
  ],
  "trademark": "Oracle Database",
  "release": true,
  "upstream": {
    "image": "https://container-registry.oracle.com/database/express"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "21.3.0-xe",
        "18.4.0-xe",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "2",
    "memory": "8",
    "disk": "1"
  }
}
