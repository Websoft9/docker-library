{
  "name": "oracle",
  "trademark": "Oracle Database",
  "release": true,
  "upstream": {
    "image": "https://container-registry.oracle.com/ords/ocr/ba/database/express"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "21.3.0-xe",
        "18.4.0-xe",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "https",
    "web": {
      "port": 5500,
      "path": "/"
    },
    "admin": {
      "port": 5500,
      "path": "/em"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "8",
    "disk": "1"
  }
}
