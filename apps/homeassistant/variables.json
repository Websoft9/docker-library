{
  "name": "homeassistant",
  "access": [
    {
      "id": "web",
      "service": "homeassistant",
      "port": 8123,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "web"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "trademark": "Home Assistant",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/homeassistant/home-assistant"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "2026.10",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "4"
  }
}
