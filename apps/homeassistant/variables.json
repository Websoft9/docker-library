{
  "name": "homeassistant",
  "trademark": "Home Assistant",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/homeassistant/home-assistant"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "2025.7",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8123,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "4"
  }
}
