W9_REPO=ghcr.io/mlflow/mlflow
W9_DIST=community
W9_VERSION=v3.17.1

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=mlflow
W9_HTTP_PORT=5000
W9_HTTP_PORT_SET=9001
W9_URL=example.youdomain.com
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# MLflow image environment variables
# Docs: https://mlflow.org/docs/latest/cli.html#mlflow-server
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
MLFLOW_HOME=/workspaces/mlflow
MLFLOW_TRACKING_URI=sqlite:////workspaces/mlflow/mlruns.db
# MLflow 3.x rejects Host headers it does not allow; the public host is unknown
# at package time, so allow all hosts (see docs/w9-env-spec.md).
MLFLOW_SERVER_ALLOWED_HOSTS=*

# Not used by default; enable only when needed:
# MLFLOW_SERVER_CORS_ALLOWED_ORIGINS=
# MLFLOW_SERVER_WORKERS=4
# MLFLOW_SERVER_WORKER_CONNECTIONS=1000
# MLFLOW_SERVER_TIMEOUT=60
