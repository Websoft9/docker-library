{
  "name": "mlflow",
  "trademark": "MLflow",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "v3.17.1",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 5000,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "2"
  },
  "upstream": {
    "image": "ghcr.io/mlflow/mlflow",
    "releases": "https://github.com/mlflow/mlflow/releases",
    "compose": {
      "compose": "https://raw.githubusercontent.com/mlflow/mlflow/v3.17.1/docker-compose/docker-compose.yml",
      "env": "https://raw.githubusercontent.com/mlflow/mlflow/v3.17.1/docker-compose/.env.dev.example"
    },
    "docs": [
      "https://mlflow.org/docs/latest/self-hosting/index.html",
      "https://mlflow.org/docs/latest/cli.html#mlflow-server"
    ]
  }
}
