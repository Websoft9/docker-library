{
  "name": "typesense",
  "access": [
    {
      "id": "api",
      "service": "typesense",
      "port": 8108,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "api"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "trademark": "Typesense",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "30.2"
      ]
    }
  ],
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "1"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/typesense/typesense"
  },
  "env": {
    "secrets": [
      "W9_LOGIN_API_KEY"
    ]
  }
}
