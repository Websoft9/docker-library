W9_REPO=linuxserver/grav
W9_DIST=community
W9_VERSION=2.2.8

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=grav

# Web/internal ports: uncomment the ones the package actually uses.
W9_HTTP_PORT=80
W9_HTTP_PORT_SET=9001

# Built-in login and URL helpers: keep these in the protected block because the appstore parser
# reads them from the app package metadata surface.
# Grav CMS creates the first administrator account interactively in the browser, so no login pair is seeded.
# Use a domain-style placeholder for W9_URL, e.g. appname.example.com or example.youdomain.com.
# Do NOT use internet_ip:${W9_HTTP_PORT_SET}; host substitution is the consumer's concern.
W9_URL=appname.example.com
W9_ADMIN_PATH="/admin"

W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# Grav CMS image environment variables
# Docs: https://docs.linuxserver.io/images/docker-grav/
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
PUID=1000
PGID=1000
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
TZ=Europe/London

# Not used by default; enable only when needed:
# UMASK=022
