{
  "name": "grav",
  "access": [
    {
      "id": "web",
      "service": "grav",
      "port": 80,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "web"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "trademark": "Grav CMS",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/linuxserver/grav",
    "releases": "https://github.com/getgrav/grav/releases",
    "docs": [
      "https://github.com/getgrav/grav",
      "https://docs.linuxserver.io/images/docker-grav/"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "2.2.8",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "1"
  },
  "help": {
    "init": "First run: open /admin and create the administrator account in the browser, then log in with those credentials.",
    "login": "Log in at /admin with the administrator account you created."
  }
}