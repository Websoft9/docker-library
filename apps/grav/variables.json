{
  "name": "grav",
  "trademark": "Grav CMS",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/linuxserver/grav",
    "releases": "https://github.com/getgrav/grav/releases",
    "docs": [
      "https://github.com/getgrav/grav",
      "https://docs.linuxserver.io/images/docker-grav/"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": ["2.2.8", "latest"]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 80,
      "path": "/"
    },
    "admin": {
      "port": 80,
      "path": "/admin"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "1"
  },
  "help": {
    "login": "First run: open /admin and create the administrator account in the browser, then log in with those credentials."
  }
}
