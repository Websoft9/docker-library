{
  "name": "thingsboard",
  "access": [
    {
      "id": "web",
      "service": "thingsboard-ce",
      "port": 8080,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "dashboard"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "trademark": "ThingsBoard",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/thingsboard/tb-node",
    "releases": "https://github.com/thingsboard/thingsboard/releases",
    "docs": [
      "https://thingsboard.io/docs/installation/docker/",
      "https://github.com/thingsboard/thingsboard"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "4.4.0-latest",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "2"
  },
  "database": [
    {
      "id": "postgres",
      "providers": [
        {
          "type": "internal",
          "service": "postgres",
          "driver": "postgresql"
        },
        {
          "type": "external",
          "drivers": [
            "postgresql"
          ]
        }
      ],
      "datasource": {
        "SPRING_DATASOURCE_URL": "jdbc:postgresql://${host}:${port}/${name}",
        "SPRING_DATASOURCE_USERNAME": "${users[*].user}",
        "SPRING_DATASOURCE_PASSWORD": "${users[*].password}"
      }
    }
  ],
  "credentials": {
    "none": true
  }
}
