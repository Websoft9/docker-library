W9_REPO=thingsboard/tb-node
W9_DIST=community
W9_VERSION=4.3.1

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=thingsboard
W9_HTTP_PORT=8080
W9_HTTP_PORT_SET=9009

W9_DB_EXPOSE=postgresql
W9_DB_VERSION=18

W9_LOGIN_USER=sysadmin@thingsboard.org
W9_LOGIN_PASSWORD=sysadmin

W9_URL=appname.example.com

W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# ThingsBoard image environment variables
# Docs: https://thingsboard.io/docs/installation/docker/
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# ============================================================

# Used by docker-compose.yml:
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=postgres
POSTGRESQL_DATABASE_NAME=thingsboard
POSTGRESQL_HOST=${W9_ID}-postgres
POSTGRESQL_PORT=5432

# Not used by default; enable only when needed:
