W9_REPO=sonarqube
W9_DIST=community
W9_VERSION=26.9.0.129388-community

# Optional password seed: enable only when the package actually controls a DB or built-in login.
# See docs/w9-env-spec.md for when W9_POWER_PASSWORD is appropriate.
W9_POWER_PASSWORD='8!xsxI#KZQdK9REH'

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=sonarqube
W9_HTTP_PORT=9000
W9_HTTP_PORT_SET=9001

# Dependency helpers: bundled PostgreSQL stores SonarQube data.
W9_DB_EXPOSE=postgresql
W9_DB_VERSION=17

# Built-in login: SonarQube seeds the default admin account on first start.
W9_LOGIN_USER=admin
W9_LOGIN_PASSWORD=admin

W9_URL=example.youdomain.com

W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# SonarQube image environment variables
# Docs: https://hub.docker.com/_/sonarqube
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
SONAR_JDBC_URL=jdbc:postgresql://${W9_ID}-postgresql:5432/sonar
SONAR_JDBC_USERNAME=postgres
SONAR_JDBC_PASSWORD=${W9_POWER_PASSWORD}

# Not used by default; enable only when needed:
# SONAR_WEB_JAVAOPTS=-Xmx2g
# SONAR_CE_JAVAOPTS=-Xmx1g
# SONAR_SEARCH_JAVAOPTS=-Xmx1g
# SONAR_WEB_CONTEXT=/sonarqube
# SONAR_JDBC_MAXACTIVE=60
