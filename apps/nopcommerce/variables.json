{
  "name": "nopcommerce",
  "access": [
    {
      "id": "web",
      "service": "nopcommerce",
      "port": 80,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "web"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "trademark": "NopCommerce",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "4.90.8",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "1"
  },
  "database": [
    {
      "id": "mysql",
      "providers": [
        {
          "type": "internal",
          "service": "mysql",
          "driver": "mysql"
        }
      ]
    }
  ],
  "upstream": {
    "image": "https://hub.docker.com/r/nopcommerceteam/nopcommerce",
    "releases": "https://github.com/nopSolutions/nopCommerce/releases",
    "docs": [
      "https://github.com/nopSolutions/nopCommerce/releases/tag/release-4.90.8",
      "https://www.nopcommerce.com/release-notes"
    ]
  }
}
