{
  "name": "opensearch",
  "trademark": "OpenSearch",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "3",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "https",
    "api": {
      "port": 9200,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "8",
    "disk": "8"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/opensearchproject/opensearch"
  }
}
