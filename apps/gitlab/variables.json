{
  "name": "gitlab",
  "trademark": "Gitlab",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "19.3.2-ce.0",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "2",
    "memory": "8",
    "disk": "10"
  },
  "help": {
    "runner": "This package deploys GitLab only. GitLab Runner is not started by default because it requires separate registration and runner-specific configuration."
  },
  "upstream": {
    "image": "https://hub.docker.com/r/gitlab/gitlab-ce",
    "releases": "https://github.com/gitlabhq/gitlabhq/tags",
    "docs": [
      "https://docs.gitlab.com/install/docker/installation",
      "https://docs.gitlab.com/update/upgrade_paths",
      "https://docs.gitlab.com/runner/install/docker",
      "https://docs.gitlab.com/update/versions/gitlab_19_changes"
    ]
  },
  "env": {
    "first_startup_only": [
      "W9_LOGIN_PASSWORD"
    ]
  }
}
