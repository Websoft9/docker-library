{
  "name": "kong",
  "trademark": "Kong Gateway (OSS)",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "3.9",
        "latest"
      ]
    }
  ],
  "access": {
    "web": {
      "port": 8000
    },
    "admin": {
      "port": 8002
    },
    "api": {
      "port": 8001
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "1"
  },
  "upstream": {
    "image": "https://hub.docker.com/_/kong"
  }
}
