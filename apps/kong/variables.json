{
  "name": "kong",
  "access": [
    {
      "id": "admin",
      "service": "kong",
      "port": 8002,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "admin"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    },
    {
      "id": "gateway",
      "service": "kong",
      "port": 8000,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "gateway"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    },
    {
      "id": "api",
      "service": "kong",
      "port": 8001,
      "public": true,
      "rootUrl": [
        "KONG_ADMIN_GUI_API_URL"
      ],
      "endpoints": [
        {
          "roles": [
            "api"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "trademark": "Kong Gateway (OSS)",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/_/kong",
    "releases": "https://github.com/Kong/kong/releases",
    "docs": [
      "https://docs.konghq.com/gateway/latest/install/docker/",
      "https://docs.konghq.com/gateway/latest/production/environment-variables/",
      "https://github.com/Kong/docker-kong/tree/master/compose"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "3.9",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "1"
  },
  "database": [
    {
      "id": "postgres",
      "providers": [
        {
          "type": "internal",
          "service": "db",
          "driver": "postgresql"
        },
        {
          "type": "external",
          "drivers": [
            "postgresql"
          ]
        }
      ],
      "datasource": {
        "KONG_PG_HOST": "${host}",
        "KONG_PG_DATABASE": "${name}",
        "KONG_PG_USER": "${users[*].user}",
        "KONG_PG_PASSWORD": "${users[*].password}"
      }
    }
  ]
}
