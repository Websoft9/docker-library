{
  "name": "kong",
  "trademark": "Kong Gateway (OSS)",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/_/kong",
    "releases": "https://github.com/Kong/kong/releases",
    "docs": [
      "https://docs.konghq.com/gateway/latest/install/docker/",
      "https://docs.konghq.com/gateway/latest/production/environment-variables/",
      "https://github.com/Kong/docker-kong/tree/master/compose"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "3.9",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8002,
      "path": "/admin"
    },
    "admin": {
      "port": 8000,
      "path": "/"
    },
    "api": {
      "port": 8001,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "1"
  },
  "database": [
    {
      "id": "postgres",
      "providers": [
        {
          "type": "internal",
          "service": "db",
          "driver": "postgresql"
        },
        {
          "type": "external",
          "drivers": [
            "postgresql"
          ]
        }
      ],
      "datasource": {
        "KONG_PG_HOST": "${host}",
        "KONG_PG_DATABASE": "${name}",
        "KONG_PG_USER": "${users[*].user}",
        "KONG_PG_PASSWORD": "${users[*].password}"
      }
    }
  ]
}