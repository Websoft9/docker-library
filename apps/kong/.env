W9_REPO=kong
W9_DIST=community
W9_VERSION=3.9

W9_POWER_PASSWORD='Xk3kABV7Z!3snr5r'

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=kong
W9_HTTP_PORT=8000
W9_HTTP_PORT_SET=8010
W9_DB_EXPOSE=postgresql
W9_DB_VERSION=13
W9_URL=kong.example.com
W9_URL_REPLACE=true
W9_ADMIN_PATH=/admin
W9_NETWORK=websoft9

# Additional Kong entrypoints exposed by this package.
W9_ADMIN_API_PORT_SET=8011
W9_ADMIN_GUI_PORT_SET=8012

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# Kong Gateway (OSS) image environment variables
# Docs: https://docs.konghq.com/gateway/latest/production/environment-variables/
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
KONG_DATABASE=postgres
KONG_PG_DATABASE=kong
KONG_PG_HOST=${W9_ID}-postgresql
KONG_PG_USER=kong
KONG_PG_PASSWORD=${W9_POWER_PASSWORD}
KONG_PROXY_LISTEN=0.0.0.0:8000
# Expose the Admin API because this package also publishes it on W9_ADMIN_API_PORT_SET.
KONG_ADMIN_LISTEN=0.0.0.0:8001
KONG_ADMIN_GUI_LISTEN=0.0.0.0:8002
KONG_ADMIN_GUI_PATH=${W9_ADMIN_PATH}
KONG_ADMIN_GUI_API_URL=http://${W9_URL}:${W9_ADMIN_API_PORT_SET}
KONG_PROXY_ACCESS_LOG=/dev/stdout
KONG_ADMIN_ACCESS_LOG=/dev/stdout
KONG_PROXY_ERROR_LOG=/dev/stderr
KONG_ADMIN_ERROR_LOG=/dev/stderr
KONG_PREFIX=/tmp/
KONG_DECLARATIVE_CONFIG=/opt/kong/kong.yaml

# Not used by default; enable only when needed:
# KONG_LOG_LEVEL=notice
# KONG_STATUS_LISTEN=0.0.0.0:8100
# KONG_PLUGINS=bundled
