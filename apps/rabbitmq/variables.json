{
  "name": "rabbitmq",
  "access": [
    {
      "id": "admin",
      "service": "rabbitmq",
      "port": 15672,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "admin"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    },
    {
      "id": "amqp",
      "service": "rabbitmq",
      "port": 5672,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "mq"
          ],
          "scheme": "amqp"
        }
      ]
    },
    {
      "id": "epmd",
      "service": "rabbitmq",
      "port": 4369,
      "public": false,
      "endpoints": []
    }
  ],
  "trademark": "RabbitMQ",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/_/rabbitmq",
    "releases": "https://github.com/rabbitmq/rabbitmq-server/releases",
    "docs": [
      "https://github.com/docker-library/rabbitmq",
      "https://www.rabbitmq.com/docs",
      "https://www.rabbitmq.com/docs/upgrade"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "4.4-management"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "4"
  },
  "env": {
    "first_startup_only": [
      "RABBITMQ_DEFAULT_USER",
      "RABBITMQ_DEFAULT_PASS"
    ]
  }
}