{
  "name": "teamcity",
  "access": [
    {
      "id": "web",
      "service": "teamcity-server",
      "port": 8111,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "web"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "trademark": "TeamCity",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/jetbrains/teamcity-server",
    "releases": "https://www.jetbrains.com/teamcity/download/",
    "docs": [
      "https://www.jetbrains.com/help/teamcity/teamcity-documentation.html",
      "https://github.com/JetBrains/teamcity-docker-server",
      "https://github.com/JetBrains/teamcity-docker-samples"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "2026.2",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "1"
  },
  "database": [
    {
      "id": "mysql",
      "providers": [
        {
          "type": "internal",
          "service": "teamcity-mysql",
          "driver": "mysql"
        }
      ]
    }
  ]
}
