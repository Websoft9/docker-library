{
  "name": "nginxproxymanager",
  "trademark": "Nginx Proxy Manager",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "2.16.0",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 81,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "1"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/jc21/nginx-proxy-manager",
    "releases": "https://github.com/NginxProxyManager/nginx-proxy-manager/releases",
    "docs": [
      "https://nginxproxymanager.com/guide/#quick-setup",
      "https://github.com/NginxProxyManager/nginx-proxy-manager/releases/tag/v2.16.0"
    ]
  },
  "credentials": {
    "username": {
      "source": "inline",
      "value": "admin@example.com"
    },
    "password": {
      "source": "inline",
      "value": "changeme"
    }
  }
}
