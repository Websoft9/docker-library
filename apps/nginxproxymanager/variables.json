{
  "name": "nginxmanager",
  "trademark": "Nginx Proxy Manager",
  "release": false,
  "edition": [
    {
      "dist": "community",
      "version": [
        "2.10.4",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 81,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "1"
  }
}
