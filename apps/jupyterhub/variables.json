{
  "name": "jupyterhub",
  "access": [
    {
      "id": "web",
      "service": "jupyterhub",
      "port": 8000,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "notebook"
          ],
          "scheme": "http",
          "path": "/hub/"
        }
      ]
    }
  ],
  "trademark": "JupyterHub",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "6.1",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "4"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/jupyterhub/jupyterhub",
    "docs": [
      "https://jupyterhub.readthedocs.io/en/6.1.1/tutorial/quickstart-docker.html",
      "https://jupyterhub.readthedocs.io/en/6.1.1/tutorial/getting-started/config-basics.html",
      "https://jupyterhub.readthedocs.io/en/6.1.1/howto/upgrading-v6.html"
    ]
  },
  "env": {
    "first_startup_only": [
      "W9_LOGIN_PASSWORD"
    ]
  }
}
