{
  "name": "registry",
  "trademark": "Docker Registry",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/_/registry",
    "releases": "https://github.com/distribution/distribution/releases",
    "docs": [
      "https://distribution.github.io/distribution/about/configuration/",
      "https://distribution.github.io/distribution/about/deploying/"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "3.1",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "1"
  },
  "access": {
    "defaultScheme": "http",
    "api": {
      "port": 5000,
      "path": "/v2/"
    }
  }
}
