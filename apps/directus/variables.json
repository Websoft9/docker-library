{
  "name": "directus",
  "trademark": "Directus",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "11.13",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8055,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "4"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/directus/directus"
  }
}
