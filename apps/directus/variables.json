{
  "name": "directus",
  "trademark": "Directus",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/directus/directus",
    "releases": "https://github.com/directus/directus/releases",
    "docs": [
      "https://directus.io/docs/self-hosting/quickstart",
      "https://directus.io/docs/configuration/general",
      "https://github.com/directus/directus/releases/tag/v12.5.0"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "12.5.0",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8055,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "4"
  },
  "database": [
    {
      "id": "rds",
      "providers": [
        {
          "type": "internal",
          "service": "postgresql",
          "driver": "postgresql"
        },
        {
          "type": "external",
          "drivers": [
            "postgresql"
          ]
        }
      ],
      "datasource": {
        "DB_HOST": "${host}",
        "DB_PORT": "${port}",
        "DB_DATABASE": "${name}",
        "DB_USER": "${users[*].user}",
        "DB_PASSWORD": "${users[*].password}"
      }
    },
    {
      "id": "redis",
      "providers": [
        {
          "type": "internal",
          "service": "cache",
          "driver": "redis"
        }
      ],
      "users": [],
      "datasource": {
        "REDIS": "redis://${host}:${port}"
      }
    }
  ],
  "env": {
    "first_startup_only": [
      "ADMIN_EMAIL",
      "ADMIN_PASSWORD"
    ]
  }
}