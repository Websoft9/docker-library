{
  "name": "directus",
  "trademark": "Directus",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/directus/directus",
    "releases": "https://github.com/directus/directus/releases",
    "docs": [
      "https://directus.io/docs/self-hosting/quickstart",
      "https://directus.io/docs/configuration/general",
      "https://github.com/directus/directus/releases/tag/v12.5.0"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "12.5.0",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8055,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "4"
  },
  "env": {
    "first_startup_only": [
      "ADMIN_EMAIL",
      "ADMIN_PASSWORD"
    ]
  }
}
