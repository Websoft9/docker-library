W9_REPO=directus/directus
W9_DIST=community
W9_VERSION=12.5.0

W9_POWER_PASSWORD='KL70ofeR!Hz699!h'

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=directus
W9_HTTP_PORT=8055
W9_HTTP_PORT_SET=9001
W9_DB_EXPOSE=postgresql
W9_DB_VERSION=13
W9_LOGIN_USER=websoft9@example.com
W9_LOGIN_PASSWORD=${W9_POWER_PASSWORD}
W9_URL=directus.example.com
W9_URL_REPLACE=true
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# Directus image environment variables
# Docs: https://directus.io/docs/configuration/general
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
KEY=255d861b-5ea1-${W9_POWER_PASSWORD}
SECRET=6116487b-cda1-${W9_POWER_PASSWORD}
DB_CLIENT=pg
DB_HOST=${W9_ID}-postgresql
DB_PORT=5432
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=${W9_POWER_PASSWORD}
ADMIN_EMAIL=${W9_LOGIN_USER}
ADMIN_PASSWORD=${W9_LOGIN_PASSWORD}
CACHE_ENABLED=true
CACHE_AUTO_PURGE=true
CACHE_STORE=redis
REDIS=redis://${W9_ID}-redis:6379
PUBLIC_URL=http://${W9_URL}

# Not used by default; enable only when needed:
# TELEMETRY=false
# WEBSOCKETS_ENABLED=true
# CORS_ENABLED=true
# CORS_ORIGIN=true
# IMPORT_MAX_FILE_SIZE=50mb
