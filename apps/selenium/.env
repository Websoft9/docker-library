W9_REPO=selenium/standalone-chrome
W9_DIST=community
W9_VERSION=153.0
W9_POWER_PASSWORD="VZRhqgHzsITR@"

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=selenium
W9_HTTP_PORT=4444
W9_HTTP_PORT_SET=9001
W9_ADMIN_PORT_SET=7900
W9_LOGIN_USER=admin
W9_LOGIN_PASSWORD=${W9_POWER_PASSWORD}
W9_ADMIN_PATH="/?autoconnect=1&resize=scale"
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# Selenium Standalone Chrome image environment variables
# Docs: https://github.com/SeleniumHQ/docker-selenium
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
SE_VNC_PASSWORD=${W9_LOGIN_PASSWORD}

# Not used by default; enable only when needed:
# SE_VNC_NO_PASSWORD=true
# SE_VNC_VIEW_ONLY=true
# SE_START_VNC=false
# SE_NODE_MAX_SESSIONS=1
# SE_NODE_OVERRIDE_MAX_SESSIONS=true
