{
  "name": "selenium",
  "trademark": "Selenium",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/selenium/standalone-chrome",
    "docs": [
      "https://github.com/SeleniumHQ/docker-selenium"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "153.0",
        "latest"
      ]
    }
  ],
  "access": [
    {
      "id": "grid",
      "service": "app",
      "port": 4444,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "dashboard"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    },
    {
      "id": "novnc",
      "service": "app",
      "port": 7900,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "remote-desktop"
          ],
          "scheme": "http",
          "path": "/",
          "query": {
            "autoconnect": "1",
            "resize": "scale"
          }
        }
      ]
    }
  ],
  "credentials": {
    "password": {
      "source": "container-env",
      "name": "W9_LOGIN_PASSWORD"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "2"
  }
}
