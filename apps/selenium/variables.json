{
  "name": "selenium",
  "trademark": "Selenium",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/selenium/standalone-chrome",
    "docs": [
      "https://github.com/SeleniumHQ/docker-selenium"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "153.0",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 4444,
      "path": "/"
    },
    "admin": {
      "port": 7900,
      "path": "/?autoconnect=1&resize=scale"
    }
  },
  "credentials": {
    "password": {
      "source": "container-env",
      "name": "W9_LOGIN_PASSWORD"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "2"
  }
}
