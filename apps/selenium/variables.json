{
  "name": "selenium",
  "trademark": "selenium",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/selenium/standalone-chrome"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "137.0-20250727",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 4444,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "1"
  }
}
