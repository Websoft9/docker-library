{
  "name": "varnish",
  "access": [
    {
      "id": "gateway",
      "service": "varnish",
      "port": 80,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "gateway"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "trademark": "Varnish",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "9.0",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "8"
  },
  "upstream": {
    "image": "https://hub.docker.com/_/varnish",
    "releases": "https://github.com/varnish/varnish/releases",
    "docs": [
      "https://varnish-cache.org/docs/",
      "https://github.com/varnish/docker-varnish"
    ]
  }
}
