{
  "name": "cloudreve",
  "trademark": "Cloudreve",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/cloudreve/cloudreve"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "4.10.1",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 5212,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "10"
  }
}
