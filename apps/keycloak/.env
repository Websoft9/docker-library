W9_REPO=keycloak/keycloak
W9_DIST=community
W9_VERSION=26.8

# Optional password seed: enable only when the package actually controls a DB or built-in login.
# See docs/w9-env-spec.md for when W9_POWER_PASSWORD is appropriate.
W9_POWER_PASSWORD=O06ddT1DY!PXTHHQ

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=keycloak
W9_HTTP_PORT=8080
W9_HTTP_PORT_SET=9001
W9_LOGIN_USER=admin
W9_LOGIN_PASSWORD=${W9_POWER_PASSWORD}
W9_URL=example.youdomain.com
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# Keycloak image environment variables
# Docs: https://www.keycloak.org/getting-started/getting-started-docker
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
KC_BOOTSTRAP_ADMIN_USERNAME=${W9_LOGIN_USER}
KC_BOOTSTRAP_ADMIN_PASSWORD=${W9_LOGIN_PASSWORD}

# Not used by default; enable only when needed:
# KC_HOSTNAME=${W9_URL}
# KC_PROXY_HEADERS=xforwarded
