{
  "name": "keycloak",
  "access": [
    {
      "id": "admin",
      "service": "keycloak",
      "port": 8080,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "admin"
          ],
          "scheme": "http",
          "path": "/admin/"
        },
        {
          "roles": [
            "api"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "trademark": "Keycloak",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/keycloak/keycloak"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "26.8",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "10"
  }
}
