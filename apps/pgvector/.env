W9_REPO=pgvector/pgvector
W9_DIST=community
W9_VERSION=pg18-trixie
W9_POWER_PASSWORD="d5E8n2733TgO8w"

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=pgvector
W9_DB_PORT=5432
W9_DB_PORT_SET=5432
W9_LOGIN_USER=postgres
W9_LOGIN_PASSWORD=${W9_POWER_PASSWORD}
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# pgvector image environment variables
# Docs: https://hub.docker.com/r/pgvector/pgvector
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
POSTGRES_DB=${W9_ID}
POSTGRES_USER=${W9_LOGIN_USER}
POSTGRES_PASSWORD=${W9_POWER_PASSWORD}

# This image is based on PostgreSQL 18, which keeps data under
# /var/lib/postgresql/18/docker; the volume is mounted at /var/lib/postgresql.
# The bundled init script enables the vector extension in the default database.

# Not used by default; enable only when needed:
# POSTGRES_INITDB_ARGS=
# POSTGRES_INITDB_WALDIR=
# POSTGRES_HOST_AUTH_METHOD=scram-sha-256
# POSTGRES_PASSWORD_FILE=/run/secrets/pgvector_password
# POSTGRES_USER_FILE=/run/secrets/pgvector_user
