{
  "name": "pgvector",
  "trademark": "pgvector",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/pgvector/pgvector",
    "docs": [
      "https://github.com/pgvector/pgvector",
      "https://github.com/pgvector/pgvector#docker",
      "https://github.com/pgvector/pgvector#getting-started"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": ["pg18-trixie"]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "1"
  },
  "env": {
    "first_startup_only": [
      "POSTGRES_DB",
      "POSTGRES_PASSWORD",
      "POSTGRES_USER"
    ]
  },
  "help": {
    "db": "pgvector extends PostgreSQL 18 (Debian trixie) with vector similarity search. This package pins the image tag to pg18-trixie."
  }
}
