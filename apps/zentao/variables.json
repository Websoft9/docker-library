{
  "name": "zentao",
  "trademark": "ZenTao",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "22.6",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 80,
      "path": "/"
    }
  },
  "credentials": {},
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "4"
  },
  "database": [
    {
      "id": "mysql",
      "providers": [
        {
          "type": "internal",
          "service": "mysql",
          "driver": "mysql"
        },
        {
          "type": "external",
          "drivers": [
            "mysql"
          ]
        }
      ],
      "users": [
        {
          "user": "root",
          "password": "${MYSQL_ROOT_PASSWORD}",
          "usage": [
            "application",
            "administration"
          ]
        }
      ],
      "datasource": {
        "ZT_MYSQL_HOST": "${host}",
        "ZT_MYSQL_PORT": "${port}",
        "ZT_MYSQL_DB": "${name}",
        "ZT_MYSQL_USER": "${users[*].user}",
        "ZT_MYSQL_PASSWORD": "${users[*].password}"
      }
    }
  ],
  "env": {
    "first_startup_only": []
  },
  "upstream": {
    "image": "https://hub.docker.com/r/easysoft/zentao",
    "docs": [
      "https://github.com/easysoft/zentaopms"
    ]
  }
}