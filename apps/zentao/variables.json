{
  "name": "zentao",
  "trademark": "ZenTao",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "22.6",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 80,
      "path": "/"
    }
  },
  "credentials": {},
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "4"
  },
  "env": {
    "first_startup_only": []
  },
  "upstream": {
    "image": "https://hub.docker.com/r/easysoft/zentao",
    "docs": [
      "https://github.com/easysoft/zentaopms"
    ]
  }
}
