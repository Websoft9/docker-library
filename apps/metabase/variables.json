{
  "name": "metabase",
  "trademark": "Metabase",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/metabase/metabase",
    "releases": "https://github.com/metabase/metabase/releases",
    "docs": [
      "https://www.metabase.com/docs/latest/installation-and-operation/running-metabase-on-docker",
      "https://www.metabase.com/docs/latest/operations-guide/upgrading-metabase"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "v0.64.x",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 3000,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "1"
  },
  "help": {
    "login": "First run: open the site and create the administrator account in the Metabase setup wizard, then sign in with those credentials."
  }
}
