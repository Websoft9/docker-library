{
  "name": "metabase",
  "access": [
    {
      "id": "web",
      "service": "metabase",
      "port": 3000,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "dashboard"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "trademark": "Metabase",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/metabase/metabase",
    "releases": "https://github.com/metabase/metabase/releases",
    "docs": [
      "https://www.metabase.com/docs/latest/installation-and-operation/running-metabase-on-docker",
      "https://www.metabase.com/docs/latest/operations-guide/upgrading-metabase"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "v0.64-lts",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "1"
  },
  "database": [
    {
      "id": "rds",
      "providers": [
        {
          "type": "internal",
          "service": "postgres",
          "driver": "postgresql"
        },
        {
          "type": "external",
          "drivers": [
            "postgresql"
          ]
        }
      ],
      "datasource": {
        "MB_DB_HOST": "${host}",
        "MB_DB_PORT": "${port}",
        "MB_DB_DBNAME": "${name}",
        "MB_DB_USER": "${users[*].user}",
        "MB_DB_PASS": "${users[*].password}"
      }
    }
  ],
  "help": {
    "init": "First run: open the site and create the administrator account in the Metabase setup wizard, then sign in with those credentials.",
    "login": "Sign in with the administrator account you created in the setup wizard."
  }
}