W9_REPO=airbyte/server
W9_DIST=community
W9_VERSION=2.2.0

W9_POWER_PASSWORD="1PrMxExC45LsCT"

W9_ID=airbyte

W9_HTTP_PORT=30080
W9_HTTP_PORT_SET=9001

W9_URL=internet_ip:${W9_HTTP_PORT_SET}
W9_URL_REPLACE=true
W9_ADMIN_PATH=

W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####


# ============================================================
# Airbyte image environment variables
# Docs: https://hub.docker.com/r/airbyte/server
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
AIRBYTE_K3S_IMAGE=rancher/k3s:v1.31.5-k3s1
AIRBYTE_HELM_REPO=https://airbytehq.github.io/charts
AIRBYTE_HELM_RELEASE=airbyte
AIRBYTE_HELM_NAMESPACE=airbyte
AIRBYTE_PUBLIC_URL=http://${W9_URL}
AIRBYTE_BOOTSTRAP_TIMEOUT=1800
AIRBYTE_NODE_PORT=30080
AIRBYTE_INITIAL_PASSWORD=${W9_POWER_PASSWORD}
AIRBYTE_RUNTIME_MEMORY_LIMIT=10g

# Not used by default; enable only when needed:
# AIRBYTE_VALUE_OVERRIDES=
