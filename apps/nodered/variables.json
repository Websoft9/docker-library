{
  "name": "nodered",
  "trademark": "Node-RED",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "5.0",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 1880,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "1"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/nodered/node-red",
    "releases": "https://github.com/node-red/node-red/releases",
    "docs": [
      "https://nodered.org/docs/getting-started/docker",
      "https://github.com/node-red/node-red/releases/tag/5.0.0"
    ]
  }
}
