# Canonical semantics live in docs/w9-env-spec.md.
# This app follows the layout contract from metadata/templates/new-app/.env.tmpl.

W9_REPO=ckan/ckan-base
W9_DIST=community
W9_VERSION=2.12.0
W9_POWER_PASSWORD=urtghkikljee9uy

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=ckan
W9_HTTP_PORT=5000
W9_HTTP_PORT_SET=5000
W9_DB_VERSION=16
W9_DB_EXPOSE=postgresql
W9_LOGIN_USER=ckan_admin
W9_LOGIN_PASSWORD=${W9_POWER_PASSWORD}
W9_URL=example.youdomain.com
W9_URL_REPLACE=true
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# Ckan image environment variables
# Docs: https://github.com/ckan/ckan-docker/blob/master/.env.example
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=${W9_POWER_PASSWORD}
POSTGRES_DB=postgres
POSTGRES_HOST=db
CKAN_POSTGRES_DB=ckandb
CKAN_POSTGRES_USER=ckan_default
CKAN_POSTGRES_USER_PWD=${W9_POWER_PASSWORD}
CKAN_DATASTORE_POSTGRES_DB=datastore
CKAN_DATASTORE_POSTGRES_READ_USER=datastore_read
CKAN_DATASTORE_POSTGRES_READ_PWD=${W9_POWER_PASSWORD}
CKAN_DATASTORE_POSTGRES_WRITE_USER=datastore_write
CKAN_DATASTORE_POSTGRES_WRITE_PWD=${W9_POWER_PASSWORD}
CKAN_SQLALCHEMY_URL=postgresql://ckan_default:${W9_POWER_PASSWORD}@db/ckandb
CKAN_DATASTORE_WRITE_URL=postgresql://datastore_write:${W9_POWER_PASSWORD}@db/datastore
CKAN_DATASTORE_READ_URL=postgresql://datastore_read:${W9_POWER_PASSWORD}@db/datastore
TEST_CKAN_SQLALCHEMY_URL=postgresql://ckan_default:${W9_POWER_PASSWORD}@db/ckan_test
TEST_CKAN_DATASTORE_WRITE_URL=postgresql://datastore_write:${W9_POWER_PASSWORD}@db/datastore_test
TEST_CKAN_DATASTORE_READ_URL=postgresql://datastore_read:${W9_POWER_PASSWORD}@db/datastore_test
USE_HTTPS_FOR_DEV=false
CKAN_SITE_ID=default
CKAN_SITE_URL=http://${W9_URL}
CKAN___BEAKER__SESSION__SECRET=CHANGE_ME
CKAN___API_TOKEN__JWT__ENCODE__SECRET=string:CHANGE_ME
CKAN___API_TOKEN__JWT__DECODE__SECRET=string:CHANGE_ME
CKAN_SYSADMIN_NAME=ckan_admin
CKAN_SYSADMIN_PASSWORD=${W9_POWER_PASSWORD}
CKAN_SYSADMIN_EMAIL=your_email@example.com
CKAN_STORAGE_PATH=/var/lib/ckan
CKAN_SMTP_SERVER=smtp.corporateict.domain:25
CKAN_SMTP_STARTTLS=True
CKAN_SMTP_USER=user
CKAN_SMTP_PASSWORD=${W9_POWER_PASSWORD}
CKAN_SMTP_MAIL_FROM=ckan@localhost
CKAN_MAX_UPLOAD_SIZE_MB=100
TZ=UTC
SOLR_IMAGE_VERSION=2.12-solr9
CKAN_SOLR_URL=http://${W9_ID}-solr:8983/solr/ckan
TEST_CKAN_SOLR_URL=http://${W9_ID}-solr:8983/solr/ckan
REDIS_VERSION=6
CKAN_REDIS_URL=redis://${W9_ID}-redis:6379/1
TEST_CKAN_REDIS_URL=redis://${W9_ID}-redis:6379/1
DATAPUSHER_VERSION=0.0.21
CKAN_DATAPUSHER_URL=http://${W9_ID}-datapusher:8800
CKAN__DATAPUSHER__CALLBACK_URL_BASE=http://${W9_ID}:5000
CKAN__PLUGINS="image_view text_view datatables_view datastore datapusher envvars"
CKAN__HARVEST__MQ__TYPE=redis
CKAN__HARVEST__MQ__HOSTNAME=redis
CKAN__HARVEST__MQ__PORT=6379
CKAN__HARVEST__MQ__REDIS_DB=1

# Not used by default; enable only when needed:
# USE_DEBUGPY_FOR_DEV=true
# EXTRA_UWSGI_OPTS=
