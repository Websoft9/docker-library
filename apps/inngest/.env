W9_REPO=inngest/inngest
W9_DIST=community
W9_VERSION=v1.46.0

W9_POWER_PASSWORD='KMuRwWvHcmoQr9PN'

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=inngest

W9_HTTP_PORT=8288
W9_HTTP_PORT_SET=9002
W9_WS_PORT_SET=9003

W9_DB_EXPOSE=postgresql
W9_DB_VERSION=17

W9_URL=inngest.example.com

W9_NETWORK=websoft9

