{
  "name": "inngest",
  "access": [
    {
      "id": "web",
      "service": "inngest",
      "port": 8288,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "dashboard",
            "api"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    },
    {
      "id": "connect",
      "service": "inngest",
      "port": 8289,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "gateway"
          ],
          "scheme": "ws",
          "path": "/v0/connect"
        }
      ]
    }
  ],
  "trademark": "Inngest",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/inngest/inngest",
    "releases": "https://github.com/inngest/inngest/releases",
    "compose": {
      "compose": "https://www.inngest.com/docs/self-hosting"
    },
    "docs": [
      "https://www.inngest.com/docs/self-hosting",
      "https://github.com/inngest/inngest"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "v1.46.0",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "10"
  },
  "database": [
    {
      "id": "postgres",
      "providers": [
        {
          "type": "internal",
          "service": "postgresql",
          "driver": "postgresql"
        },
        {
          "type": "external",
          "drivers": [
            "postgresql"
          ]
        }
      ],
      "datasource": {
        "INNGEST_POSTGRES_URI": "${url}"
      }
    },
    {
      "id": "redis",
      "providers": [
        {
          "type": "internal",
          "service": "redis",
          "driver": "redis"
        }
      ],
      "users": [],
      "datasource": {
        "INNGEST_REDIS_URI": "redis://${host}:${port}"
      }
    }
  ],
  "credentials": {},
  "env": {
    "first_startup_only": [],
    "secrets": [
      "INNGEST_EVENT_KEY",
      "INNGEST_SIGNING_KEY"
    ]
  },
  "help": {
    "db": ""
  }
}
