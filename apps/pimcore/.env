W9_REPO=pimcore/pimcore
W9_DIST=community
W9_VERSION=php8.5-v5
W9_POWER_PASSWORD="uQ8E1wVTzG8SOk3!"

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=pimcore
W9_HTTP_PORT=80
W9_HTTP_PORT_SET=9001
W9_DB_VERSION=10.11
W9_DB_EXPOSE=mariadb
W9_URL=pimcore.example.com
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# Pimcore image environment variables
# Docs: https://github.com/pimcore/docker/blob/5.x/README.md
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
PIMCORE_SKELETON_VERSION=v2026.3.0
PIMCORE_DB_HOST=${W9_ID}-mariadb
PIMCORE_DB_PORT=3306
PIMCORE_DB_NAME=pimcore
PIMCORE_DB_USER=pimcore
PIMCORE_DB_PASSWORD=${W9_POWER_PASSWORD}
PIMCORE_APP_ENV=prod

# Not used by default; enable only when needed:
# PIMCORE_INSTALL_ADMIN_USERNAME=admin
# PIMCORE_INSTALL_ADMIN_PASSWORD=${W9_POWER_PASSWORD}
# PIMCORE_INSTALL_PROFILE=App\Installer\SkeletonProfile
# PIMCORE_TRUSTED_PROXIES=
# PIMCORE_CORS_ALLOW_ORIGIN=
