{
  "name": "jellyfin",
  "access": [
    {
      "id": "web",
      "service": "jellyfin",
      "port": 8096,
      "public": true,
      "rootUrl": [
        "JELLYFIN_PublishedServerUrl"
      ],
      "endpoints": [
        {
          "roles": [
            "web"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "trademark": "Jellyfin",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "12.4",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "2",
    "memory": "8",
    "disk": "5"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/jellyfin/jellyfin"
  }
}
