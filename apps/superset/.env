# Allowing python to print() in docker
PYTHONUNBUFFERED=1
W9_REPO=apache/superset
W9_DIST=community
W9_VERSION=6.1.0
W9_POWER_PASSWORD=uQ8E1wVTzG8SOk3!

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=superset
W9_HTTP_PORT=8088
W9_HTTP_PORT_SET=9001
W9_DB_EXPOSE=postgresql
W9_DB_VERSION=15
W9_LOGIN_USER=admin
W9_LOGIN_PASSWORD=admin
W9_URL=appname.example.com
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# Superset image environment variables
# Docs: https://github.com/apache/superset/blob/6.1.0/docker/.env
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
COMPOSE_PROJECT_NAME=superset
DATABASE_DB=superset
DATABASE_HOST=${W9_ID}-postgresql
DATABASE_PASSWORD=${W9_POWER_PASSWORD}
DATABASE_USER=superset
DATABASE_PORT=5432
DATABASE_DIALECT=postgresql
POSTGRES_DB=${DATABASE_DB}
POSTGRES_USER=${DATABASE_USER}
POSTGRES_PASSWORD=${DATABASE_PASSWORD}
EXAMPLES_DB=examples
EXAMPLES_HOST=${W9_ID}-postgresql
EXAMPLES_USER=examples
EXAMPLES_PASSWORD=${W9_POWER_PASSWORD}
EXAMPLES_PORT=5432
PYTHONPATH=/app/pythonpath:/app/docker/pythonpath_dev
REDIS_HOST=${W9_ID}-cache
REDIS_PORT=6379
ADMIN_PASSWORD=${W9_LOGIN_PASSWORD}
SUPERSET_APP_ROOT=/
SUPERSET_ENV=production
SUPERSET_LOAD_EXAMPLES=yes
SUPERSET_SECRET_KEY=${W9_POWER_PASSWORD}-y3q8v5j8nn9q3g3ec2s6nkpz7nne3ru3
CYPRESS_CONFIG=false
SUPERSET_PORT=8088
MAPBOX_API_KEY=''

# Not used by default; enable only when needed:
# SUPERSET_LOG_LEVEL=info
# FLASK_DEBUG=true
# ENABLE_PLAYWRIGHT=false
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
# BUILD_SUPERSET_FRONTEND_IN_DOCKER=true
