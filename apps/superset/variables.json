{
  "name": "superset",
  "trademark": "Superset",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/apache/superset",
    "releases": "https://github.com/apache/superset/releases",
    "docs": [
      "https://superset.apache.org/docs/installation/installing-superset-using-docker-compose",
      "https://github.com/apache/superset/blob/6.1.0/UPDATING.md"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "6.1.0",
        "latest"
      ]
    }
  ],
  "access": {
    "web": {
      "port": 8088,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "8",
    "disk": "3"
  },
  "database": [
    {
      "id": "postgres",
      "providers": [
        {
          "type": "internal",
          "service": "db",
          "driver": "postgresql"
        },
        {
          "type": "external",
          "drivers": [
            "postgresql"
          ]
        }
      ],
      "name": [
        "${POSTGRES_DB}",
        "${EXAMPLES_DB}",
        "superset_cypress"
      ],
      "users": [
        {
          "user": "${POSTGRES_USER}",
          "password": "${POSTGRES_PASSWORD}",
          "usage": [
            "application",
            "initialization",
            "administration"
          ]
        },
        {
          "user": "${EXAMPLES_USER}",
          "password": "${EXAMPLES_PASSWORD}",
          "usage": [
            "application"
          ]
        }
      ],
      "datasource": {
        "DATABASE_HOST": "${host}",
        "DATABASE_PORT": "${port}",
        "DATABASE_DB": "${name}",
        "DATABASE_USER": "${users[*].user}",
        "DATABASE_PASSWORD": "${users[*].password}",
        "EXAMPLES_HOST": "${host}",
        "EXAMPLES_PORT": "${port}",
        "EXAMPLES_DB": "${name}",
        "EXAMPLES_USER": "${users[*].user}",
        "EXAMPLES_PASSWORD": "${users[*].password}"
      }
    },
    {
      "id": "redis",
      "providers": [
        {
          "type": "internal",
          "service": "redis",
          "driver": "redis"
        }
      ],
      "name": [
        "0",
        "1"
      ],
      "users": [],
      "datasource": {
        "REDIS_HOST": "${host}",
        "REDIS_PORT": "${port}"
      }
    }
  ],
  "credentials": {},
  "env": {
    "first_startup_only": [
      "W9_LOGIN_PASSWORD",
      "ADMIN_PASSWORD",
      "SUPERSET_SECRET_KEY"
    ]
  }
}