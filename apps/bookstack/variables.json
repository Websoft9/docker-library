{
  "name": "bookstack",
  "trademark": "BookStack",
  "release": true,
  "upstream": {
    "image": "https://github.com/linuxserver/docker-bookstack/pkgs/container/bookstack"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "25.02.2",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 80,
      "path": "/"
    },
    "admin": {
      "port": 80,
      "path": "/login"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "10"
  }
}
