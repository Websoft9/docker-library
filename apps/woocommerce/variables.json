{
  "name": "woocommerce",
  "access": [
    {
      "id": "web",
      "service": "woocommerce",
      "port": 80,
      "public": true,
      "rootUrl": [
        "WP_HOME",
        "WP_SITEURL"
      ],
      "endpoints": [
        {
          "roles": [
            "web"
          ],
          "scheme": "http",
          "path": "/"
        },
        {
          "roles": [
            "admin"
          ],
          "scheme": "http",
          "path": "/wp-admin/"
        }
      ]
    }
  ],
  "trademark": "WooCommerce",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/_/wordpress",
    "releases": "https://wordpress.org/news/category/releases/",
    "docs": [
      "https://github.com/woocommerce/woocommerce",
      "https://woocommerce.com/documentation/woocommerce/getting-started/",
      "https://woocommerce.com/document/server-requirements/"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "7.1",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "1"
  },
  "database": [
    {
      "id": "rds",
      "providers": [
        {
          "type": "internal",
          "service": "mysql",
          "driver": "mysql"
        },
        {
          "type": "external",
          "drivers": [
            "mysql",
            "mariadb"
          ]
        }
      ],
      "datasource": {
        "WORDPRESS_DB_HOST": "${host}:${port}",
        "WORDPRESS_DB_NAME": "${name}",
        "WORDPRESS_DB_USER": "${users[*].user}",
        "WORDPRESS_DB_PASSWORD": "${users[*].password}"
      }
    }
  ],
  "credentials": {},
  "env": {
    "first_startup_only": [
      "WOOCOMMERCE_VERSION"
    ]
  },
  "help": {
    "db": "WooCommerce requires WordPress 6.9+, PHP 8.3+, and MySQL 8.0+ or MariaDB 10.6+. This package bundles WordPress 7.1 and MySQL 8.4 for a single-node deployment."
  }
}
