{
  "name": "lobehub",
  "trademark": "LobeHub",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/lobehub/lobehub",
    "releases": "https://github.com/lobehub/lobehub/releases",
    "compose": {
      "compose": "https://raw.githubusercontent.com/lobehub/lobehub/canary/docker-compose/deploy/docker-compose.yml",
      "env": "https://raw.githubusercontent.com/lobehub/lobehub/canary/docker-compose/deploy/.env.example"
    },
    "docs": [
      "https://lobehub.com/docs/self-hosting/platform/docker-compose",
      "https://github.com/lobehub/lobehub"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "2.2.19",
        "latest"
      ]
    }
  ],
  "database": [
    {
      "id": "rds",
      "providers": [
        {
          "type": "internal",
          "service": "postgresql",
          "driver": "postgresql"
        },
        {
          "type": "external",
          "drivers": [
            "postgresql"
          ]
        }
      ],
      "datasource": {
        "DATABASE_URL": "postgresql://${users[*].user}:${users[*].password}@${host}:${port}/${name}"
      }
    },
    {
      "id": "redis",
      "providers": [
        {
          "type": "internal",
          "service": "redis",
          "driver": "redis"
        }
      ],
      "users": [],
      "datasource": {
        "REDIS_URL": "redis://${host}:${port}"
      }
    }
  ],
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "10"
  },
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 3210,
      "path": "/"
    }
  }
}