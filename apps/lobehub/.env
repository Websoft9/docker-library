W9_REPO=lobehub/lobehub
W9_DIST=community
W9_VERSION=2.2.17

W9_POWER_PASSWORD='l5QTjtAKGj16d!9t'

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=lobehub
W9_HTTP_PORT=3210
W9_HTTP_PORT_SET=9001
W9_DB_VERSION=pg17
W9_DB_EXPOSE=postgresql
W9_URL=appname.example.com
W9_URL_REPLACE=true
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# LobeHub image environment variables
# Docs: https://lobehub.com/docs/self-hosting/platform/docker-compose
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
APP_URL=http://${W9_URL}
INTERNAL_APP_URL=http://localhost:3210
KEY_VAULTS_SECRET='raGDCAeqFxazT6AbxYEUPEyfB-RIIRN5zyGlsFi2sm0'
AUTH_SECRET='dGTRXP7OQWyveeDIeyktI9cmPC69NRj9zHhrC0QV3zo'
LOBE_DB_NAME=lobechat
POSTGRES_PASSWORD=${W9_POWER_PASSWORD}
DATABASE_URL=postgresql://postgres:${W9_POWER_PASSWORD}@${W9_ID}-postgresql:5432/lobechat
REDIS_URL=redis://${W9_ID}-redis:6379
REDIS_PREFIX=lobechat
REDIS_TLS=0
S3_ENDPOINT=http://${W9_ID}-rustfs:9000
S3_BUCKET=lobe
S3_ENABLE_PATH_STYLE=1
S3_ACCESS_KEY=admin
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=${W9_POWER_PASSWORD}
S3_SET_ACL=0
LLM_VISION_IMAGE_USE_BASE64=1
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=${W9_POWER_PASSWORD}
RUSTFS_LOBE_BUCKET=lobe

# Not used by default; enable only when needed:
# OPENAI_API_KEY=
# OPENAI_PROXY_URL=
# OLLAMA_PROXY_URL=
# AUTH_ALLOWED_EMAILS=
