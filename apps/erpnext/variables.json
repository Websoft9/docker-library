{
  "name": "erpnext",
  "trademark": "ERPNext",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "v16"
      ]
    }
  ],
  "access": {
    "web": {
      "port": 8080,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "8",
    "disk": "1"
  },
  "database": [
    {
      "id": "mariadb",
      "providers": [
        {
          "type": "internal",
          "service": "mariadb",
          "driver": "mariadb"
        }
      ],
      "name": [],
      "users": [
        {
          "user": "root",
          "password": "${MYSQL_ROOT_PASSWORD}",
          "usage": [
            "initialization",
            "administration"
          ]
        }
      ]
    },
    {
      "id": "redis-cache",
      "providers": [
        {
          "type": "internal",
          "service": "redis-cache",
          "driver": "redis"
        }
      ],
      "users": []
    },
    {
      "id": "redis-queue",
      "providers": [
        {
          "type": "internal",
          "service": "redis-queue",
          "driver": "redis"
        }
      ],
      "users": []
    }
  ],
  "upstream": {
    "image": "https://hub.docker.com/r/frappe/erpnext",
    "docs": [
      "https://github.com/frappe/frappe_docker"
    ]
  },
  "env": {
    "first_startup_only": [
      "W9_LOGIN_PASSWORD",
      "W9_POWER_PASSWORD"
    ]
  },
  "help": {
    "db": "ERPNext requires MariaDB 10.6+ and Redis. This package bundles MariaDB 11.8 and Redis 6.2 for a single-node deployment and does not offer external databases. Metadata lists known internal services and the provisioning root account only; Frappe generates site databases and business accounts."
  }
}