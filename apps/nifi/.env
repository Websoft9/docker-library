W9_REPO=apache/nifi
W9_DIST=community
W9_VERSION=2.12.0

# Optional password seed: enabled because this package controls the initial NiFi single-user login.
W9_POWER_PASSWORD="1PrMxExC45LsCT"

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=nifi
W9_HTTPS_PORT=8443
W9_HTTPS_PORT_SET=9001
W9_LOGIN_USER=admin
W9_LOGIN_PASSWORD=${W9_POWER_PASSWORD}
W9_ADMIN_PATH=/nifi
W9_URL=appname.example.com
W9_URL_REPLACE=true
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# Apache NiFi image environment variables
# Docs: https://github.com/apache/nifi/tree/main/nifi-docker/dockerhub
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
# Follow the official Docker default secured mode: NiFi serves the UI over HTTPS here.
# This package is validated for HTTPS access and does not support switching the UI to plain HTTP.
NIFI_WEB_HTTPS_PORT=${W9_HTTPS_PORT}
SINGLE_USER_CREDENTIALS_USERNAME=${W9_LOGIN_USER}
SINGLE_USER_CREDENTIALS_PASSWORD=${W9_LOGIN_PASSWORD}
NIFI_JVM_HEAP_INIT=1g
NIFI_JVM_HEAP_MAX=1g
# NiFi validates Host/X-ProxyHost values in secure mode.
# Do not use 0.0.0.0 here: set the real public hostname, and add hostname:port when direct HTTPS port access is needed.
NIFI_WEB_PROXY_HOST=${W9_URL},${W9_URL}:${W9_HTTPS_PORT_SET}
NIFI_WEB_PROXY_CONTEXT_PATH=/nifi

# Not used by default; enable only when needed:
# NIFI_WEB_HTTPS_HOST=${W9_URL}
# Keep HTTP disabled in this package. Enabling NIFI_WEB_HTTP_* requires redesigning the package and re-validating proxy behavior.
# NIFI_WEB_HTTP_HOST=0.0.0.0
# NIFI_WEB_HTTP_PORT=8080
