{
  "name": "killbill",
  "trademark": "Kill Bill",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "0.24.13",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
