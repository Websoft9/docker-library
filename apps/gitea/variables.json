{
  "name": "gitea",
  "trademark": "Gitea",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/gitea/gitea",
    "releases": "https://github.com/go-gitea/gitea/releases",
    "docs": [
      "https://docs.gitea.com/installation/install-with-docker",
      "https://docs.gitea.com/administration/config-cheat-sheet"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "28.2",
        "latest"
      ]
    }
  ],
  "access": [
    {
      "id": "web",
      "service": "gitea",
      "port": 3000,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "web"
          ],
          "scheme": "http",
          "path": "/"
        },
        {
          "roles": [
            "admin"
          ],
          "scheme": "http",
          "path": "/-/admin"
        },
        {
          "roles": [
            "api"
          ],
          "scheme": "http",
          "path": "/api/v1"
        }
      ]
    },
    {
      "id": "ssh",
      "service": "gitea",
      "port": 22,
      "public": true,
      "mappedPort": [
        "SSH_PORT"
      ],
      "endpoints": [
        {
          "roles": [
            "ssh"
          ],
          "scheme": "ssh"
        }
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "4"
  }
}
