W9_REPO=chatwoot/chatwoot
W9_DIST=community
W9_VERSION=v4.18.0
W9_POWER_PASSWORD='r!1lw!J4dGLXFYzy'

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####
W9_ID=chatwoot

W9_HTTP_PORT=3000
W9_HTTP_PORT_SET=9007

W9_DB_EXPOSE=postgresql
W9_DB_VERSION=16
W9_URL=chatwoot.example.com
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# Chatwoot image environment variables
# Docs: https://www.chatwoot.com/docs/self-hosted/configuration/environment-variables
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:

REDIS_URL=redis://${W9_ID}-redis:6379
POSTGRES_HOST=${W9_ID}-postgresql
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=${W9_POWER_PASSWORD}
POSTGRES_DATABASE=chatwoot

# Used to verify the integrity of signed cookies. so ensure a secure value is set otherwise application can not start
SECRET_KEY_BASE=MxExC45Ls-783tsrs-${W9_POWER_PASSWORD}

# Not used by default; enable only when needed:
