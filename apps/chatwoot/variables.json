{
  "name": "chatwoot",
  "trademark": "Chatwoot",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/chatwoot/chatwoot"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "v4.8.0",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 3000,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "1"
  }
}
