{
  "name": "chatwoot",
  "trademark": "Chatwoot",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/chatwoot/chatwoot",
    "releases": "https://github.com/chatwoot/chatwoot/releases",
    "docs": [
      "https://www.chatwoot.com/docs/self-hosted/deployment/docker",
      "https://www.chatwoot.com/docs/self-hosted/configuration/environment-variables"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "v4.19.1",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 3000,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "1"
  },
  "database": [
    {
      "id": "postgres",
      "providers": [
        {
          "type": "internal",
          "service": "postgres",
          "driver": "postgresql"
        },
        {
          "type": "external",
          "drivers": [
            "postgresql"
          ]
        }
      ],
      "datasource": {
        "POSTGRES_HOST": "${host}",
        "POSTGRES_DATABASE": "${name}",
        "POSTGRES_USERNAME": "${users[*].user}",
        "POSTGRES_PASSWORD": "${users[*].password}"
      }
    },
    {
      "id": "redis",
      "providers": [
        {
          "type": "internal",
          "service": "redis",
          "driver": "redis"
        }
      ],
      "users": [],
      "datasource": {
        "REDIS_URL": "redis://${host}:${port}"
      }
    }
  ],
  "credentials": {},
  "env": {
    "secrets": [
      "SECRET_KEY_BASE"
    ]
  },
  "help": {
    "login": "First run: open the site and create the administrator account in the Chatwoot setup flow, then sign in with those credentials.",
    "db": "After each image upgrade, run `docker compose run --rm rails bundle exec rails db:chatwoot_prepare` before or immediately after restarting the stack so Chatwoot applies the required database migrations."
  }
}