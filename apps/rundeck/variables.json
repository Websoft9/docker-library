{
  "name": "rundeck",
  "access": [
    {
      "id": "web",
      "service": "rundeck",
      "port": 4440,
      "public": true,
      "rootUrl": [
        "RUNDECK_GRAILS_URL"
      ],
      "endpoints": [
        {
          "roles": [
            "web"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "trademark": "Rundeck",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/rundeck/rundeck",
    "releases": "https://github.com/rundeck/rundeck/releases",
    "docs": [
      "https://docs.rundeck.com/docs/administration/install/docker.html",
      "https://docs.rundeck.com/docs/administration/configuration/docker.html"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "6.2.1",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "4"
  },
  "credentials": {
    "username": {
      "source": "inline",
      "value": "admin"
    },
    "password": {
      "source": "container-env",
      "name": "W9_LOGIN_PASSWORD"
    }
  }
}
