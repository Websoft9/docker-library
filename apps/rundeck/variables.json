{
  "name": "rundeck",
  "trademark": "Rundeck",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "5.17.0"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 4440,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "4"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/rundeck/rundeck"
  }
}
