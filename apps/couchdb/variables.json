{
  "name": "couchdb",
  "trademark": "CouchDB",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/_/couchdb"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "3.5.0",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 5984,
      "path": "/"
    },
    "admin": {
      "port": 5984,
      "path": "/_utils"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "4"
  }
}
