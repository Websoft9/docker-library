{
  "name": "couchdb",
  "access": [
    {
      "id": "admin",
      "service": "couchdb",
      "port": 5984,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "admin"
          ],
          "scheme": "http",
          "path": "/_utils/"
        },
        {
          "roles": [
            "db"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "trademark": "CouchDB",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/_/couchdb",
    "releases": "https://github.com/apache/couchdb",
    "docs": [
      "https://docs.couchdb.org/en/stable/install/docker.html",
      "https://github.com/apache/couchdb-docker"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "3.5",
        "3.4",
        "3.3",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "4"
  }
}
