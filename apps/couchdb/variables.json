{
  "name": "couchdb",
  "trademark": "CouchDB",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/_/couchdb",
    "releases": "https://github.com/apache/couchdb",
    "docs": [
      "https://docs.couchdb.org/en/stable/install/docker.html",
      "https://github.com/apache/couchdb-docker"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "3.5",
        "3.4",
        "3.3",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 5984,
      "path": "/"
    },
    "admin": {
      "port": 5984,
      "path": "/_utils"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "4"
  }
}
