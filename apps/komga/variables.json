{
  "name": "komga",
  "trademark": "Komga",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "1.23.1",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 25600,
      "path": "/"
    }
