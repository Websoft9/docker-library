{
  "name": "caddy",
  "trademark": "Caddy",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "2.11",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "2"
  },
  "upstream": {
    "image": "https://hub.docker.com/_/caddy",
    "releases": "https://github.com/caddyserver/caddy/releases",
    "docs": [
      "https://github.com/caddyserver/caddy/releases/tag/v2.11.7",
      "https://hub.docker.com/_/caddy"
    ]
  },
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 80,
      "path": "/"
    }
  }
}
