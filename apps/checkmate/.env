W9_REPO=ghcr.io/bluewave-labs/checkmate
W9_DIST=community
W9_VERSION=v3.12.0

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=checkmate
W9_HTTP_PORT=52345
W9_HTTP_PORT_SET=9001

# Dependency helpers: bundled MongoDB stores Checkmate data.
W9_DB_EXPOSE=mongodb
W9_DB_VERSION=8.2

W9_URL=example.youdomain.com
W9_URL_REPLACE=true

W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# Checkmate image environment variables
# Docs: https://github.com/bluewave-labs/checkmate
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
DB_CONNECTION_STRING=mongodb://${W9_ID}-mongodb:27017/uptime_db?replicaSet=rs0
CLIENT_HOST=http://${W9_URL}
JWT_SECRET=8f083625e5719ef100f19b0fa780574d62491e7af845e4a221f4705604949704

# Not used by default; enable only when needed:
# ENCRYPTION_KEY=
# TOKEN_TTL=99d
# ORIGIN=
# LOG_LEVEL=info
# STATUS_PAGE_THEMES_ENABLED=true
