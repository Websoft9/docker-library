{
  "name": "couchbase",
  "trademark": "Couchbase",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "8.0.3"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8091,
      "path": "/"
    }
  },
  "credentials": {},
  "env": {
    "first_startup_only": []
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "8"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/couchbase/server",
    "docs": [
      "https://docs.couchbase.com/server/current/release-notes/relnotes.html",
      "https://docs.couchbase.com/server/current/install/getting-started-docker.html",
      "https://docs.couchbase.com/server/current/install/pre-install.html"
    ]
  }
}
