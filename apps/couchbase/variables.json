{
  "name": "couchbase",
  "trademark": "Couchbase",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "community-7.6.2",
        "community"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8091,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "8"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/couchbase/server"
  }
}
