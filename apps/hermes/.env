W9_REPO=nousresearch/hermes-agent
W9_DIST=community
W9_VERSION=v2026.9.14

# Optional password seed: enable only when the package actually controls a DB or built-in login.
# See docs/w9-env-spec.md for when W9_POWER_PASSWORD is appropriate.
W9_POWER_PASSWORD="ZYYNMaGSmnmbohoBsJ9S"

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=hermes

# Web/internal ports: uncomment the ones the package actually uses.
W9_HTTP_PORT=9119
W9_HTTP_PORT_SET=9001
W9_API_PORT=8642
W9_API_PORT_SET=9002

# Built-in login and URL helpers: keep these in the protected block because the appstore parser
# reads them from the app package metadata surface.
W9_LOGIN_USER=admin
W9_LOGIN_PASSWORD=${W9_POWER_PASSWORD}
# Use a domain-style placeholder for W9_URL, e.g. appname.example.com or example.youdomain.com.
# Do NOT use internet_ip:${W9_HTTP_PORT_SET}; host substitution is the consumer's concern.
W9_URL=appname.example.com
W9_ADMIN_PATH=""

W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

#W9_NAME=""
#W9_RCODE=""

# ============================================================
# Hermes Agent image environment variables
# Docs: https://hermes-agent.nousresearch.com/docs/user-guide/docker
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=${W9_LOGIN_USER}
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=${W9_LOGIN_PASSWORD}
HERMES_DASHBOARD_BASIC_AUTH_SECRET=${W9_POWER_PASSWORD}
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
API_SERVER_KEY=${W9_POWER_PASSWORD}

# Not used by default; enable only when needed:
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# TELEGRAM_BOT_TOKEN=
# GITHUB_TOKEN=
