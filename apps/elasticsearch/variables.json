{
  "name": "elasticsearch",
  "access": [
    {
      "id": "db",
      "service": "elasticsearch",
      "port": 9200,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "db"
          ],
          "scheme": "https",
          "path": "/"
        }
      ]
    }
  ],
  "trademark": "Elasticsearch",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "9.5.5"
      ]
    }
  ],
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "8"
  },
  "upstream": {
    "image": "https://hub.docker.com/_/elasticsearch"
  }
}
