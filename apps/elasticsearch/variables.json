{
  "name": "elasticsearch",
  "trademark": "Elasticsearch",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "9.1.0"
      ]
    }
  ],
  "access": {
    "defaultScheme": "https",
    "api": {
      "port": 9200,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "8"
  },
  "upstream": {
    "image": "https://hub.docker.com/_/elasticsearch"
  }
}
