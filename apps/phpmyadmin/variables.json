{
  "name": "phpmyadmin",
  "trademark": "phpMyAdmin",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "5.2",
        "latest"
      ]
    }
  ],
  "access": {
    "web": {
      "port": 80,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "1"
  },
  "database": [
    {
      "id": "mariadb",
      "providers": [
        {
          "type": "internal",
          "service": "db",
          "driver": "mariadb"
        }
      ],
      "name": [],
      "users": [
        {
          "user": "root",
          "password": "${MYSQL_ROOT_PASSWORD}",
          "usage": [
            "administration"
          ]
        }
      ],
      "datasource": {
        "PMA_HOST": "${host}",
        "PMA_PORT": "${port}"
      }
    }
  ],
  "upstream": {
    "image": "https://hub.docker.com/_/phpmyadmin",
    "docs": [
      "https://github.com/phpmyadmin/docker"
    ]
  }
}