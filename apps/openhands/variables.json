{
  "name": "openhands",
  "trademark": "OpenHands",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "0.28"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 3000,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "10"
  },
  "upstream": {
    "image": "https://github.com/All-Hands-AI/OpenHands/pkgs/container/openhands"
  }
}
