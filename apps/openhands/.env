W9_REPO=ghcr.io/openhands/agent-canvas
W9_DIST=community
W9_VERSION=1.26.0

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=openhands
W9_HTTP_PORT_SET=9001
W9_HTTP_PORT=8000
W9_URL=example.youdomain.com
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# OpenHands image environment variables
# Docs: https://docs.openhands.dev/openhands/usage/agent-canvas/backend-setup/docker
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
PORT=${W9_HTTP_PORT}
# Declared in variables.json `env.secrets`. The value below is a plain-text shape default;
# the platform may regenerate a same-shaped value and overwrite it on this instance.
# Backend API key the Canvas UI asks for on the login screen.
LOCAL_BACKEND_API_KEY=Kx7Qm2TpR9wZb4HnV1sLc6Dg0Fj3YaQd
# Encryption key for stored settings and secrets; keep it stable so saved secrets stay decryptable.
OH_SECRET_KEY=Pv5Rt8Wy2Nk7Mc4Xb1Lz6Df0Gh3Jq9Ue
AGENT_CANVAS_DISABLE_TELEMETRY=true

# Not used by default; enable only when needed:
# AGENT_CANVAS_ALLOW_LAN_SESSION_KEY=true
# OH_BIND_HOST=0.0.0.0
# OH_CONVERSATION_RUNTIME=docker
# OH_DISABLE_AUTOMATIONS=false
# LOG_LEVEL=info
