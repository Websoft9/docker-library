{
  "name": "rancher",
  "trademark": "Rancher",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/rancher/rancher"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "https",
    "web": {
      "port": 443,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "1"
  },
  "credentials": {
    "password": {
      "source": "container-log",
      "match": "regex",
      "pattern": "Bootstrap Password:\\s*(.+)",
      "group": 1
    }
  }
}
