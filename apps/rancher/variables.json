{
  "name": "rancher",
  "trademark": "Rancher",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "1"
  },
  "credentials": {
    "password": {
      "source": "container-log",
      "pattern": "Bootstrap Password:"
    }
  },
  "upstream": {
    "image": "https://hub.docker.com/r/rancher/rancher"
  }
}
