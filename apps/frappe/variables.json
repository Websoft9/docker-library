{
  "name": "frappe",
  "trademark": "Frappe",
  "release": false,
  "edition": [
    {
      "dist": "community",
      "version": [
        "v14",
        "v13"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8000,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "8",
    "disk": "1"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/frappe/bench"
  }
}
