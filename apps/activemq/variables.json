{
  "name": "activemq",
  "access": [
    {
      "id": "admin",
      "service": "activemq",
      "port": 8161,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "admin"
          ],
          "scheme": "http",
          "path": "/admin/"
        }
      ]
    },
    {
      "id": "amqp",
      "service": "activemq",
      "port": 5672,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "mq"
          ],
          "scheme": "amqp"
        }
      ]
    },
    {
      "id": "openwire",
      "service": "activemq",
      "port": 61616,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "mq"
          ],
          "scheme": "openwire"
        }
      ]
    },
    {
      "id": "stomp",
      "service": "activemq",
      "port": 61613,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "mq"
          ],
          "scheme": "stomp"
        }
      ]
    }
  ],
  "trademark": "ActiveMQ",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/apache/activemq",
    "releases": "https://github.com/apache/activemq/releases",
    "docs": [
      "https://github.com/apache/activemq/tree/main/assembly/src/docker"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "6.3.2",
        "5.19.11",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "4"
  }
}
