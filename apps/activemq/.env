W9_REPO=apache/activemq
W9_DIST=community
W9_VERSION=6.3.0

W9_POWER_PASSWORD=8dHZPFLFGoPXuC

# Environments which for user settings when create application
W9_HTTP_PORT_SET=8161
W9_AMQP_PORT_SET=5672
W9_OPENWIRE_PORT_SET=61616
W9_STOMP_PORT_SET=61613

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=activemq

W9_LOGIN_USER=admin
W9_LOGIN_PASSWORD=$W9_POWER_PASSWORD
W9_ADMIN_PATH="/admin"

W9_URL=appname.example.com
W9_NETWORK=websoft9

#### --------------------------------------------------------------------------------------- ####

# ============================================================
# ActiveMQ image environment variables
# Docs: https://hub.docker.com/r/apache/activemq
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml (Web Console + transport connection auth):
ACTIVEMQ_WEB_USER=$W9_LOGIN_USER
ACTIVEMQ_WEB_PASSWORD=$W9_LOGIN_PASSWORD
ACTIVEMQ_CONNECTION_USER=$W9_LOGIN_USER
ACTIVEMQ_CONNECTION_PASSWORD=$W9_LOGIN_PASSWORD

# Not used by default; enable only when needed:
# ACTIVEMQ_JMX_USER=admin
# ACTIVEMQ_JMX_PASSWORD=$W9_POWER_PASSWORD
