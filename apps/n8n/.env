W9_REPO=n8nio/n8n
W9_DIST=community
W9_VERSION=2.38.4
W9_POWER_PASSWORD="bk!ctOA2xJ2ur0AB"

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=n8n
W9_HTTP_PORT=5678
W9_HTTP_PORT_SET=9001
W9_URL=internet_ip:${W9_HTTP_PORT_SET}
W9_URL_REPLACE=true
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# n8n image environment variables
# Docs: https://docs.n8n.io/deploy/host-n8n/configure-n8n/basic-configuration/use-environment-variables/
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
N8N_EDITOR_BASE_URL=http://${W9_URL}
N8N_WEBHOOK_URL=http://${W9_URL}
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=false
N8N_UNVERIFIED_PACKAGES_ENABLED=true
N8N_RUNNERS_TASK_TIMEOUT=300
N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES=2147483648
N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES=5000
GENERIC_TIMEZONE=America/New_York
TZ=America/New_York

# Not used by default; enable only when needed:
# N8N_ENCRYPTION_KEY=
