# InfluxDB 3 Core installation overrides.
# This file is merged into the base .env only when the 3-core version is selected.
# It is an installation template and is not retained in the deployed application.

# InfluxDB 3 Core image tag.
W9_VERSION=3-core

# InfluxDB 3 Core HTTP API port (internal).
W9_HTTP_PORT=8181
