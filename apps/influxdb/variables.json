{
  "name": "influxdb",
  "access": [
    {
      "id": "web",
      "service": "influxdb",
      "port": 8086,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "dashboard"
          ],
          "scheme": "http",
          "path": "/"
        },
        {
          "roles": [
            "db"
          ],
          "scheme": "http",
          "path": "/api/v2/"
        }
      ]
    }
  ],
  "trademark": "InfluxDB",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/_/influxdb",
    "releases": "https://github.com/influxdata/influxdb/releases",
    "docs": [
      "https://docs.influxdata.com/influxdb/v2/install/",
      "https://docs.influxdata.com/influxdb/v2/reference/",
      "https://docs.influxdata.com/influxdb/v2/admin/",
      "https://docs.influxdata.com/influxdb3/core/install/",
      "https://docs.influxdata.com/influxdb3/core/get-started/"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "2.9",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "1"
  }
}
