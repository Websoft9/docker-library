{
  "name": "neo4j",
  "trademark": "Neo4j",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "2026.07",
        "2026.07-enterprise",
        "5.26",
        "5.26-enterprise"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "1"
  },
  "upstream": {
    "image": "https://hub.docker.com/_/neo4j",
    "releases": "https://neo4j.com/release-notes/database/",
    "docs": [
      "https://neo4j.com/docs/operations-manual/current/docker/introduction/",
      "https://neo4j.com/release-notes/database/neo4j-2026-07-1/"
    ]
  },
  "env": {
    "first_startup_only": [
      "W9_LOGIN_PASSWORD",
      "NEO4J_AUTH"
    ]
  }
}
