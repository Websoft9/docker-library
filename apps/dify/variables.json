{
  "name": "dify",
  "trademark": "Dify",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "1.9.2",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 80,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "9"
  },
  "database": [
    {
      "id": "postgres",
      "providers": [
        {
          "type": "internal",
          "service": "db",
          "driver": "postgresql"
        }
      ],
      "name": [
        "${POSTGRES_DB}",
        "${DB_PLUGIN_DATABASE}"
      ],
      "users": [
        {
          "user": "postgres",
          "password": "${POSTGRES_PASSWORD}"
        }
      ]
    },
    {
      "id": "redis",
      "providers": [
        {
          "type": "internal",
          "service": "redis",
          "driver": "redis"
        }
      ],
      "name": [
        "0",
        "1"
      ]
    },
    {
      "id": "weaviate",
      "providers": [
        {
          "type": "internal",
          "service": "weaviate",
          "driver": "weaviate"
        }
      ]
    }
  ],
  "upstream": {
    "image": "https://hub.docker.com/r/langgenius/dify-api"
  },
  "env": {
    "secrets": [
      {
        "SECRET_KEY": "base64"
      },
      {
        "PLUGIN_DAEMON_KEY": "base64"
      },
      {
        "PLUGIN_DIFY_INNER_API_KEY": "base64"
      },
      "WEAVIATE_API_KEY"
    ]
  }
}