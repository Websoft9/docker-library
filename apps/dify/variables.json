{
  "name": "dify",
  "trademark": "Dify",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "1.9.2",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 80,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "9"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/langgenius/dify-api"
  }
}
