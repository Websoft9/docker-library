{
  "name": "mautic",
  "trademark": "Mautic",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "6-apache"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 80,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "4"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/mautic/mautic"
  }
}
