# Two methods to create a SHA-256 hash of the Graylog root password:
# 1. echo -n 'password' | sha256sum | awk '{ print $1 }'
# 2. echo -n "Enter Password: " && head -1 </dev/stdin | tr -d '\n' | sha256sum | cut -d" " -f1
W9_REPO=graylog/graylog
W9_DIST=community
W9_VERSION=7.1
W9_POWER_PASSWORD="w!ZHVAClNkJ0AGuw"

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=graylog

W9_HTTP_PORT=9000
W9_HTTP_PORT_SET=9001
W9_BEATS_TCP_PORT_SET=5044
W9_SYSLOG_TCP_PORT_SET=5140
W9_SYSLOG_UDP_PORT_SET=5140
W9_GELF_TCP_PORT_SET=12201
W9_GELF_UDP_PORT_SET=12201
W9_RAW_TCP_PORT_SET=5555
W9_RAW_UDP_PORT_SET=5555
W9_FORWARDER_DATA_TCP_PORT_SET=13301
W9_FORWARDER_CONFIG_TCP_PORT_SET=13302

W9_DB_EXPOSE=mongodb
# Keep MongoDB on 7.0: MongoDB 8.0.x exits during startup on Linux kernel 6.19-7.0.13
# (MongoDB SERVER-121912 / SERVER-125742). Graylog 7.1 supports MongoDB 7.x-8.0.x.
W9_DB_VERSION=7.0

# Steady-state login after the one-time initialization. This must match the plaintext
# behind GRAYLOG_ROOT_PASSWORD_SHA2 (the default hash is for "admin").
W9_LOGIN_USER=admin
W9_LOGIN_PASSWORD=admin

W9_URL=appname.example.com
W9_URL_REPLACE=true

W9_NETWORK=websoft9
#### --------------------------------------------------------------------------------------- ####

# ============================================================
# Graylog image environment variables
# Docs: https://go2docs.graylog.org/current/downloading_and_installing_graylog/docker_installation.htm
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# ============================================================

# Used by docker-compose.yml:

# Must be at least 16 characters.
GRAYLOG_PASSWORD_SECRET=${W9_POWER_PASSWORD}
# Default hash is for the password "admin".
GRAYLOG_ROOT_PASSWORD_SHA2=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918
GRAYLOG_MONGODB_URI=mongodb://${W9_ID}-mongodb:27017/graylog
GRAYLOG_HTTP_EXTERNAL_URI=http://${W9_URL}/

# Not used by default; enable only when needed:
# GRAYLOG_HTTP_PUBLISH_URI=http://${W9_URL}/
# GRAYLOG_REPORT_DISABLE_SANDBOX=true
