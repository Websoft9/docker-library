{
  "name": "meilisearch",
  "access": [
    {
      "id": "api",
      "service": "meilisearch",
      "port": 7700,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "api"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "trademark": "Meilisearch",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "v1.16",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "8"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/getmeili/meilisearch"
  }
}
