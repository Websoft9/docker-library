{
  "name": "mixpost",
  "trademark": "Mixpost",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "v2.4.0",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 80,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "10"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/inovector/mixpost"
  }
}
