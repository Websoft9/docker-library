{
  "name": "airflow",
  "trademark": "Airflow",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/apache/airflow",
    "releases": "https://github.com/apache/airflow",
    "docs": [
      "https://airflow.apache.org/docs/apache-airflow/stable/howto/docker-compose/index.html",
      "https://github.com/apache/airflow"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "3.3.2",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8080,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "10"
  },
  "database": [
    {
      "id": "postgres",
      "providers": [
        {
          "type": "internal",
          "service": "postgres",
          "driver": "postgresql"
        },
        {
          "type": "external",
          "drivers": [
            "postgresql"
          ]
        }
      ],
      "datasource": {
        "AIRFLOW__DATABASE__SQL_ALCHEMY_CONN": "postgresql+psycopg2://${users[*].user}:${users[*].password}@${host}:${port}/${name}",
        "AIRFLOW__CELERY__RESULT_BACKEND": "db+postgresql://${users[*].user}:${users[*].password}@${host}:${port}/${name}"
      }
    },
    {
      "id": "redis",
      "providers": [
        {
          "type": "internal",
          "service": "redis",
          "driver": "redis"
        }
      ],
      "name": [
        "0"
      ],
      "users": []
    }
  ],
  "env": {
    "secrets": [
      {
        "AIRFLOW__CORE__FERNET_KEY": "fernet"
      }
    ]
  }
}