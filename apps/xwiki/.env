W9_REPO=xwiki
W9_DIST=community
W9_VERSION=18.7

W9_POWER_PASSWORD="fNoyaf5!dgkPBx0E"

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=xwiki

# Web/internal ports
W9_HTTP_PORT=8080
W9_HTTP_PORT_SET=9004

# URL helper
W9_URL=appname.example.com

# Bundled database
W9_DB_EXPOSE="mysql"
W9_DB_VERSION=8.4

W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# XWiki image environment variables
# Docs: https://github.com/xwiki/xwiki-docker
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:

DB_USER=xwiki
DB_DATABASE=xwiki
DB_PASSWORD=${W9_POWER_PASSWORD}
DB_HOST=${W9_ID}-mysql

# Not used by default; enable only when needed:
# XWIKI_VERSION=18.7.0
# DB_USE_SSL=true
# JDBC_PARAMS=useSSL=false
# XWIKI_MEMORY=2048
