{
  "name": "consul",
  "trademark": "Consul",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/hashicorp/consul",
    "releases": "https://github.com/hashicorp/consul/releases",
    "docs": [
      "https://developer.hashicorp.com/consul/docs/release-notes",
      "https://developer.hashicorp.com/consul/docs/install/docker"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "2.0.4",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8500,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "10"
  }
}
