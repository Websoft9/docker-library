{
  "name": "consul",
  "trademark": "Consul",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/hashicorp/consul"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "1.22",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8500,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "10"
  }
}
