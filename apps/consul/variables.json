{
  "name": "consul",
  "access": [
    {
      "id": "web",
      "service": "consul-server",
      "port": 8500,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "dashboard"
          ],
          "scheme": "http",
          "path": "/ui/"
        },
        {
          "roles": [
            "api"
          ],
          "scheme": "http",
          "path": "/v1/"
        }
      ]
    }
  ],
  "trademark": "Consul",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/hashicorp/consul",
    "releases": "https://github.com/hashicorp/consul/releases",
    "docs": [
      "https://developer.hashicorp.com/consul/docs/release-notes",
      "https://developer.hashicorp.com/consul/docs/install/docker"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "2.1",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "10"
  }
}
