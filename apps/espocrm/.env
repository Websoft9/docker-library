W9_REPO=espocrm
W9_DIST=community
W9_VERSION=10.0
W9_POWER_PASSWORD='QnMU9I!XW8pQovRV'

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=espocrm
W9_HTTP_PORT=80
W9_HTTP_PORT_SET=9001
W9_LOGIN_USER=admin
W9_LOGIN_PASSWORD=${W9_POWER_PASSWORD}
W9_DB_EXPOSE=mariadb
W9_DB_VERSION=10.6
W9_URL=example.youdomain.com
W9_URL_REPLACE=true
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

#W9_NAME=""
#W9_RCODE=""

# ============================================================
# EspoCRM image environment variables
# Docs: https://hub.docker.com/_/espocrm
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:

MARIADB_DATABASE=espocrm
MARIADB_USER=espocrm
MARIADB_PASSWORD=${W9_POWER_PASSWORD}
MARIADB_ROOT_PASSWORD=${W9_POWER_PASSWORD}
ESPOCRM_DATABASE_HOST=${W9_ID}-mariadb
ESPOCRM_DATABASE_USER=espocrm
ESPOCRM_DATABASE_PASSWORD=${W9_POWER_PASSWORD}
ESPOCRM_DATABASE_NAME=espocrm
ESPOCRM_ADMIN_USERNAME=${W9_LOGIN_USER}
ESPOCRM_ADMIN_PASSWORD=${W9_POWER_PASSWORD}
ESPOCRM_SITE_URL=http://${W9_URL}

# Not used by default; enable only when needed:
# ESPOCRM_CONFIG_USE_CACHE=
# ESPOCRM_CONFIG_USE_CRON=
# ESPOCRM_CONFIG_DEFAULT_LANGUAGE=
# ESPOCRM_CONFIG_TIME_ZONE=
# ESPOCRM_CONFIG_DATE_FORMAT=
