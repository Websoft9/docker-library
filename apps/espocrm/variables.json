{
  "name": "espocrm",
  "trademark": "EspoCRM",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "10.0",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "8"
  },
  "env": {
    "first_startup_only": [
      "ESPOCRM_ADMIN_USERNAME",
      "ESPOCRM_ADMIN_PASSWORD",
      "ESPOCRM_SITE_URL"
    ]
  },
  "upstream": {
    "image": "https://hub.docker.com/_/espocrm",
    "releases": "https://github.com/espocrm/espocrm/releases",
    "docs": [
      "https://docs.espocrm.com/administration/docker/installation/#install-espocrm-with-docker-compose"
    ]
  },
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 80,
      "path": "/"
    }
  }
}
