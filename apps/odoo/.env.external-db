# External database installation overrides.
# This file is merged into the base .env only when the external-db profile is selected.
# It is an installation template and is not retained in the deployed application.

# Marks this application as using an external database.
W9_DATABASE_MODE=external

# Comma-separated bundled Compose services removed during external-db installation.
# Odoo removes its bundled PostgreSQL service.
W9_COMPOSE_EXCLUDE_SERVICES=postgresql

# External database connection values.
# These values are provided by the installation form and retained for application details.
W9_DB_HOST_SET=
W9_DB_PORT_SET=5432
W9_DB_USER_SET=
W9_DB_PASSWORD_SET=

# Odoo runtime database configuration.
HOST=$W9_DB_HOST_SET
PORT=$W9_DB_PORT_SET
USER=$W9_DB_USER_SET
PASSWORD=$W9_DB_PASSWORD_SET