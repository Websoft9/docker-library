{
  "name": "odoo",
  "trademark": "Odoo",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/_/odoo",
    "releases": "https://www.odoo.com/documentation/master/administration/supported_versions.html",
    "docs": [
      "https://github.com/odoo/docker",
      "https://www.odoo.com/documentation/master/administration/on_premise/deploy.html",
      "https://www.odoo.com/documentation/master/administration/install.html",
      "https://www.odoo.com/odoo-19-release-notes"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "19.0",
        "18.0",
        "17.0",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "1"
  },
  "help": {
    "db": "Odoo 17-19 requires PostgreSQL. This package bundles PostgreSQL 15 for single-node deployments and keeps the external-db installation override for an external PostgreSQL service."
  }
}
