W9_REPO=python
W9_DIST=community
W9_VERSION=5.2.17

W9_POWER_PASSWORD='gAkR53faNJ0W6!C0'

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=django
W9_HTTP_PORT=8000
W9_HTTP_PORT_SET=9001
W9_DB_VERSION=17
W9_DB_EXPOSE=postgresql
W9_LOGIN_USER=admin
W9_LOGIN_PASSWORD=${W9_POWER_PASSWORD}
W9_URL=internet_ip:${W9_HTTP_PORT_SET}
W9_URL_REPLACE=true
W9_ADMIN_PATH=/admin
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# Django application environment variables
# Docs: https://docs.djangoproject.com/en/5.2/howto/deployment/
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# These container variables are read by the generated settings.py override.
# ============================================================

# Used by docker-compose.yml:
DJANGO_SETTINGS_MODULE=project.settings
DJANGO_SUPERUSER_USERNAME=${W9_LOGIN_USER}
DJANGO_SUPERUSER_PASSWORD=${W9_LOGIN_PASSWORD}
DJANGO_SUPERUSER_EMAIL=admin@example.com
SECRET_KEY=${W9_POWER_PASSWORD}
DEBUG=false
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://${W9_URL}
GUNICORN_WORKERS=3
DB_HOST=${W9_ID}-postgresql
DB_PORT=5432
DB_NAME=django
DB_USER=django
DB_PASSWORD=${W9_POWER_PASSWORD}

