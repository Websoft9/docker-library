{
  "name": "django",
  "access": [
    {
      "id": "admin",
      "service": "django",
      "port": 8000,
      "public": true,
      "rootUrl": [
        "CSRF_TRUSTED_ORIGINS"
      ],
      "endpoints": [
        {
          "roles": [
            "admin"
          ],
          "scheme": "http",
          "path": "/admin/"
        }
      ]
    }
  ],
  "trademark": "Django",
  "release": true,
  "upstream": {
    "image": "https://github.com/django/django",
    "releases": "https://github.com/django/django/releases",
    "docs": [
      "https://docs.djangoproject.com/",
      "https://docs.djangoproject.com/en/5.2/howto/deployment/",
      "https://docs.djangoproject.com/en/5.2/howto/deployment/wsgi/gunicorn/"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "6.1.1",
        "5.2.17",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "2",
    "memory": "2",
    "disk": "5"
  },
  "database": [
    {
      "id": "rds",
      "providers": [
        {
          "type": "external",
          "drivers": [
            "postgresql",
            "mysql",
            "mariadb"
          ]
        }
      ],
      "datasource": {
        "DATABASE_URL": "${url}"
      }
    }
  ],
  "env": {
    "secrets": [
      "SECRET_KEY"
    ]
  },
  "help": {
    "db": "No database by default (SQLite). Uncomment DATABASE_URL in .env to use an external PostgreSQL or MySQL database."
  }
}
