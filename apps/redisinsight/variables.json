{
  "name": "redisinsight",
  "trademark": "RedisInsight",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "3.8",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 5540,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "4"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/redis/redisinsight",
    "releases": "https://github.com/RedisInsight/RedisInsight/releases",
    "docs": [
      "https://redis.io/docs/latest/operate/redisinsight/install/install-on-docker/"
    ]
  }
}
