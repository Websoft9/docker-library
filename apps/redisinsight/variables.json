{
  "name": "redisinsight",
  "trademark": "RedisInsight",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "2.70",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 5540,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "4"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/redis/redisinsight"
  }
}
