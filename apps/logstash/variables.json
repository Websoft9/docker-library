{
  "name": "logstash",
  "access": [
    {
      "id": "api",
      "service": "logstash",
      "port": 9600,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "api"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "trademark": "logstash",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "9.5.5"
      ]
    }
  ],
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "1"
  },
  "upstream": {
    "image": "https://hub.docker.com/_/logstash"
  }
}
