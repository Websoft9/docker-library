{
  "name": "mqttx",
  "trademark": "MQTTX",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "v1.12.0",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 80,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "1"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/emqx/mqttx-web"
  }
}
