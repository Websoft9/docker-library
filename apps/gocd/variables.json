{
  "name": "gocd",
  "access": [
    {
      "id": "web",
      "service": "gocd-server",
      "port": 8153,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "web"
          ],
          "scheme": "http",
          "path": "/go/"
        }
      ]
    }
  ],
  "trademark": "GoCD",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "v26.1.0"
      ]
    }
  ],
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "10"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/gocd/gocd-server"
  }
}
