{
  "name": "vault",
  "access": [
    {
      "id": "admin",
      "service": "vault",
      "port": 8200,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "admin"
          ],
          "scheme": "http",
          "path": "/ui/"
        },
        {
          "roles": [
            "api"
          ],
          "scheme": "http",
          "path": "/v1/"
        }
      ]
    }
  ],
  "trademark": "Vault",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/hashicorp/vault",
    "releases": "https://github.com/hashicorp/vault/releases",
    "docs": [
      "https://developer.hashicorp.com/vault/docs",
      "https://hub.docker.com/r/hashicorp/vault"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "2.2",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "1"
  },
  "credentials": {
    "token": {
      "source": "container-log",
      "match": "regex",
      "pattern": "Root Token:\\s*(.+)",
      "group": 1
    }
  },
  "help": {
    "init": "Vault runs in dev mode: the root token is printed once in the container logs at startup (`docker logs <container>`), and data is not persisted across restarts.",
    "login": "Open the Vault UI and sign in with the root token, or export it as `VAULT_TOKEN` for the CLI and API."
  }
}