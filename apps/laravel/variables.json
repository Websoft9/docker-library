{
  "name": "laravel",
  "trademark": "Laravel",
  "release": true,
  "upstream": {
    "image": "https://github.com/laravel/framework",
    "releases": "https://github.com/laravel/framework/releases",
    "docs": [
      "https://laravel.com/framework/docs/installation",
      "https://laravel.com/docs/13.x/deployment",
      "https://frankenphp.dev/docs/laravel/"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "13.40.0",
        "latest"
      ]
    }
  ],
  "access": {
    "web": {
      "port": 8080,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "2",
    "disk": "5"
  },
  "database": [
    {
      "id": "rds",
      "providers": [
        {
          "type": "external",
          "drivers": [
            "postgresql",
            "mysql",
            "mariadb"
          ]
        }
      ],
      "datasource": {
        "DATABASE_URL": "${url}"
      }
    }
  ],
  "help": {
    "db": "No database by default (SQLite). Uncomment DATABASE_URL in .env to use an external MySQL or PostgreSQL database."
  }
}