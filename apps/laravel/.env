W9_REPO=serversideup/php
W9_DIST=community
W9_VERSION=13.31.0

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=laravel
W9_HTTP_PORT=8080
W9_HTTP_PORT_SET=9001
W9_URL=example.youdomain.com
W9_URL_REPLACE=true
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# Laravel application environment variables
# Docs: https://laravel.com/docs/13.x/deployment
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# These container variables override the application's own .env file.
# ============================================================

# Used by docker-compose.yml:
APP_ENV=production
APP_DEBUG=false
APP_URL=http://${W9_URL}
AUTORUN_ENABLED=true
HEALTHCHECK_PATH=/up

# Not used by default; enable only when needed:
# DATABASE_URL=mysql://user:pass@mysql_xxxx:3306/dbname
# SESSION_DRIVER=database
# QUEUE_CONNECTION=database
# CACHE_STORE=database
