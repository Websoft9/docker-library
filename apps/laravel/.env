W9_REPO=serversideup/php
W9_DIST=community
W9_VERSION=13.31.0

W9_POWER_PASSWORD='Fb#iUlChG70a73Yn'

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=laravel
W9_HTTP_PORT=8080
W9_HTTP_PORT_SET=9001
W9_DB_VERSION=8.4
W9_DB_EXPOSE=mysql
W9_URL=internet_ip:${W9_HTTP_PORT_SET}
W9_URL_REPLACE=true
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# Laravel application environment variables
# Docs: https://laravel.com/docs/13.x/deployment
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# These container variables override the application's own .env file.
# ============================================================

# Used by docker-compose.yml:
APP_ENV=production
APP_DEBUG=false
APP_URL=http://${W9_URL}
AUTORUN_ENABLED=true
HEALTHCHECK_PATH=/up
DB_CONNECTION=mysql
DB_HOST=${W9_ID}-mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=${W9_POWER_PASSWORD}

# Not used by default; enable only when needed:
# SESSION_DRIVER=database
# QUEUE_CONNECTION=database
# CACHE_STORE=database
