{
  "name": "knowage",
  "trademark": "Knowage",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/knowagelabs/knowage-server-docker"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "8.1"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8080,
      "path": "/"
    },
    "admin": {
      "port": 8080,
      "path": "/knowage"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "4",
    "disk": "3"
  }
}
