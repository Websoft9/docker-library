{
  "name": "semaphoreui",
  "access": [
    {
      "id": "web",
      "service": "semaphoreui",
      "port": 3000,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "web"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "trademark": "Semaphore UI",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/semaphoreui/semaphore",
    "releases": "https://github.com/semaphoreui/semaphore/releases",
    "docs": [
      "https://docs.semaphoreui.com/"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "v2.19.16",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "4"
  },
  "database": [
    {
      "id": "rds",
      "providers": [
        {
          "type": "internal",
          "service": "mysql",
          "driver": "mysql"
        },
        {
          "type": "external",
          "drivers": [
            "mysql"
          ]
        }
      ],
      "datasource": {
        "SEMAPHORE_DB_HOST": "${host}",
        "SEMAPHORE_DB_PORT": "${port}",
        "SEMAPHORE_DB": "${name}",
        "SEMAPHORE_DB_USER": "${users[*].user}",
        "SEMAPHORE_DB_PASS": "${users[*].password}"
      }
    }
  ],
  "env": {
    "first_startup_only": [
      "SEMAPHORE_ADMIN",
      "SEMAPHORE_ADMIN_NAME",
      "SEMAPHORE_ADMIN_EMAIL",
      "SEMAPHORE_ADMIN_PASSWORD"
    ],
    "secrets": [
      {
        "SEMAPHORE_ACCESS_KEY_ENCRYPTION": "base64"
      }
    ]
  }
}
