W9_REPO=semaphoreui/semaphore
W9_DIST=community
W9_VERSION=v2.19.16

# Optional password seed: enable only when the package actually controls a DB or built-in login.
# See docs/w9-env-spec.md for when W9_POWER_PASSWORD is appropriate.
W9_POWER_PASSWORD='UNeRv!ASZ!s4d1PX'

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=semaphoreui
W9_HTTP_PORT=3000
W9_HTTP_PORT_SET=9001

W9_DB_EXPOSE=mysql
W9_DB_VERSION=8.0

# Built-in login: Semaphore UI creates this admin user on first start.
W9_LOGIN_USER=admin
W9_LOGIN_PASSWORD=${W9_POWER_PASSWORD}

W9_URL=appname.example.com

W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# Semaphore UI image environment variables
# Docs: https://docs.semaphoreui.com/admin-guide/installation/docker
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
SEMAPHORE_DB_DIALECT=mysql
SEMAPHORE_DB_HOST=${W9_ID}-mysql
SEMAPHORE_DB_PORT=3306
SEMAPHORE_DB_USER=semaphore
SEMAPHORE_DB_PASS=${W9_POWER_PASSWORD}
SEMAPHORE_DB=semaphore
SEMAPHORE_TMP_PATH=/tmp/semaphore
SEMAPHORE_ADMIN=${W9_LOGIN_USER}
SEMAPHORE_ADMIN_NAME=admin
SEMAPHORE_ADMIN_EMAIL=admin@localhost.com
SEMAPHORE_ADMIN_PASSWORD=${W9_LOGIN_PASSWORD}
SEMAPHORE_ACCESS_KEY_ENCRYPTION='8NfDK/jj3+j+VRo+2bqbuTpwNiFM77wDhkIgIM7nK+Q='

# Not used by default; enable only when needed:
# SEMAPHORE_WEB_ROOT=http://appname.example.com
# SEMAPHORE_LDAP_ACTIVATED=no
# SEMAPHORE_EMAIL_ALERT=no
# SEMAPHORE_TLS_ENABLED=no
# SEMAPHORE_PORT=:3000
