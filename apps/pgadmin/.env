W9_REPO=dpage/pgadmin4
W9_DIST=community
W9_VERSION=9.18
W9_POWER_PASSWORD="fzSiIb6!yS5W3ROd"

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=pgadmin
W9_HTTP_PORT=80
W9_HTTP_PORT_SET=9090
W9_LOGIN_USER=user@domain.com
W9_LOGIN_PASSWORD=${W9_POWER_PASSWORD}
W9_URL=pgadmin.example.com
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# pgAdmin image environment variables
# Docs: https://www.pgadmin.org/docs/pgadmin4/latest/container_deployment.html
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
PGADMIN_DEFAULT_EMAIL=${W9_LOGIN_USER}
PGADMIN_DEFAULT_PASSWORD=${W9_LOGIN_PASSWORD}
PGADMIN_LISTEN_ADDRESS=0.0.0.0
PGADMIN_DISABLE_POSTFIX=1

# Not used by default; enable only when needed:
# PGADMIN_LISTEN_PORT=80
# PGADMIN_ENABLE_TLS=True
# PGADMIN_DEFAULT_PASSWORD_FILE=/run/secrets/pgadmin_password
# PGADMIN_SERVER_JSON_FILE=/pgadmin4/servers.json
# PGADMIN_REPLACE_SERVERS_ON_STARTUP=True
