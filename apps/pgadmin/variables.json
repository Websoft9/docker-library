{
  "name": "pgadmin",
  "trademark": "pgAdmin",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "9.8",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 80,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "2"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/dpage/pgadmin4"
  }
}
