{
  "name": "pgadmin",
  "access": [
    {
      "id": "web",
      "service": "pgadmin",
      "port": 80,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "admin"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "trademark": "pgAdmin",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "9.19",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "2"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/dpage/pgadmin4",
    "docs": [
      "https://www.pgadmin.org/docs/pgadmin4/latest/container_deployment.html",
      "https://www.pgadmin.org/docs/pgadmin4/9.19/release_notes.html"
    ]
  },
  "credentials": {
    "username": {
      "source": "inline",
      "value": "user@domain.com"
    },
    "password": {
      "source": "container-env",
      "name": "W9_LOGIN_PASSWORD"
    }
  },
  "env": {
    "first_startup_only": [
      "PGADMIN_DEFAULT_EMAIL",
      "PGADMIN_DEFAULT_PASSWORD"
    ]
  }
}
