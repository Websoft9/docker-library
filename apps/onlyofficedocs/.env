W9_REPO=onlyoffice/documentserver
W9_DIST=community
W9_VERSION=9.4

# Optional password seed: enabled because this package seeds the JWT secret.
W9_POWER_PASSWORD='PXx3axTMymf8wE!T'

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=onlyofficedocs
W9_HTTP_PORT=80
W9_HTTP_PORT_SET=9002
W9_URL=appname.example.com
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# ONLYOFFICE Docs image environment variables
# Docs: https://github.com/ONLYOFFICE/Docker-DocumentServer
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
W9_LOGIN_JWT_SECRET=sBPF1mjEbQ2bzj31entX-${W9_POWER_PASSWORD}
JWT_ENABLED=true
JWT_SECRET=${W9_LOGIN_JWT_SECRET}
JWT_HEADER=Authorization
JWT_IN_BODY=false
GENERATE_FONTS=true

# Not used by default; enable only when needed:
# EXAMPLE_ENABLED=false
# WOPI_ENABLED=false
# ALLOW_PRIVATE_IP_ADDRESS=false
# LETS_ENCRYPT_DOMAIN=
# LETS_ENCRYPT_MAIL=
