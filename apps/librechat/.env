RAG_API_URL=http://${W9_ID}-rag:8000
DOMAIN_CLIENT=http://${W9_URL}
DOMAIN_SERVER=http://${W9_URL}
LIBRECHAT_TEMP_CREDENTIALS_PATH=/app/data/.env.temp
ADMIN_PANEL_SESSION_SECRET=6ddae6544d2546d0bfd7f21bdc3d43c7673db7b35a154efe8632f0fe3ec0bbba
ADMIN_PANEL_SESSION_COOKIE_SECURE=false
CONFIG_PATH=/app/librechat.yaml
OPENAI_API_KEY=user_provided
NO_INDEX=true
TRUST_PROXY=1
SEARCH=true
APP_TITLE=LibreChat
HELP_AND_FAQ_URL=https://librechat.ai
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true
SESSION_EXPIRY=1000 * 60 * 15
REFRESH_TOKEN_EXPIRY=(1000 * 60 * 60 * 24) * 7
