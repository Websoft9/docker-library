{
  "name": "librechat",
  "trademark": "LibreChat",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/librechat/librechat",
    "releases": "https://github.com/LibreChat-AI/LibreChat/releases",
    "compose": {
      "compose": "https://raw.githubusercontent.com/LibreChat-AI/LibreChat/main/docker-compose.yml",
      "env": "https://raw.githubusercontent.com/LibreChat-AI/LibreChat/main/.env.example"
    },
    "docs": [
      "https://www.librechat.ai/docs/local/docker",
      "https://www.librechat.ai/docs/configuration/dotenv",
      "https://github.com/LibreChat-AI/LibreChat"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "v0.8.7"
      ]
    }
  ],
  "access": {
    "web": {
      "port": 3080
    },
    "admin": {
      "port": 3000
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "10"
  },
  "env": {
    "secrets": [
      "ADMIN_PANEL_SESSION_SECRET",
      "MEILI_MASTER_KEY",
      "JWT_SECRET",
      "JWT_REFRESH_SECRET",
      "CREDS_KEY",
      "CREDS_IV"
    ]
  }
}
