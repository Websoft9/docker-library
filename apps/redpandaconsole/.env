W9_REPO=docker.redpanda.com/redpandadata/console
W9_DIST=community
W9_VERSION=v3.12.0

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=redpandaconsole
W9_HTTP_PORT=8080
W9_HTTP_PORT_SET=9080
W9_URL=appname.example.com
W9_NETWORK=websoft9

# Kafka broker address on the shared websoft9 network.
# For the Websoft9 Kafka package this is the internal listener <kafka-app-id>:19092.
W9_KAFKA_BROKERS_SET=kafka:19092

#### ------------------------------------------------------------------------------------ ####

# ============================================================
# Redpanda Console image environment variables
# Docs: https://docs.redpanda.com/current/reference/console/config/
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
KAFKA_BROKERS=${W9_KAFKA_BROKERS_SET}

# Not used by default; enable only when needed:
# SCHEMAREGISTRY_ENABLED=true
# SCHEMAREGISTRY_URLS=http://schema-registry:8081
# KAFKA_TLS_ENABLED=true
# KAFKA_SASL_ENABLED=true
# SERVER_LISTENPORT=8080
