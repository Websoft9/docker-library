W9_REPO=ghcr.io/toeverything/affine
W9_DIST=community
W9_VERSION=0.27.4

W9_POWER_PASSWORD=GPtKi8hvv29KrERY

# Environments which for user settings when create application
# Named expression: W9_xxx_xxx_SET, xxx refer to file fields

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=affine
W9_HTTP_PORT=3010
W9_HTTP_PORT_SET=3010
W9_DB_VERSION=pg16
W9_DB_EXPOSE=postgresql
W9_ADMIN_PATH="/admin"
W9_URL=appname.example.com
W9_URL_REPLACE=true

W9_NETWORK=websoft9

#### --------------------------------------------------------------------------------------- ####

# ============================================================
# AFFiNE image environment variables
# Docs: https://ghcr.io/toeverything/affine
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml (runtime wiring):
REDIS_SERVER_HOST=${W9_ID}-redis
DATABASE_URL=postgresql://affine:${W9_POWER_PASSWORD}@${W9_ID}-postgresql:5432/affine
AFFINE_INDEXER_ENABLED=false

# Used by docker-compose.yml (mirrors server.externalUrl in src/config.json):
AFFINE_SERVER_EXTERNAL_URL=http://${W9_URL}

# Not used by default; enable only when needed:
# AFFINE_SERVER_NAME=AFFiNE Self-hosted
