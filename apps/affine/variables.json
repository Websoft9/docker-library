{
  "name": "affine",
  "trademark": "AFFiNE",
  "release": true,
  "upstream": {
    "image": "https://ghcr.io/toeverything/affine",
    "releases": "https://github.com/toeverything/AFFiNE",
    "compose": {
      "compose": "https://github.com/toeverything/AFFiNE/releases/latest/download/docker-compose.yml",
      "env": "https://github.com/toeverything/AFFiNE/releases/latest/download/config.json.example"
    },
    "docs": [
      "https://docs.affine.pro/self-host-affine/install/docker-compose-recommended",
      "https://docs.affine.pro/self-host-affine/install/configuration"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "0.27.4"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 3010,
      "path": "/"
    },
    "admin": {
      "port": 3010,
      "path": "/admin"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "8"
  },
  "database": [
    {
      "id": "rds",
      "providers": [
        {
          "type": "internal",
          "service": "postgres",
          "driver": "postgresql"
        },
        {
          "type": "external",
          "drivers": [
            "postgresql"
          ]
        }
      ],
      "datasource": {
        "DATABASE_URL": "postgresql://${users[*].user}:${users[*].password}@${host}:${port}/${name}"
      }
    },
    {
      "id": "redis",
      "providers": [
        {
          "type": "internal",
          "service": "redis",
          "driver": "redis"
        }
      ],
      "users": [],
      "datasource": {
        "REDIS_SERVER_HOST": "${host}"
      }
    }
  ],
  "env": {
    "first_startup_only": [
      "W9_POWER_PASSWORD"
    ]
  }
}