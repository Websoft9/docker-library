{
  "name": "drupal",
  "trademark": "Drupal",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "11.4",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 80,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "2"
  },
  "upstream": {
    "image": "https://hub.docker.com/_/drupal",
    "releases": "https://www.drupal.org/project/drupal/releases",
    "docs": [
      "https://www.drupal.org/project/drupal/releases",
      "https://github.com/docker-library/docs/blob/master/drupal/README.md"
    ]
  }
}
