{
  "name": "drupal",
  "trademark": "Drupal",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "11.4-apache",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 80,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "2"
  },
  "upstream": {
    "image": "https://hub.docker.com/_/drupal",
    "releases": "https://www.drupal.org/project/drupal/releases",
    "docs": [
      "https://www.drupal.org/project/drupal/releases",
      "https://github.com/docker-library/docs/blob/master/drupal/README.md"
    ]
  },
  "credentials": {
    "none": true
  },
  "externalDB": {
    "11.4": {
      "mysql": {
        "min": "8.0",
        "recommended": "8.4",
        "reason": "Drupal 11 supports MySQL 8.0+; MySQL 8.4 is the current supported LTS track."
      }
    }
  }
}
