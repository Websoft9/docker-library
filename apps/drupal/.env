W9_REPO=drupal
W9_DIST=community
W9_VERSION=11.4-apache
W9_POWER_PASSWORD='T86d82T!i3mO3B7P'

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=drupal
W9_HTTP_PORT=80
W9_HTTP_PORT_SET=9001

# Container name's suffix must use one of the value
W9_DB_EXPOSE=mysql
W9_DB_VERSION=8.0
W9_URL=example.youdomain.com
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

#W9_NAME=""
#W9_RCODE=""

# ============================================================
# Drupal image environment variables
# Docs: https://hub.docker.com/_/drupal
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:

MYSQL_ROOT_PASSWORD=${W9_POWER_PASSWORD}
MYSQL_DATABASE=drupal
MYSQL_USER=drupal
MYSQL_PASSWORD=${W9_POWER_PASSWORD}

# Not used by default; enable only when needed:
# DRUPAL_DB_HOST=
# DRUPAL_DB_NAME=
# DRUPAL_DB_USER=
# DRUPAL_DB_PASSWORD=
# PHP_MEMORY_LIMIT=
