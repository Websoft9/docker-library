W9_REPO=node
W9_DIST=community
W9_VERSION=16.4.0

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=nextjs

W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# Next.js application environment variables
# Docs: https://nextjs.org/docs/app/getting-started/installation
# Follow docs/w9-env-spec.md and docs/app-access-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
NODE_IMAGE_TAG=24-bookworm
APP_DIR=/usr/src/app
PORT=3000
NEXTJS_CREATE_FLAGS=--yes --use-npm
NEXTJS_PACKAGE_MANAGER=auto
NEXT_TELEMETRY_DISABLED=1

# Not used by default; enable only when needed:
# DATABASE_URL=postgres://user:pass@postgres_xxxx:5432/dbname
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# CI=
