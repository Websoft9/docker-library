{
  "name": "jihu",
  "access": [
    {
      "id": "web",
      "service": "jihu",
      "port": 80,
      "public": true,
      "rootUrl": [
        "GITLAB_EXTERNAL_URL"
      ],
      "endpoints": [
        {
          "roles": [
            "web"
          ],
          "scheme": "http",
          "path": "/"
        },
        {
          "roles": [
            "admin"
          ],
          "scheme": "http",
          "path": "/admin"
        },
        {
          "roles": [
            "api"
          ],
          "scheme": "http",
          "path": "/api/v4"
        }
      ]
    },
    {
      "id": "ssh",
      "service": "jihu",
      "port": 22,
      "public": true,
      "mappedPort": [
        "GITLAB_SSH_PORT"
      ],
      "endpoints": [
        {
          "roles": [
            "ssh"
          ],
          "scheme": "ssh"
        }
      ]
    }
  ],
  "trademark": "Jihu GitLab",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "19.4.1",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "2",
    "memory": "8",
    "disk": "2"
  },
  "upstream": {
    "image": "https://registry.gitlab.cn/omnibus/gitlab-jh",
    "docs": [
      "https://docs.gitlab.cn/jh/install/docker.html",
      "https://gitlab.cn/"
    ]
  },
  "env": {
    "first_startup_only": [
      "W9_LOGIN_PASSWORD"
    ]
  },
  "help": {
    "db": "JiHu GitLab bundles PostgreSQL, Redis, and other services inside the omnibus container."
  }
}
