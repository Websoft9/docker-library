{
  "name": "ghost",
  "trademark": "Ghost",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/_/ghost"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "6.9",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 2368,
      "path": "/"
    },
    "admin": {
      "port": 2368,
      "path": "/ghost"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "4"
  }
}
