{
  "name": "ghost",
  "access": [
    {
      "id": "web",
      "service": "ghost",
      "port": 2368,
      "public": true,
      "rootUrl": [
        "url"
      ],
      "endpoints": [
        {
          "roles": [
            "web"
          ],
          "scheme": "http",
          "path": "/"
        },
        {
          "roles": [
            "admin"
          ],
          "scheme": "http",
          "path": "/ghost/"
        }
      ]
    }
  ],
  "trademark": "Ghost",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/_/ghost",
    "releases": "https://github.com/TryGhost/Ghost/releases",
    "docs": [
      "https://ghost.org/docs/config/",
      "https://ghost.org/docs/install/docker/"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "6.69",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "4"
  },
  "database": [
    {
      "id": "rds",
      "providers": [
        {
          "type": "internal",
          "service": "mysql",
          "driver": "mysql"
        },
        {
          "type": "external",
          "drivers": [
            "mysql"
          ]
        }
      ],
      "datasource": {
        "database__connection__host": "${host}",
        "database__connection__database": "${name}",
        "database__connection__user": "${users[*].user}",
        "database__connection__password": "${users[*].password}"
      }
    }
  ],
  "help": {
    "init": "First run: open /ghost and create the administrator account in the browser, then log in with those credentials.",
    "login": "Log in at /ghost with the administrator account you created."
  }
}