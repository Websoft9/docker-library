W9_REPO=ghost
W9_DIST=community
W9_VERSION=6.65
W9_POWER_PASSWORD="upxOisMYI5V!0UXx"

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=ghost

W9_HTTP_PORT=2368
W9_HTTP_PORT_SET=9001

W9_DB_EXPOSE=mysql
W9_DB_VERSION=8.0

# Access admin page to create the administrator account
W9_ADMIN_PATH="/ghost"

W9_URL=appname.example.com
W9_URL_REPLACE=true

W9_NETWORK=websoft9
#### --------------------------------------------------------------------------------------- ####

# ============================================================
# Ghost image environment variables
# Docs: https://ghost.org/docs/config/
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# ============================================================

# Used by docker-compose.yml:

NODE_ENV=production
database__client=mysql
database__connection__host=${W9_ID}-mysql
database__connection__user=${W9_ID}
database__connection__password="${W9_POWER_PASSWORD}"
database__connection__database=${W9_ID}
url=http://${W9_URL}

# Not used by default; enable only when needed:
# database__connection__port=3306
# database__pool__min=2
# database__pool__max=20
# mail__transport=SMTP
# mail__from=websoft9@example.com
