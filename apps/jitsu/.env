W9_REPO=jitsucom/console
W9_DIST=community
W9_VERSION=2.15

# Optional password seed: Jitsu seeds the first console user and bundled datastore passwords.
W9_POWER_PASSWORD="1PrMxExC45LsCT"

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=jitsu
W9_HTTP_PORT=3000
W9_HTTP_PORT_SET=9001

# Dependency helpers: PostgreSQL is the primary configuration database.
W9_DB_EXPOSE=postgresql
W9_DB_VERSION=14

# Built-in login and URL helpers: keep these in the protected block because the appstore parser
# reads them from the app package metadata surface.
W9_LOGIN_USER=admin@jitsu.com
W9_LOGIN_PASSWORD=${W9_POWER_PASSWORD}
W9_URL=example.youdomain.com
W9_ADMIN_PATH=/login
W9_API_PORT_SET=9002

W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

#W9_NAME=""
#W9_RCODE=""

# ============================================================
# Jitsu image environment variables
# Docs: https://jitsu.com/docs/self-hosting/configuration
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
JITSU_POSTGRES_PASSWORD=${W9_POWER_PASSWORD}
JITSU_CLICKHOUSE_PASSWORD=${W9_POWER_PASSWORD}
JITSU_MONGODB_PASSWORD=${W9_POWER_PASSWORD}
JITSU_CONSOLE_TOKEN=7a9c4e2b8f1d6a3c5e9b0d2f4a8c1e7b
JITSU_BULKER_TOKEN=3f8a1c6e9d2b4f7a0c5e8b1d4a7f2c9e
JITSU_ROTOR_TOKEN=9b2e5a8c1f4d7b0e3a6c9f2d5b8e1a4c
JITSU_JWT_SECRET=6de1460fd8ba429285c9e72cc5339291
JITSU_EE_API_TOKEN=5f92ff738db8432899737fbdc7259bbd
JITSU_POSTGRES_VERSION=14
JITSU_MONGODB_VERSION=7.0
JITSU_CLICKHOUSE_VERSION=26.8
JITSU_REDPANDA_VERSION=v26.2.2
SEED_USER_EMAIL=${W9_LOGIN_USER}
SEED_USER_PASSWORD=${W9_LOGIN_PASSWORD}
SEED_DEMO_CONFIGURATION=true
JITSU_INGEST_PUBLIC_URL=http://internet_ip:${W9_API_PORT_SET}

# Not used by default; enable only when needed:
# DISABLE_SIGNUP=true
# LOG_LEVEL=info
# LOG_FORMAT=json
# NEXT_PUBLIC_LOG_LEVEL=info
# SYNCS_ENABLED=true
