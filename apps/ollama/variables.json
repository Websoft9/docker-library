{
  "name": "ollama",
  "access": [
    {
      "id": "api",
      "service": "app-nogpu",
      "port": 11434,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "api"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "trademark": "Ollama",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/ollama/ollama",
    "releases": "https://github.com/ollama/ollama/releases",
    "docs": [
      "https://github.com/ollama/ollama/blob/main/docs/docker.md"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "0.40.2",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "10"
  }
}
