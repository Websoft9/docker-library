{
  "name": "haproxy",
  "access": [
    {
      "id": "stats",
      "service": "haproxy",
      "port": 80,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "dashboard"
          ],
          "scheme": "http",
          "path": "/stats"
        },
        {
          "roles": [
            "gateway"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "trademark": "HAProxy",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/_/haproxy"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "3.4",
        "3.2",
        "3.0",
        "2.8",
        "2.6"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "4"
  }
}
