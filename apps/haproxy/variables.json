{
  "name": "haproxy",
  "trademark": "HAProxy",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/_/haproxy"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "3.4",
        "3.2",
        "3.0",
        "2.8",
        "2.6"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 80,
      "path": "/"
    },
    "admin": {
      "port": 80,
      "path": "/stats"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "4"
  }
}
