{
  "name": "youtrack",
  "trademark": "YouTrack",
  "release": true,
  "access": [
    {
      "id": "web",
      "service": "youtrack",
      "port": 8080,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "web"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    }
  ],
  "upstream": {
    "image": "https://hub.docker.com/r/jetbrains/youtrack",
    "docs": [
      "https://www.jetbrains.com/help/youtrack/server/youtrack-docker-installation.html"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "2026.2.18991"
      ]
    }
  ],
  "requirements": {
    "cpu": "2",
    "memory": "1.5",
    "disk": "10"
  },
  "credentials": {
    "token": {
      "source": "container-file",
      "path": "/opt/youtrack/conf/internal/services/configurationWizard/wizard_token.txt",
      "format": "text"
    }
  },
  "env": {
    "first_startup_only": []
  },
  "help": {
    "init": "The first-run wizard token is written to `/opt/youtrack/conf/internal/services/configurationWizard/wizard_token.txt` inside the container once YouTrack has started.",
    "login": "Open YouTrack, paste the wizard token into the setup screen, and create the first administrator account."
  }
}