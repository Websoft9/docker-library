{
  "name": "clickhouse",
  "trademark": "ClickHouse",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/clickhouse/clickhouse-server",
    "releases": "https://github.com/ClickHouse/ClickHouse/releases",
    "docs": [
      "https://github.com/ClickHouse/ClickHouse/tree/master/docker",
      "https://clickhouse.com/docs"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "26.9",
        "latest"
      ]
    }
  ],
  "access": {
    "web": {
      "port": 8123,
      "path": "/play"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "2"
  },
  "credentials": {
    "username": {
      "source": "container-env",
      "name": "W9_LOGIN_USER"
    },
    "password": {
      "source": "container-env",
      "name": "W9_LOGIN_PASSWORD"
    }
  },
  "env": {
    "first_startup_only": [
      "CLICKHOUSE_DB",
      "CLICKHOUSE_USER",
      "CLICKHOUSE_PASSWORD",
      "CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT"
    ]
  },
  "help": {}
}
