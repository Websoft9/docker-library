W9_REPO=mattermost/mattermost-team-edition
W9_DIST=community
W9_VERSION=11.11

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=mattermost
W9_HTTP_PORT=8065
W9_HTTP_PORT_SET=9001
W9_TCP_PORT_SET=8443
W9_UDP_PORT_SET=8443
W9_DB_EXPOSE=postgresql
W9_DB_VERSION=14.0
W9_RCODE=5zuDcsG3MVy3M
W9_URL=appname.example.com
W9_URL_REPLACE=true
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# Mattermost image environment variables
# Docs: https://docs.mattermost.com/install/install-docker.html
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
MM_BLEVESETTINGS_INDEXDIR=/mattermost/bleve-indexes
MM_SQLSETTINGS_DRIVERNAME=postgres
MM_SQLSETTINGS_DATASOURCE=postgres://postgres:${W9_RCODE}@${W9_ID}-postgresql:5432/mattermost?sslmode=disable&connect_timeout=10
MM_SERVICESETTINGS_SITEURL=https://${W9_URL}

# Not used by default; enable only when needed:
# MM_EMAILSETTINGS_SENDEMAILNOTIFICATIONS=true
# MM_EMAILSETTINGS_REPLYTOADDRESS=
# MM_EMAILSETTINGS_FEEDBACKEMAIL=
# MM_SERVICESETTINGS_ENABLEOPENSERVER=true
# MM_TEAMSETTINGS_SITENAME=Mattermost
