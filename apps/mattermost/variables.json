{
  "name": "mattermost",
  "trademark": "Mattermost",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/mattermost/mattermost-team-edition",
    "docs": [
      "https://docs.mattermost.com/install/install-docker.html",
      "https://docs.mattermost.com/deployment-guide/server/docker-troubleshooting.html",
      "https://docs.mattermost.com/product-overview/mattermost-v12-changelog"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "12.0"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8065,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "8"
  }
}
