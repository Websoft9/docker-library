{
  "name": "mattermost",
  "access": [
    {
      "id": "web",
      "service": "mattermost",
      "port": 8065,
      "public": true,
      "rootUrl": [
        "MM_SERVICESETTINGS_SITEURL"
      ],
      "endpoints": [
        {
          "roles": [
            "web"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    },
    {
      "id": "calls-tcp",
      "service": "mattermost",
      "port": 8443,
      "public": false,
      "endpoints": []
    },
    {
      "id": "calls-udp",
      "service": "mattermost",
      "port": 8443,
      "protocol": "udp",
      "public": false,
      "endpoints": []
    }
  ],
  "trademark": "Mattermost",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/mattermost/mattermost-team-edition",
    "docs": [
      "https://docs.mattermost.com/install/install-docker.html",
      "https://docs.mattermost.com/deployment-guide/server/docker-troubleshooting.html",
      "https://docs.mattermost.com/product-overview/mattermost-v12-changelog"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "12.1"
      ]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "8"
  },
  "database": [
    {
      "id": "postgres",
      "providers": [
        {
          "type": "internal",
          "service": "postgres",
          "driver": "postgresql"
        },
        {
          "type": "external",
          "drivers": [
            "postgresql"
          ]
        }
      ],
      "users": [
        {
          "user": "${POSTGRES_USER}",
          "password": "${W9_RCODE}",
          "usage": [
            "application",
            "administration"
          ]
        }
      ],
      "datasource": {
        "MM_SQLSETTINGS_DATASOURCE": "${url}?sslmode=disable&connect_timeout=10"
      }
    }
  ]
}