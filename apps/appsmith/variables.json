{
  "name": "appsmith",
  "trademark": "Appsmith",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/appsmith/appsmith-ce",
    "releases": "https://github.com/appsmithorg/appsmith",
    "compose": {
      "compose": "https://raw.githubusercontent.com/appsmithorg/appsmith/release/deploy/docker/docker-compose.yml",
      "env": "https://raw.githubusercontent.com/appsmithorg/appsmith/release/.env.example"
    },
    "docs": [
      "https://docs.appsmith.com/getting-started/setup/installation-guides/docker",
      "https://docs.appsmith.com/getting-started/setup/best-practices",
      "https://docs.appsmith.com/getting-started/setup/instance-configuration/custom-mongodb-redis"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "v2.3",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "1"
  }
}
