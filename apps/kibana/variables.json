{
  "name": "kibana",
  "trademark": "Kibana",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/_/kibana",
    "docs": [
      "https://www.elastic.co/docs/deploy-manage/deploy/self-managed/install-kibana-with-docker",
      "https://www.elastic.co/docs/release-notes/kibana"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "9.5.5"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 5601,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "5"
  }
}
