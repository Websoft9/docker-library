{
  "name": "kibana",
  "trademark": "Kibana",
  "release": true,
  "upstream": {
    "image": "https://www.docker.elastic.co/r/kibana"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "8.12.2"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 5601,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "5"
  }
}
