{
  "name": "matomo",
  "trademark": "Matomo",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "5.6.1",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 80,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "2"
  },
  "database": [
    {
      "id": "mysql",
      "providers": [
        {
          "type": "internal",
          "service": "mysql",
          "driver": "mysql"
        },
        {
          "type": "external",
          "drivers": [
            "mysql",
            "mariadb"
          ]
        }
      ],
      "datasource": {
        "MATOMO_DATABASE_HOST": "${host}",
        "MATOMO_DATABASE_DBNAME": "${name}",
        "MATOMO_DATABASE_USERNAME": "${users[*].user}",
        "MATOMO_DATABASE_PASSWORD": "${users[*].password}"
      }
    }
  ],
  "upstream": {
    "image": "https://hub.docker.com/_/matomo"
  }
}