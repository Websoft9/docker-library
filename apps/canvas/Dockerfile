ARG RUBY=3.4
ARG CANVAS_VERSION=2026-05-20.143
ARG POSTGRES_CLIENT=14
ARG CANVAS_RAILS=8.0

FROM instructure/ruby-passenger:${RUBY}-jammy AS base

ARG RUBY
ARG CANVAS_RAILS
ENV APP_HOME=/usr/src/app/ \
    RAILS_ENV=production \
    SASS_STYLE=compressed \
    RAILS_LOAD_ALL_LOCALES=1 \
    NGINX_MAX_UPLOAD_SIZE=10g \
    LANG=en_US.UTF-8 \
    LANGUAGE=en_US.UTF-8 \
    LC_CTYPE=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    CANVAS_RAILS=${CANVAS_RAILS} \
    NODE_MAJOR=20 \
    GEM_HOME=/home/docker/.gem/${RUBY} \
    BUNDLE_APP_CONFIG=/home/docker/.bundle \
    PATH=/usr/src/app/bin:/home/docker/.gem/${RUBY}/bin:${PATH}

WORKDIR ${APP_HOME}

FROM base AS builder

ARG RUBY
ARG CANVAS_VERSION
ARG POSTGRES_CLIENT
ENV POSTGRES_PASSWORD=build-secret \
    CANVAS_DATABASE_HOST=postgres \
    CANVAS_DATABASE_USERNAME=postgres \
    CANVAS_DATABASE_PRODUCTION=canvas_production \
    CANVAS_REDIS_URL=redis://redis \
    CANVAS_HOST=canvas.example.com \
    ENCRYPTION_KEY=build-encryption-key-0123456789 \
    JWT_ENCRYPTION_KEY=build-jwt-key-0123456789 \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    COMPILE_ASSETS_BRAND_CONFIGS=0 \
    COMPILE_ASSETS_NPM_INSTALL=0

USER root
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
    && printf 'path-exclude /usr/share/doc/*\npath-exclude /usr/share/man/*' > /etc/dpkg/dpkg.cfg.d/01_nodoc \
    && echo "deb http://apt.postgresql.org/pub/repos/apt/ $(lsb_release -cs)-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | apt-key add - \
    && add-apt-repository ppa:git-core/ppa -ny \
    && apt-get update -qq \
    && apt-get install -qqy --no-install-recommends \
        nodejs \
        libxmlsec1-dev \
        python3-lxml \
        python-is-python3 \
        libicu-dev \
        libidn11-dev \
        parallel \
        postgresql-client-${POSTGRES_CLIENT} \
        tzdata \
        unzip \
        pbzip2 \
        git \
        build-essential \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /home/docker/.gem/ruby/$RUBY_MAJOR.0

RUN gem install bundler --no-document -v 2.5.10 \
    && find ${GEM_HOME} ! -user docker | xargs chown docker:docker

RUN npm install -g npm@9.8.1 && npm cache clean --force
RUN corepack enable && corepack prepare yarn@1.19.1 --activate
RUN git clone --depth 1 --branch release/${CANVAS_VERSION} https://github.com/instructure/canvas-lms.git ${APP_HOME}
RUN mkdir -p /home/docker/.gem/ruby/${RUBY}.0 \
    && chown -R docker:docker /home/docker ${APP_HOME}

USER docker
RUN unset RUBY \
    && bundle config --global build.nokogiri --use-system-libraries \
    && bundle config --global build.ffi --enable-system-libffi \
    && bundle install

COPY --chown=docker:docker src/database.yml /usr/src/app/config/database.yml
COPY --chown=docker:docker src/domain.yml /usr/src/app/config/domain.yml
COPY --chown=docker:docker src/redis.yml /usr/src/app/config/redis.yml
COPY --chown=docker:docker src/cache_store.yml /usr/src/app/config/cache_store.yml
COPY --chown=docker:docker src/security.yml /usr/src/app/config/security.yml
COPY --chown=docker:docker src/outgoing_mail.yml /usr/src/app/config/outgoing_mail.yml
COPY --chown=docker:docker src/dynamic_settings.yml /usr/src/app/config/dynamic_settings.yml
COPY --chown=docker:docker src/delayed_jobs.yml /usr/src/app/config/delayed_jobs.yml
COPY --chown=docker:docker src/entrypoint.sh /usr/local/bin/entrypoint.sh

RUN mkdir -p tmp/files \
    && (yarn install --frozen-lockfile || yarn install --frozen-lockfile --network-concurrency 1) \
    && mkdir -p log tmp/pids public/assets app/stylesheets/brandable_css_brands \
    && touch app/stylesheets/_brandable_variables_defaults_autogenerated.scss Gemfile.lock log/production.log \
    && bin/rails canvas:compile_assets --trace \
    && rm -rf .git .github .devcontainer .vscode doc spec test node_modules tmp/cache public/dist/webpack-dev

FROM base

ARG CANVAS_VERSION
LABEL org.opencontainers.image.authors="https://www.websoft9.com" \
      org.opencontainers.image.description="Canvas LMS packaged by Websoft9" \
      org.opencontainers.image.source="https://github.com/Websoft9/docker-library/tree/main/apps/canvas" \
      org.opencontainers.image.title="canvas" \
      org.opencontainers.image.vendor="Websoft9 Inc." \
      org.opencontainers.image.version="${CANVAS_VERSION}"

USER root
RUN printf 'path-exclude /usr/share/doc/*\npath-exclude /usr/share/man/*' > /etc/dpkg/dpkg.cfg.d/01_nodoc \
    && apt-get update -qq \
    && apt-get install -qqy --no-install-recommends \
        curl \
        libicu70 \
        libidn12 \
        libpq5 \
        libxmlsec1 \
        libxmlsec1-openssl \
        tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder --chown=docker:docker /home/docker/.gem /home/docker/.gem
COPY --from=builder --chown=docker:docker /home/docker/.bundle /home/docker/.bundle
COPY --from=builder --chown=docker:docker /usr/src/app /usr/src/app
COPY --from=builder /usr/local/bin/entrypoint.sh /usr/local/bin/entrypoint.sh

RUN chmod +x /usr/local/bin/entrypoint.sh \
    && chown docker:docker /usr/local/bin/entrypoint.sh

USER docker

EXPOSE 80
