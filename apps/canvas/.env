W9_REPO=websoft9dev/canvas
W9_DIST=community
W9_VERSION=2026-05-20.143
W9_POWER_PASSWORD="8d8Zs7wP9nK4xQ2L"

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=canvas
W9_HTTP_PORT=80
W9_HTTP_PORT_SET=9001
W9_DB_VERSION=16
W9_DB_EXPOSE=postgresql
W9_LOGIN_USER=admin@example.com
W9_LOGIN_PASSWORD=${W9_POWER_PASSWORD}
W9_URL=canvas.example.com
W9_URL_REPLACE=true
W9_ADMIN_PATH="/login/canvas"
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# Canvas image environment variables
# Docs: https://github.com/instructure/canvas-lms/wiki/Production-Start
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
CANVAS_DATABASE_HOST=${W9_ID}-postgresql
CANVAS_DATABASE_USERNAME=postgres
CANVAS_DATABASE_PRODUCTION=canvas_production
CANVAS_REDIS_URL=redis://${W9_ID}-redis
CANVAS_LMS_ACCOUNT_NAME=Canvas
CANVAS_LMS_STATS_COLLECTION=opt_out
CANVAS_LMS_ADMIN_EMAIL=${W9_LOGIN_USER}
CANVAS_LMS_ADMIN_PASSWORD=${W9_LOGIN_PASSWORD}
POSTGRES_PASSWORD=${W9_POWER_PASSWORD}
POSTGRES_DB=canvas_production
POSTGRES_USER=postgres
ENCRYPTION_KEY=2dc25a5b3f51d1e355f6a957edb4173d8cf357f9ee62215e6296b6031d1da7ff
JWT_ENCRYPTION_KEY=52a2af6d7bfc91f1ec9dbbd2bf6492b546bab9175297c6c38ca45c98958d4a92

