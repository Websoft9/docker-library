W9_REPO=appwrite/appwrite
W9_DIST=community
W9_VERSION=1.9.6

W9_POWER_PASSWORD=1PrMxExC45LsCT
W9_KEY_SET=dfsjdkjf77xjxcjcj

# Environments which for user settings when create application
# Named expression: W9_xxx_xxx_SET, xxx refer to file fields
W9_HTTP_PORT_SET=9001
W9_HTTPS_PORT_SET=9002

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=appwrite
W9_HTTP_PORT=80
W9_HTTPS_PORT=443
W9_DB_VERSION=8.2
W9_DB_EXPOSE=mongodb
W9_URL=internet_ip:${W9_HTTP_PORT_SET}
W9_URL_REPLACE=true
W9_ADMIN_PATH=/console
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

#W9_NAME=""
#W9_RCODE=""

# ============================================================
# Appwrite image environment variables
# Docs: https://appwrite.io/docs/advanced/self-hosting/configuration/environment-variables
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
_APP_ENV=production
_APP_EDITION=self-hosted
_APP_LOCALE=en
_APP_OPENSSL_KEY_V1=${W9_KEY_SET}
_APP_RULES_FORMAT=md5
_APP_SYSTEM_RESPONSE_FORMAT=
_APP_TRUSTED_HEADERS=x-forwarded-for
_APP_POOL_ADAPTER=stack
_APP_WORKER_PER_CORE=2
_APP_WORKERS_NUM=1
_APP_WORKER_MAX_COROUTINES=1
_APP_WORKER_SCREENSHOTS_ROUTER=http://${W9_ID}
_APP_COMPRESSION_ENABLED=enabled
_APP_COMPRESSION_MIN_SIZE_BYTES=1024
_APP_DOMAIN=${W9_URL}
_APP_DOMAIN_FUNCTIONS=functions.localhost
_APP_DOMAIN_SITES=sites.localhost
_APP_DOMAIN_TARGET_A=127.0.0.1
_APP_DOMAIN_TARGET_AAAA=::1
_APP_DOMAIN_TARGET_CAA=letsencrypt.org
_APP_DOMAIN_TARGET_CNAME=${W9_URL}
_APP_CUSTOM_DOMAIN_DENY_LIST=
_APP_DNS=1.1.1.1
_APP_OPTIONS_FORCE_HTTPS=disabled
_APP_OPTIONS_ROUTER_FORCE_HTTPS=disabled
_APP_OPTIONS_ROUTER_PROTECTION=disabled
_APP_OPTIONS_ABUSE=enabled
_APP_CONSOLE_DOMAIN=
