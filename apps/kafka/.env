W9_REPO=apache/kafka
W9_DIST=community
W9_VERSION=4.3.1

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=kafka
W9_MQ_PORT_SET=9092
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# Kafka image environment variables
# Docs: https://github.com/apache/kafka/tree/trunk/docker/examples
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
# Single-node KRaft broker + controller. For a 3-node cluster see Notes.md.
CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
# Address advertised to clients outside the Docker network. Set it to the server
# IP or domain for remote clients; leave as localhost for same-host clients.
KAFKA_ADVERTISED_HOST=localhost
# Listener ports:
#   9092  PLAINTEXT_HOST - external clients (published to the host)
#   19092 PLAINTEXT      - in-network clients, e.g. Redpanda Console (internal only)
#   29093 CONTROLLER     - KRaft controller quorum (internal only)
KAFKA_LISTENERS=CONTROLLER://:29093,PLAINTEXT_HOST://:9092,PLAINTEXT://:19092
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT_HOST://${KAFKA_ADVERTISED_HOST}:${W9_MQ_PORT_SET},PLAINTEXT://${W9_ID}:19092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
KAFKA_CONTROLLER_QUORUM_VOTERS=1@${W9_ID}:29093
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_SHARE_COORDINATOR_STATE_TOPIC_REPLICATION_FACTOR=1
KAFKA_SHARE_COORDINATOR_STATE_TOPIC_MIN_ISR=1
KAFKA_LOG_DIRS=/var/lib/kafka/data

# Not used by default; enable only when needed:
# KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
# KAFKA_LOG_RETENTION_HOURS=168
# KAFKA_NUM_PARTITIONS=3
# KAFKA_DEFAULT_REPLICATION_FACTOR=3
# KAFKA_MIN_INSYNC_REPLICAS=2
