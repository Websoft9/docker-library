W9_REPO=prestashop/prestashop
W9_DIST=community
W9_VERSION=9.1
W9_POWER_PASSWORD="vmx#mrosR8kKNQjE"

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=prestashop
W9_HTTP_PORT=80
W9_HTTP_PORT_SET=9001
W9_DB_EXPOSE=mysql
W9_DB_VERSION=8.4
W9_LOGIN_USER=websoft9@example.com
W9_LOGIN_PASSWORD=${W9_POWER_PASSWORD}
W9_URL=appname.example.com
W9_URL_REPLACE=true
W9_ADMIN_PATH=/psadmin
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# PrestaShop image environment variables
# Docs: https://hub.docker.com/r/prestashop/prestashop
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
PS_INSTALL_AUTO=1
PS_DOMAIN=${W9_URL}
PS_HANDLE_DYNAMIC_DOMAIN=0
PS_LANGUAGE=en
PS_COUNTRY=GB
PS_FOLDER_ADMIN=psadmin
PS_DEMO_MODE=0
PS_DEV_MODE=0
DB_SERVER=${W9_ID}-mysql
DB_USER=root
DB_PASSWD=${W9_POWER_PASSWORD}
DB_PREFIX=ps_
DB_NAME=${W9_ID}
ADMIN_MAIL=${W9_LOGIN_USER}
ADMIN_PASSWD=${W9_POWER_PASSWORD}

# Not used by default; enable only when needed:
# PS_ALL_LANGUAGES=1
# PS_ENABLE_SSL=1
# PS_ERASE_DB=0
# PS_INSTALL_DB=0
# PS_HOST_MODE=0
