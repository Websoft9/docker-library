{
  "name": "portkey",
  "trademark": "Portkey",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/portkeyai/gateway"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "1.14.3",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8787,
      "path": "/"
    },
    "admin": {
      "port": 8787,
      "path": "/public"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "1"
  }
}
