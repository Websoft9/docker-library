{
  "name": "weaviate",
  "access": [
    {
      "id": "db",
      "service": "weaviate",
      "port": 8080,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "db"
          ],
          "scheme": "http",
          "path": "/"
        }
      ]
    },
    {
      "id": "grpc",
      "service": "weaviate",
      "port": 50051,
      "public": true,
      "endpoints": [
        {
          "roles": [
            "db"
          ],
          "scheme": "grpc"
        }
      ]
    }
  ],
  "trademark": "Weaviate",
  "release": false,
  "edition": [
    {
      "dist": "community",
      "version": [
        "1.39.5",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "10"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/semitechnologies/weaviate",
    "releases": "https://github.com/weaviate/weaviate/releases",
    "docs": [
      "https://weaviate.io/developers/weaviate/installation/docker-compose",
      "https://weaviate.io/developers/weaviate/config-refs/env-vars"
    ]
  }
}
