W9_REPO=redmine
W9_DIST=community
W9_VERSION=7.0
W9_POWER_PASSWORD="LFQr2zktxC!0q4cV"

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=redmine
W9_HTTP_PORT=3000
W9_HTTP_PORT_SET=9003

W9_LOGIN_USER=admin
W9_LOGIN_PASSWORD=admin

W9_URL=appname.example.com

W9_DB_EXPOSE=mysql
W9_DB_VERSION=8.0

W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# Redmine image environment variables
# Docs: https://github.com/docker-library/docs/blob/master/redmine/README.md
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
REDMINE_DB_MYSQL=${W9_ID}-mysql
REDMINE_DB_USERNAME=${W9_ID}
REDMINE_DB_DATABASE=${W9_ID}
REDMINE_DB_PASSWORD=${W9_POWER_PASSWORD}
REDMINE_PLUGINS_MIGRATE=1
SECRET_KEY_BASE=${W9_POWER_PASSWORD}

# Not used by default; enable only when needed:
# REDMINE_DB_PORT=3306
# REDMINE_DB_POSTGRES=
# REDMINE_DB_SQLSERVER=
# REDMINE_HTTPS=true
# REDMINE_NO_DB_MIGRATE=true
