{
  "name": "redmine",
  "trademark": "Redmine",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/_/redmine",
    "releases": "https://www.redmine.org/projects/redmine/wiki/Download",
    "docs": [
      "https://github.com/docker-library/docs/blob/master/redmine/README.md",
      "https://www.redmine.org/projects/redmine/wiki/RedmineInstall"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "7.0",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 3000,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "1"
  },
  "database": [
    {
      "id": "rds",
      "providers": [
        {
          "type": "internal",
          "service": "mysql",
          "driver": "mysql"
        },
        {
          "type": "external",
          "drivers": [
            "mysql",
            "mariadb"
          ]
        }
      ],
      "datasource": {
        "REDMINE_DB_MYSQL": "${host}",
        "REDMINE_DB_DATABASE": "${name}",
        "REDMINE_DB_USERNAME": "${users[*].user}",
        "REDMINE_DB_PASSWORD": "${users[*].password}"
      }
    }
  ],
  "env": {
    "secrets": [
      "SECRET_KEY_BASE"
    ]
  }
}