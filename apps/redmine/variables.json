{
  "name": "redmine",
  "trademark": "Redmine",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/_/redmine"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "6.1",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 3000,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "1"
  }
}
