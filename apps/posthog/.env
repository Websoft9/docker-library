W9_REPO=posthog/posthog
W9_DIST=community
W9_VERSION=latest

W9_POWER_PASSWORD=1PrMxExC45LsCT

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=posthog
W9_HTTP_PORT=80
W9_HTTP_PORT_SET=9019
W9_DB_EXPOSE=postgresql
W9_DB_VERSION=15-alpine
W9_URL=example.youdomain.com
W9_URL_REPLACE=true
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# PostHog image environment variables
# Docs: https://posthog.com/docs/self-host
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# ============================================================

# Used by docker-compose.yml:
POSTHOG_NODE_TAG=latest
REDIS_VERSION=7.2-alpine
VALKEY_VERSION=8.1-alpine
CLICKHOUSE_VERSION=26.6
KAFKA_VERSION=v25.1.9
OBJECTSTORAGE_VERSION=4.29

POSTHOG_DB_NAME=posthog
POSTHOG_DB_USER=posthog
POSTHOG_DB_PASSWORD=${W9_POWER_PASSWORD}
POSTHOG_SECRET=change-this-posthog-secret
ENCRYPTION_SALT_KEYS=change-this-salt-key

DATABASE_URL=postgres://${POSTHOG_DB_USER}:${POSTHOG_DB_PASSWORD}@db:5432/${POSTHOG_DB_NAME}
REDIS_URL=redis://redis7:6379/
KAFKA_HOSTS=kafka:9092

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_DATABASE=posthog
CLICKHOUSE_SECURE=false
CLICKHOUSE_VERIFY=false

OBJECT_STORAGE_ENABLED=true
OBJECT_STORAGE_ENDPOINT=http://objectstorage:19000
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://${W9_URL}
OBJECT_STORAGE_ACCESS_KEY_ID=object_storage_root_user
OBJECT_STORAGE_SECRET_ACCESS_KEY=${W9_POWER_PASSWORD}
OBJECT_STORAGE_FORCE_PATH_STYLE=true

SESSION_RECORDING_V2_S3_ENDPOINT=${OBJECT_STORAGE_ENDPOINT}
SESSION_RECORDING_V2_S3_ACCESS_KEY_ID=${OBJECT_STORAGE_ACCESS_KEY_ID}
SESSION_RECORDING_V2_S3_SECRET_ACCESS_KEY=${OBJECT_STORAGE_SECRET_ACCESS_KEY}

SITE_URL=https://${W9_URL}
IS_BEHIND_PROXY=true
DISABLE_SECURE_SSL_REDIRECT=true

# Not used by default; enable only when needed:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini
# OPT_OUT_CAPTURE=false

#W9_NAME=""
#W9_RCODE=""
