{
  "name": "nextcloud",
  "trademark": "Nextcloud",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/_/nextcloud",
    "releases": "https://nextcloud.com/changelog/",
    "docs": [
      "https://github.com/nextcloud/docker",
      "https://docs.nextcloud.com/server/latest/admin_manual/installation/system_requirements.html"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "35.0",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 80,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "4"
  },
  "database": [
    {
      "id": "mysql",
      "providers": [
        {
          "type": "internal",
          "service": "db",
          "driver": "mysql"
        },
        {
          "type": "external",
          "drivers": [
            "mysql",
            "mariadb"
          ]
        }
      ],
      "datasource": {
        "MYSQL_HOST": "${host}",
        "MYSQL_DATABASE": "${name}",
        "MYSQL_USER": "${users[*].user}",
        "MYSQL_PASSWORD": "${users[*].password}"
      }
    }
  ],
  "env": {
    "first_startup_only": [
      "NEXTCLOUD_ADMIN_USER",
      "NEXTCLOUD_ADMIN_PASSWORD"
    ]
  },
  "help": {
    "db": "Nextcloud 35 supports MySQL 8.4 / 9.7 and MariaDB 10.11+. This package bundles MySQL 8.4 for a single-node deployment."
  }
}