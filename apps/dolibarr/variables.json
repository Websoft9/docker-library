{
  "name": "dolibarr",
  "trademark": "Dolibarr",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/dolibarr/dolibarr",
    "releases": "https://github.com/Dolibarr/dolibarr/releases",
    "docs": [
      "https://github.com/Dolibarr/dolibarr-docker",
      "https://github.com/Dolibarr/dolibarr"
    ]
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "24.0.1",
        "latest"
      ]
    }
  ],
  "access": {
    "web": {
      "port": 80,
      "path": "/"
    },
    "admin": {
      "port": 80,
      "path": "/admin"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "1"
  },
  "env": {
    "first_startup_only": [
      "W9_LOGIN_USER",
      "W9_LOGIN_PASSWORD"
    ]
  },
  "database": [
    {
      "id": "rds",
      "providers": [
        {
          "type": "internal",
          "service": "mariadb",
          "driver": "mariadb"
        },
        {
          "type": "external",
          "drivers": [
            "mysql",
            "mariadb"
          ]
        }
      ],
      "datasource": {
        "DOLI_DB_HOST": "${host}",
        "DOLI_DB_NAME": "${name}",
        "DOLI_DB_USER": "${users[*].user}",
        "DOLI_DB_PASSWORD": "${users[*].password}"
      }
    }
  ],
  "help": {
    "db": "Dolibarr requires MariaDB or MySQL. This package bundles MariaDB for a single-node deployment."
  }
}