{
  "name": "flowise",
  "trademark": "Flowise",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/flowiseai/flowise"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "3.0.4",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 3000,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "2"
  }
}
