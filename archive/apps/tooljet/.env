W9_REPO=tooljet/tooljet-ce
W9_DIST=community
W9_VERSION=v3.20.226-lts
W9_POWER_PASSWORD="3oVm!O9ztSINjx2w"
W9_RCODE="4B5u2PTcsTdFi"

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID=tooljet

# Web/internal ports: uncomment the ones the package actually uses.
W9_HTTP_PORT=80
W9_HTTP_PORT_SET=9004

# Dependency helpers: uncomment when the package bundles a dependency service.
W9_DB_EXPOSE=postgresql
W9_DB_VERSION=13

# Built-in login and URL helpers: keep these in the protected block because the appstore parser
# reads them from the app package metadata surface.
W9_URL=appname.example.com
W9_URL_REPLACE=true

W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# ToolJet image environment variables
# Docs: https://docs.tooljet.com/docs/setup/env-vars
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
TOOLJET_HOST=http://${W9_URL}
LOCKBOX_MASTER_KEY=35be6aee0f61857369af934c03cc5d5de559d3d65d8abe9aae${W9_RCODE}
SECRET_KEY_BASE=fd006d131e3f461014ba7f8a92ac959df20b998f2204eb334b7d086881d204a4435fcd88235d5a3652522d4fac4a77715d325d9c787706580d${W9_RCODE}
ORM_LOGGING=all
PG_DB=tooljet_production
PG_USER=postgres
PG_HOST=${W9_ID}-postgresql
PG_PASS=${W9_RCODE}
ENABLE_TOOLJET_DB=true
TOOLJET_DB=tooljet_db
TOOLJET_DB_USER=postgres
TOOLJET_DB_HOST=${W9_ID}-postgresql
TOOLJET_DB_PASS=${W9_RCODE}
PGRST_DB_URI=postgres://postgres:${W9_RCODE}@${W9_ID}-postgresql/tooljet_db
PGRST_HOST=${W9_ID}-postgrest
PGRST_JWT_SECRET=52bbe1c671a9c62d89e594dfd91597988542c27afaefa84a73${W9_RCODE}
REDIS_HOST=${W9_ID}-redis
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=${W9_POWER_PASSWORD}
DATABASE_BACKUP=false
DEPLOYMENT_PLATFORM=docker

# Not used by default; enable only when needed:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DEFAULT_FROM_EMAIL=hello@tooljet.io
# CHECK_FOR_UPDATES=true
# DISABLE_TOOLJET_TELEMETRY=false
