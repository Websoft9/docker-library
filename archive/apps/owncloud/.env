W9_REPO=owncloud/ocis
W9_DIST=community
W9_VERSION=8.2
W9_POWER_PASSWORD='yJ!E1w04pxHnJ!PT'

# Canonical semantics live in docs/w9-env-spec.md.
# This template controls layout; the spec controls meaning and decision rules.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####
W9_ID=owncloud
W9_HTTPS_PORT_SET=9001
W9_HTTPS_PORT=9200
W9_URL=example.youdomain.com
W9_URL_REPLACE=true
W9_LOGIN_USER=admin
W9_LOGIN_PASSWORD=${W9_POWER_PASSWORD}
W9_NETWORK=websoft9

#### ----------------------------------------------------------------------------------------- ####

# ============================================================
# ownCloud Infinite Scale image environment variables
# Docs: https://github.com/owncloud/ocis/tree/master/deployments/examples/ocis_full
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
OCIS_URL=https://${W9_URL}:${W9_HTTPS_PORT_SET}
PROXY_HTTP_ADDR=0.0.0.0:${W9_HTTPS_PORT}
PROXY_TLS=true
OCIS_INSECURE=true
IDM_ADMIN_PASSWORD=${W9_LOGIN_PASSWORD}

# Not used by default; enable only when needed:
# OCIS_LOG_LEVEL=info
# OCIS_LOG_PRETTY=true
# OCIS_EXCLUDE_RUN_SERVICES=idm
# IDM_CREATE_DEMO_USERS=false
# OCIS_CORS_ALLOW_ORIGINS=https://${W9_URL}:${W9_HTTPS_PORT_SET}
# OCIS_JWT_SECRET=
