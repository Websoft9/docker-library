{
  "name": "browserless",
  "trademark": "Browserless",
  "release": true,
  "upstream": {
    "image": "ghcr.io/browserless/chromium"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "v2.28.0",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 3000,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "2"
  }
}
