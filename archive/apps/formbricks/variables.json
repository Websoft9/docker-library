{
  "name": "formbricks",
  "trademark": "Formbricks",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "latest",
        "3.0.0"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 3000,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "2"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/formbricks/formbricks"
  }
}
