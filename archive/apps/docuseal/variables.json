{
  "name": "docuseal",
  "trademark": "DocuSeal",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/docuseal/docuseal"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "1.9.8",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 3000,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "6"
  }
}
