{
  "name": "rocketchat",
  "trademark": "RocketChat",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "6.11",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 3000,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "1"
  },
  "upstream": {
    "image": "https://hub.docker.com/_/rocket.chat"
  }
}
