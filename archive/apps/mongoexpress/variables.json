{
  "name": "mongoexpress",
  "trademark": "mongo-express",
  "release": false,
  "edition": [
    {
      "dist": "community",
      "version": [
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8081,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "1"
  },
  "upstream": {
    "image": "https://hub.docker.com/_/mongo-express"
  }
}
