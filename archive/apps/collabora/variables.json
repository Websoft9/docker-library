{
  "name": "collabora",
  "trademark": "Collabora",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/collabora/code"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "25.04.4.2.1",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 9980,
      "path": "/"
    },
    "admin": {
      "port": 9980,
      "path": "/browser/dist/admin/admin.html"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "4"
  }
}
