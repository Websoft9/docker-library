{
  "name": "bitwarden",
  "trademark": "Bitwarden",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "dev",
        "beta"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8080,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "1"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/bitwarden/self-host"
  }
}
