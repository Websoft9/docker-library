W9_REPO=appsmith/appsmith-ce
W9_DIST='community'
W9_VERSION='v2.3'

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####
W9_ID='appsmith'
W9_HTTP_PORT=80
W9_HTTP_PORT_SET='9001'
W9_URL='appname.example.com'
W9_NETWORK=websoft9
#### --------------------------------------------------------------------------------------- ####

# ============================================================
# Appsmith image environment variables
# Docs: https://github.com/appsmithorg/appsmith/blob/release/.env.example
# Follow docs/w9-env-spec.md when deciding which vars belong here.
# Enable the vars actually used in docker-compose.yml below; list up
# to 5 unused vars commented out. Full reference lives in the Docs URL.
# ============================================================

# Used by docker-compose.yml:
# docker-compose.yml passes .env into the container via env_file: .env.

# Not used by default; enable only when needed:
# APPSMITH_DB_URL=mongodb+srv://user:password@mongo.host/appsmith
# APPSMITH_REDIS_URL=redis://:password@redis.host:6379
# APPSMITH_CUSTOM_DOMAIN=appsmith.example.com
# APPSMITH_DISABLE_TELEMETRY=true
# APPSMITH_MAIL_ENABLED=true