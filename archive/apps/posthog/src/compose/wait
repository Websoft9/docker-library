#!/usr/bin/env python3

import socket
import time


def wait_for(name: str, host: str, port: int) -> None:
    while True:
        try:
            with socket.create_connection((host, port), timeout=5):
                return
        except OSError:
            print(f"waiting for {name} on {host}:{port}")
            time.sleep(5)


wait_for("ClickHouse", "clickhouse", 9000)
wait_for("PostgreSQL", "db", 5432)
