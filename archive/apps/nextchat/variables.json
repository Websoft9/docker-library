{
  "name": "nextchat",
  "trademark": "NextChat",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "v2.16.0",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 3000,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "1"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/yidadaa/chatgpt-next-web"
  }
}
