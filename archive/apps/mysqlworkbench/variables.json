{
  "name": "mysqlworkbench",
  "trademark": "MySQL Workbench",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "8.0.40",
        "latest"
      ]
    }
  ],
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "3"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/linuxserver/mysql-workbench"
  },
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 3000,
      "path": "/"
    }
  }
}
