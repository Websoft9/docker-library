{
  "name": "nocodb",
  "trademark": "Nocodb",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "0.265.1",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8080,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "1"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/nocodb/nocodb"
  }
}
