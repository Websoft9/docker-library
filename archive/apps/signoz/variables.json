{
  "name": "signoz",
  "trademark": "SigNoz",
  "release": true,
  "upstream": {
    "image": "https://hub.docker.com/r/signoz/signoz"
  },
  "edition": [
    {
      "dist": "community",
      "version": [
        "v0.106.0",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8080,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "10"
  }
}
