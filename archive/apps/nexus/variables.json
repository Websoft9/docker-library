{
  "name": "nexus",
  "trademark": "Sonatype Nexus Repository",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "3.87.0",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8081,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "1"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/sonatype/nexus3"
  }
}
