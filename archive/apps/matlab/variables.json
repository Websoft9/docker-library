{
  "name": "matlab",
  "trademark": "MATLAB",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 8888,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "2",
    "memory": "4",
    "disk": "10"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/mathworks/matlab"
  }
}
