{
  "name": "discourse",
  "trademark": "Discourse",
  "release": true,
  "edition": [
    {
      "dist": "community",
      "version": [
        "3.4.5",
        "latest"
      ]
    }
  ],
  "access": {
    "defaultScheme": "http",
    "web": {
      "port": 3000,
      "path": "/"
    }
  },
  "requirements": {
    "cpu": "1",
    "memory": "2",
    "disk": "4"
  },
  "upstream": {
    "image": "https://hub.docker.com/r/bitnami/discourse"
  }
}
