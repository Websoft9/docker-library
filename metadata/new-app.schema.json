{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "New-app requests must always resolve an upstream image source. Optional upstream.releases / upstream.compose / upstream.env should be passed only when verified and applicable; omit them otherwise.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "trademark"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "trademark": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "docs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "github": { "type": "string" },
        "image": { "type": "string" },
        "install": { "type": "string" }
      }
    },
    "upstream": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "releases": { "type": "string" },
        "compose": { "type": "string" },
        "env": { "type": "string" }
      }
    }
  }
}
