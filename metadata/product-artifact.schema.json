{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": true,
    "required": [
      "key",
      "trademark",
      "summary",
      "overview",
      "websiteurl",
      "description",
      "screenshots",
      "distribution",
      "vcpu",
      "memory",
      "storage",
      "logo",
      "catalogCollection"
    ],
    "properties": {
      "sys": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 }
        }
      },
      "key": { "type": "string", "minLength": 1 },
      "hot": { "type": ["integer", "null"] },
      "trademark": { "type": "string", "minLength": 1 },
      "summary": { "type": "string" },
      "overview": { "type": "string" },
      "websiteurl": { "type": "string", "minLength": 1 },
      "description": { "type": "string" },
      "screenshots": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true,
          "required": ["key", "value"],
          "properties": {
            "id": { "type": "string" },
            "key": { "type": "string", "minLength": 1 },
            "value": { "type": "string", "minLength": 1 }
          }
        }
      },
      "distribution": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true,
          "required": ["key", "value"],
          "properties": {
            "key": { "type": "string", "minLength": 1 },
            "value": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "vcpu": { "type": "integer" },
      "memory": { "type": "integer" },
      "storage": { "type": "integer" },
      "logo": {
        "type": "object",
        "additionalProperties": true,
        "required": ["imageurl"],
        "properties": {
          "imageurl": { "type": "string", "minLength": 1 }
        }
      },
      "catalogCollection": {
        "type": "object",
        "additionalProperties": true,
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["key", "title", "catalogCollection"],
              "properties": {
                "key": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 1 },
                "catalogCollection": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["items"],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true,
                        "required": ["key", "title"],
                        "properties": {
                          "key": { "type": "string", "minLength": 1 },
                          "title": { "type": "string", "minLength": 1 },
                          "position": { "type": ["number", "integer", "null"] }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
