{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Contract for apps/<app>/variables.json. Additions must stay backward compatible: new fields are optional.",
  "type": "object",
  "required": [
    "name",
    "trademark",
    "release",
    "edition",
    "requirements"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "trademark": {
      "type": "string",
      "minLength": 1
    },
    "release": {
      "type": "boolean"
    },
    "scope": {
      "type": "string"
    },
    "runtime": {
      "type": "string"
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "releases": {
          "type": "string",
          "minLength": 1
        },
        "compose": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "compose": {
              "type": "string",
              "minLength": 1
            },
            "env": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "docs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "edition": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dist",
          "version"
        ],
        "properties": {
          "dist": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultScheme": {
          "type": "string",
          "enum": [
            "http",
            "https"
          ]
        },
        "web": {
          "$ref": "#/$defs/accessEntry"
        },
        "admin": {
          "$ref": "#/$defs/accessEntry"
        },
        "api": {
          "$ref": "#/$defs/accessEntry"
        },
        "grpc": {
          "$ref": "#/$defs/accessEntry"
        },
        "ws": {
          "$ref": "#/$defs/accessEntry"
        },
        "ssh": {
          "$ref": "#/$defs/accessEntry"
        },
        "metrics": {
          "$ref": "#/$defs/accessEntry"
        }
      }
    },
    "externalDB": {
      "type": "object",
      "description": "User-facing verified database requirement cache, keyed by app version and engine. Do not use it as a computation source."
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "memory",
        "disk"
      ],
      "properties": {
        "cpu": {
          "type": [
            "string",
            "number"
          ]
        },
        "memory": {
          "type": [
            "string",
            "number"
          ]
        },
        "disk": {
          "type": [
            "string",
            "number"
          ]
        }
      }
    },
    "database": {
      "oneOf": [
        {
          "$ref": "#/$defs/databaseComponents"
        },
        {
          "$ref": "#/$defs/legacyDatabase"
        }
      ]
    },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "first_startup_only": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secrets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 1,
                "propertyNames": {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^(base64|fernet|jwt:[A-Za-z_][A-Za-z0-9_]*)$"
                }
              }
            ]
          },
          "description": "Declarations of .env secret keys. Plain variable names regenerate same-shaped values (including comma-separated lists); single-key objects declare a closed-vocabulary generator rule (base64, fernet, or jwt:<SECRET_KEY>)."
        }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "none": {
          "type": "boolean",
          "description": "Set true when the image ships no preset admin credentials and the account is created interactively during setup."
        },
        "initial": {
          "$ref": "#/$defs/credentialSlots",
          "description": "One-time bootstrap or setup credentials used only during initial setup."
        },
        "login": {
          "$ref": "#/$defs/credentialSlots",
          "description": "Steady-state credentials used for regular sign-in."
        },
        "username": {
          "$ref": "#/$defs/credentialSource"
        },
        "password": {
          "$ref": "#/$defs/credentialSource"
        },
        "token": {
          "$ref": "#/$defs/credentialSource"
        }
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/setupStep"
          }
        }
      }
    },
    "help": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "databaseUsers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "user"
        ],
        "properties": {
          "user": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "usage": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "application",
                "initialization",
                "administration"
              ]
            }
          }
        }
      }
    },
    "databaseNames": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "databaseProvider": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "service",
            "driver"
          ],
          "properties": {
            "type": {
              "const": "internal"
            },
            "service": {
              "type": "string",
              "minLength": 1
            },
            "driver": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "drivers"
          ],
          "properties": {
            "type": {
              "const": "external"
            },
            "drivers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "databaseComponents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "providers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "providers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/databaseProvider"
            }
          },
          "name": {
            "$ref": "#/$defs/databaseNames"
          },
          "users": {
            "$ref": "#/$defs/databaseUsers"
          },
          "datasource": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "if": {
          "properties": {
            "providers": {
              "contains": {
                "properties": {
                  "type": {
                    "const": "external"
                  }
                },
                "required": [
                  "type"
                ]
              }
            }
          }
        },
        "then": {
          "required": [
            "datasource"
          ]
        }
      }
    },
    "databaseTypes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "images",
          "host",
          "port",
          "url"
        ],
        "properties": {
          "images": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "host": {
            "const": ""
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "$ref": "#/$defs/databaseNames"
          },
          "users": {
            "$ref": "#/$defs/databaseUsers"
          }
        }
      }
    },
    "secretRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base64",
        "fernet",
        "jwt"
      ],
      "properties": {
        "base64": {
          "allOf": [
            {
              "$ref": "#/$defs/secretByteRule"
            },
            {
              "properties": {
                "encoding": {
                  "const": "base64"
                }
              }
            }
          ]
        },
        "fernet": {
          "allOf": [
            {
              "$ref": "#/$defs/secretByteRule"
            },
            {
              "required": [
                "bytes"
              ],
              "properties": {
                "encoding": {
                  "const": "base64url"
                },
                "bytes": {
                  "const": 32
                }
              }
            }
          ]
        },
        "jwt": {
          "$ref": "#/$defs/secretJwtRule"
        }
      }
    },
    "secretByteRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator",
        "encoding",
        "description"
      ],
      "properties": {
        "generator": {
          "const": "random_bytes"
        },
        "encoding": {
          "enum": [
            "base64",
            "base64url"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "secretJwtRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator",
        "algorithm",
        "description"
      ],
      "properties": {
        "generator": {
          "const": "jwt"
        },
        "algorithm": {
          "const": "HS256"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "JWT signing requires a secret variable argument in the application declaration."
    },
    "legacyDatabase": {
      "deprecated": true,
      "description": "Read-only compatibility for existing packages; new declarations use databaseComponents.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "postgresql",
            "mysql",
            "mariadb",
            "mongodb",
            "redis"
          ]
        },
        "supported_modes": {
          "type": "array",
          "items": {
            "enum": [
              "bundled",
              "external"
            ]
          }
        },
        "default_mode": {
          "enum": [
            "bundled",
            "external"
          ]
        },
        "bundled": {
          "type": "object",
          "properties": {
            "service": {
              "type": "string"
            },
            "internal_host": {
              "type": "string"
            },
            "database_env": {
              "type": "string"
            },
            "username_env": {
              "type": "string"
            },
            "password_env": {
              "type": "string"
            }
          }
        }
      }
    },
    "credentialSlots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "username": {
          "$ref": "#/$defs/credentialSource"
        },
        "password": {
          "$ref": "#/$defs/credentialSource"
        },
        "token": {
          "$ref": "#/$defs/credentialSource"
        }
      }
    },
    "credentialSource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "value"
          ],
          "properties": {
            "source": {
              "const": "inline"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "name"
          ],
          "properties": {
            "source": {
              "const": "container-env"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "type": "string",
              "enum": [
                "text",
                "json",
                "env"
              ]
            },
            "jsonPath": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            },
            "match": {
              "type": "string",
              "enum": [
                "substring",
                "regex"
              ]
            },
            "pattern": {
              "type": "string",
              "minLength": 1
            },
            "group": {
              "type": "integer",
              "minimum": 0
            },
            "trim": {
              "type": "boolean"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "format": {
                    "const": "json"
                  }
                },
                "required": [
                  "format"
                ]
              },
              "then": {
                "required": [
                  "jsonPath"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "format": {
                    "const": "env"
                  }
                },
                "required": [
                  "format"
                ]
              },
              "then": {
                "required": [
                  "key"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "match": {
                    "const": "regex"
                  }
                },
                "required": [
                  "match"
                ]
              },
              "then": {
                "required": [
                  "group"
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "path"
          ],
          "properties": {
            "source": {
              "const": "container-file"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "type": "string",
              "enum": [
                "text",
                "json",
                "env"
              ]
            },
            "jsonPath": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            },
            "trim": {
              "type": "boolean"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "format": {
                    "const": "json"
                  }
                },
                "required": [
                  "format"
                ]
              },
              "then": {
                "required": [
                  "jsonPath"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "format": {
                    "const": "env"
                  }
                },
                "required": [
                  "format"
                ]
              },
              "then": {
                "required": [
                  "key"
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "pattern"
          ],
          "properties": {
            "source": {
              "const": "container-log"
            },
            "match": {
              "type": "string",
              "enum": [
                "substring",
                "regex"
              ]
            },
            "pattern": {
              "type": "string",
              "minLength": 1
            },
            "group": {
              "type": "integer",
              "minimum": 0
            },
            "trim": {
              "type": "boolean"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "match": {
                    "const": "regex"
                  }
                },
                "required": [
                  "match"
                ]
              },
              "then": {
                "required": [
                  "group"
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "argv"
          ],
          "properties": {
            "source": {
              "const": "container-cli"
            },
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "format": {
              "type": "string",
              "enum": [
                "text",
                "json",
                "env"
              ]
            },
            "jsonPath": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            },
            "match": {
              "type": "string",
              "enum": [
                "substring",
                "regex"
              ]
            },
            "pattern": {
              "type": "string",
              "minLength": 1
            },
            "group": {
              "type": "integer",
              "minimum": 0
            },
            "trim": {
              "type": "boolean"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "format": {
                    "const": "json"
                  }
                },
                "required": [
                  "format"
                ]
              },
              "then": {
                "required": [
                  "jsonPath"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "format": {
                    "const": "env"
                  }
                },
                "required": [
                  "format"
                ]
              },
              "then": {
                "required": [
                  "key"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "match": {
                    "const": "regex"
                  }
                },
                "required": [
                  "match"
                ]
              },
              "then": {
                "required": [
                  "group"
                ]
              }
            }
          ]
        }
      ]
    },
    "setupStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "$ref": "#/$defs/setupAction"
        }
      }
    },
    "setupAction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "service"
          ],
          "properties": {
            "type": {
              "const": "show-log"
            },
            "service": {
              "type": "string",
              "minLength": 1
            },
            "tail": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "name"
          ],
          "properties": {
            "type": {
              "const": "show-env"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path"
          ],
          "properties": {
            "type": {
              "const": "show-file"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "type": "string",
              "enum": [
                "text",
                "json",
                "env"
              ]
            },
            "jsonPath": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "format": {
                    "const": "json"
                  }
                },
                "required": [
                  "format"
                ]
              },
              "then": {
                "required": [
                  "jsonPath"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "format": {
                    "const": "env"
                  }
                },
                "required": [
                  "format"
                ]
              },
              "then": {
                "required": [
                  "key"
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "argv"
          ],
          "properties": {
            "type": {
              "const": "show-cli"
            },
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "format": {
              "type": "string",
              "enum": [
                "text",
                "json",
                "env"
              ]
            },
            "jsonPath": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "format": {
                    "const": "json"
                  }
                },
                "required": [
                  "format"
                ]
              },
              "then": {
                "required": [
                  "jsonPath"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "format": {
                    "const": "env"
                  }
                },
                "required": [
                  "format"
                ]
              },
              "then": {
                "required": [
                  "key"
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "access"
          ],
          "properties": {
            "type": {
              "const": "open"
            },
            "access": {
              "type": "string",
              "enum": [
                "web",
                "admin",
                "api",
                "grpc",
                "ws",
                "ssh",
                "metrics"
              ]
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            }
          }
        }
      ]
    },
    "accessEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Container port the service listens on (not the host port)."
        },
        "path": {
          "type": "string",
          "pattern": "^/",
          "description": "URL path; omit for '/'."
        },
        "scheme": {
          "type": "string",
          "minLength": 1,
          "description": "Optional per-surface scheme override, e.g. wss or ssh."
        }
      }
    }
  }
}