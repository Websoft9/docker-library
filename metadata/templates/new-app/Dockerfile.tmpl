ARG {{ name_upper }}_VERSION={{ version }}

FROM <upstream-image-or-base>

ARG {{ name_upper }}_VERSION

LABEL org.opencontainers.image.authors="https://www.websoft9.com" \
      org.opencontainers.image.description="{{ trademark }} packaged by Websoft9" \
      org.opencontainers.image.source="https://github.com/Websoft9/docker-library/tree/main/apps/{{ name }}" \
      org.opencontainers.image.title="{{ name }}" \
      org.opencontainers.image.vendor="Websoft9" \
      org.opencontainers.image.version="${{{ name_upper }}_VERSION}"

# Copy files from src/ when the image needs app-local runtime assets.
# Example:
# COPY src/entrypoint.sh /usr/local/bin/entrypoint.sh
