W9_REPO={{ repo }}
W9_DIST=community
W9_VERSION={{ version }}

# Optional password seed: enable only when the package actually controls a DB or built-in login.
# See docs/w9-env-spec.md for when W9_POWER_PASSWORD is appropriate.
# W9_POWER_PASSWORD="{power_password}"

# Canonical semantics live in docs/w9-env-spec.md and docs/app-access-spec.md.
# Host ports, public URLs and admin paths belong in variables.json.access
# (mapped to native app variables via rootUrl / host / mappedPort), not in W9_* aliases.

#### --  Not allowed to edit below environments when recreate app based on existing data  -- ####

W9_ID={{ name }}

# Dependency helpers: uncomment when the package bundles a dependency service.
# W9_DB_EXPOSE=postgresql
# W9_DB_VERSION=16

# Built-in login helpers: enable as a pair only when the package controls initial credentials.
# W9_LOGIN_USER=admin
# W9_LOGIN_PASSWORD=${W9_POWER_PASSWORD}

W9_NETWORK=websoft9

