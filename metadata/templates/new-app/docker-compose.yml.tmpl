services:

  {{ name }}:
    image: ${W9_REPO}:${W9_VERSION}
    container_name: ${W9_ID}
    restart: unless-stopped
    env_file: .env
    ports:
      - "${W9_HTTP_PORT_SET}:80" # Web Console
    # TODO: add volumes, healthcheck, and dependency services after upstream research

networks:
  default:
    name: ${W9_NETWORK}
    external: true
