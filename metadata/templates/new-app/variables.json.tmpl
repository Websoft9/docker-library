{
  "name": "{{ name }}",
  "trademark": "{{ trademark }}",
  "release": false,
  "upstream": {
    "image": "{{ image_url }}",
{% if has_releases %}
    "releases": "{{ releases_url }}",
{% endif %}
{% if has_compose_group %}
    "compose": {
{% if has_compose %}
      "compose": "{{ compose_url }}"{% if has_compose_env %},{% endif %}
{% endif %}
{% if has_compose_env %}
      "env": "{{ compose_env_url }}"
{% endif %}
    },
{% endif %}
    "docs": {{ docs_json }}
  },
  "edition": [
    {
      "dist": "community",
      "version": ["{{ version }}", "latest"]
    }
  ],
  "requirements": {
    "cpu": "1",
    "memory": "1",
    "disk": "1"
  },
  "env": {
    "first_startup_only": []
  },
  "help": {
    "db": ""
  }
}
