#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "[pre-push] checking generated AI command adapters"
make --no-print-directory build-ai-commands ARGS="--check"

if [ -x .venv/bin/python ]; then
  echo "[pre-push] running generator contract tests"
  .venv/bin/python -m pytest tests/build/test_build_ai_commands.py -q
else
  echo "[pre-push] skip tests: .venv/bin/python not found"
fi
